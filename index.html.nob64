<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Cérebro MISTA</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Barlow+Condensed:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Archivo:wdth,wght@62..125,500..800&display=swap">
<style>
/* Layout: faixa de resumo no topo, barra de carga de arquivos, lista de itens à esquerda e editor à direita (empilha no celular). */
:root{
  --bg:#EDEFEC; --surface:#F8F9F7; --surface2:#E3E7E3; --ink:#1A2428; --muted:#5B676B; --line:#CBD2CD;
  --accent:#00006A; --accent-ink:#FFFFFF; --red:#EE3239; --input:#FFFFFF;
  --good:#26704A; --good-bg:#DCEBE1; --warn:#7D5200; --warn-bg:#F6E8C8; --bad:#A32F25; --bad-bg:#F5DAD6; --amber:#D69E2E;
  --f-display:'Barlow Condensed','Arial Narrow',sans-serif;
  --f-body:'IBM Plex Sans',system-ui,-apple-system,'Segoe UI',sans-serif;
  --f-mono:'IBM Plex Mono',ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#10171A; --surface:#182126; --surface2:#222D33; --ink:#E6ECEA; --muted:#93A1A5; --line:#2E3B41;
    --accent:#9AA4FF; --accent-ink:#0B0C2E; --red:#FF6B70; --input:#10181B;
    --good:#6CC48F; --good-bg:#1B3226; --warn:#E6B54A; --warn-bg:#3A2E12; --bad:#F08A7E; --bad-bg:#3E1D19; --amber:#E6B54A;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#10171A; --surface:#182126; --surface2:#222D33; --ink:#E6ECEA; --muted:#93A1A5; --line:#2E3B41;
  --accent:#9AA4FF; --accent-ink:#0B0C2E; --red:#FF6B70; --input:#10181B;
  --good:#6CC48F; --good-bg:#1B3226; --warn:#E6B54A; --warn-bg:#3A2E12; --bad:#F08A7E; --bad-bg:#3E1D19; --amber:#E6B54A;
  color-scheme:dark;
}
*{box-sizing:border-box}
[hidden]{display:none !important}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:14px;line-height:1.45;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:16px 40px}
body.dragging::after{content:"Solte o arquivo para carregar";position:fixed;inset:10px;border:3px dashed var(--accent);border-radius:10px;background:color-mix(in srgb,var(--bg) 82%,transparent);display:grid;place-items:center;font-family:var(--f-display);font-size:30px;color:var(--accent);z-index:50;pointer-events:none}
.app{max-width:1280px;margin:0 auto;display:flex;flex-direction:column;gap:14px}
h1,h2,h3{margin:0;font-family:var(--f-display);font-weight:600;letter-spacing:.01em;text-wrap:balance}
h1{font-size:30px;line-height:1;border-left:4px solid var(--red);padding-left:10px}
h2{font-size:21px}
h3{font-size:16px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);font-weight:600}
.num,.mono{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
button{font:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

.top{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:flex-end;justify-content:space-between}
.brand{display:flex;gap:12px;align-items:center}
.logo{display:block;height:56px;width:auto;max-width:100%;background:#fff;border-radius:6px;padding:3px 8px;flex:none;border:1px solid var(--line)}
.logo.sm{height:48px;align-self:flex-start}
.eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:600}
.meta{display:flex;flex-wrap:wrap;gap:10px}
.meta label{display:flex;flex-direction:column;gap:3px;font-size:11px;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;min-width:0}
.meta input{min-width:0}

input,select,textarea{font:inherit;color:var(--ink);background:var(--input);border:1px solid var(--line);border-radius:4px;padding:7px 9px;width:100%;min-width:0}
input.num{text-align:right}
input:focus,select:focus,textarea:focus{border-color:var(--accent)}
label.f{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--muted);min-width:0}
label.f>span.lb{font-weight:500}
.hint{font-size:12px;color:var(--muted)}

.summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:6px;overflow:hidden}
.summary>div{background:var(--surface);padding:10px 14px;display:flex;flex-direction:column;gap:2px;min-width:0}
.summary .k{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.summary .v{font-family:var(--f-mono);font-variant-numeric:tabular-nums;font-size:19px;font-weight:500;overflow-wrap:anywhere}
.summary .v.t{font-family:var(--f-body);font-size:14px;font-weight:600;line-height:1.3}

.loadbar{padding:12px 14px;display:flex;flex-direction:column;gap:10px}
.lb-row{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center}
.lb-row .grow{flex:1 1 280px;min-width:0}
.pastebox{display:flex;flex-direction:column;gap:8px}
.pastebox textarea{min-height:110px;font-family:var(--f-mono);font-size:12.5px}
.inbox{border:1px solid var(--line);border-radius:6px;padding:10px 12px;display:flex;flex-direction:column;gap:8px;background:var(--surface2)}
.ib-done summary{cursor:pointer;font-size:12px;color:var(--muted);padding:2px 0}
.inbox h3{margin:0;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.ib-row{display:flex;flex-wrap:wrap;gap:6px 12px;align-items:center;padding:6px 0;border-top:1px solid var(--line)}
.ib-row:first-of-type{border-top:0}
.ib-row .ib-t{flex:1 1 260px;min-width:0}
.ib-row .ib-t b{display:block}
.ib-row.done{opacity:.55}
.pidline{font-family:var(--f-mono);font-size:12px;color:var(--muted);padding-left:14px;margin-top:4px}
.pf{display:flex;flex-wrap:wrap;gap:8px}
.pf input{flex:2 1 260px;width:auto}
.pf select{flex:1 1 150px;width:auto}
.sec{padding:10px 12px;gap:8px}
.grid.g1{grid-template-columns:minmax(0,2.2fr) minmax(0,1.3fr) minmax(70px,.5fr) minmax(0,1.1fr)}
.grid.g2{grid-template-columns:minmax(0,1.1fr) minmax(0,.8fr) minmax(0,.7fr) minmax(0,.9fr) minmax(0,.9fr) minmax(0,1.6fr)}
.grid.g3{grid-template-columns:minmax(0,2fr) minmax(0,1fr) minmax(0,1.4fr)}
.sec input,.sec select{padding:5px 8px}
.sec label.f>span.lb{font-size:12px;color:var(--muted)}
.mt{min-width:740px;display:flex;flex-direction:column;gap:4px}
.mr{display:grid;gap:6px;align-items:center;grid-template-columns:minmax(120px,2fr) minmax(100px,1.2fr) 52px 52px 52px 68px 46px 78px 26px}
.mr.mh{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-weight:600;line-height:1.15}
.mr .r{text-align:right}.mr .q{text-align:right;padding-right:9px;color:var(--muted)}
.mr .kgc{text-align:right;font-size:12px}
.mr .ic{padding:4px 0;text-align:center}
.exs{display:flex;flex-direction:column;gap:4px}
.mfoot{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:flex-end}
.mfoot .pa{width:190px}
.mfoot .hint{flex:1 1 220px}
.pricebox{gap:8px}
.tbl td{padding:2px 8px 2px 0}
.tbl .subh td{padding-top:8px}
.or{display:grid;gap:6px;align-items:center;grid-template-columns:minmax(160px,2.4fr) 86px 90px 90px 80px 28px}
.or.oh{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-weight:600}
.or .r{text-align:right}
.grid.g4{grid-template-columns:minmax(0,2fr) minmax(0,1.1fr) minmax(0,.9fr) minmax(0,1.3fr)}
.nb{display:flex;flex-wrap:wrap;gap:8px;align-items:center;width:100%}.nb>span{min-width:130px;font-weight:600;font-size:12px}
.or.tr{grid-template-columns:minmax(220px,1fr) 28px;max-width:560px}
.or.os{grid-template-columns:minmax(220px,2fr) 110px 28px;max-width:560px}
#closebox{margin-top:12px}.cb-sum{font-size:14px;font-weight:500}
.etabs{display:flex;gap:2px;border-bottom:1px solid var(--line);padding:0 10px;overflow-x:auto}
.etabs button{background:none;border:0;border-bottom:3px solid transparent;padding:9px 12px;font:inherit;font-weight:600;font-size:13px;color:var(--muted);cursor:pointer;white-space:nowrap}
.etabs button[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}
.etabs .bd{display:inline-block;min-width:18px;padding:0 6px;margin-left:4px;border-radius:9px;background:var(--surface2);font-size:11px;font-weight:600;text-align:center;color:var(--ink)}
.etabs .bd.warn{background:#f6d6d2;color:#8a1c12}
.editor .sec[data-t]{display:none}
.editor[data-active="dados"] .sec[data-t="dados"],.editor[data-active="mat"] .sec[data-t="mat"],.editor[data-active="ops"] .sec[data-t="ops"],.editor[data-active="trat"] .sec[data-t="trat"],.editor[data-active="preco"] .sec[data-t="preco"]{display:flex}
.matlock{display:none;background:var(--surface2);border:1px dashed var(--line);border-radius:6px;padding:12px;font-size:13px;color:var(--muted)}
.sec.locked>*:not(h3):not(.matlock){display:none!important}
.sec.locked .matlock{display:block}
.etnav{display:flex;justify-content:space-between;padding:10px 12px;border-top:1px solid var(--line)}
.askbox{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;background:var(--warn-bg);color:var(--warn);border-radius:5px;padding:9px 12px}

.tabs{display:flex;gap:4px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.tabs button{background:none;border:0;border-bottom:3px solid transparent;padding:9px 14px;color:var(--muted);font-weight:600;font-family:var(--f-display);font-size:18px;letter-spacing:.03em}
.tabs button[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--red)}

.banner{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;justify-content:space-between;background:var(--warn-bg);color:var(--warn);border-radius:6px;padding:9px 14px;font-size:13px}
.banner .acts{display:flex;gap:8px;flex-wrap:wrap}

.btn{background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:4px;padding:7px 12px;font-weight:500}
.btn:hover{border-color:var(--accent)}
.btn.pri{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn.sm{padding:4px 9px;font-size:12px}
.btn[disabled]{opacity:.5;cursor:not-allowed}
.btn.danger{color:var(--bad)}

.work{display:grid;grid-template-columns:minmax(280px,360px) minmax(0,1fr);gap:14px;align-items:start}
@media (max-width:860px){.work{grid-template-columns:minmax(0,1fr)}}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:6px;min-width:0}
.panel-h{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--line)}
.list{display:flex;flex-direction:column}
.row{display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:2px 10px;align-items:center;text-align:left;width:100%;background:none;border:0;border-bottom:1px solid var(--line);border-left:5px solid transparent;padding:10px 14px 10px 10px;color:var(--ink)}
.row:last-child{border-bottom:0}
.row[data-vv="1"]{background:#F3E9C8}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .row[data-vv="1"]{background:#3A3417}}
:root[data-theme="dark"] .row[data-vv="1"]{background:#3A3417}
.row:hover{background:var(--surface2)}
.row[data-st="ok"]{border-left-color:var(--good)}
.row[data-st="warn"]{border-left-color:var(--amber)}
.row[data-st="old"]{border-left-color:var(--bad)}
.row[data-st="new"]{border-left-color:var(--accent)}
.row[aria-current="true"]{background:var(--surface2);box-shadow:inset 0 0 0 2px var(--line)}
.row .n{font-family:var(--f-display);font-size:22px;font-weight:600;color:var(--muted);grid-row:span 2}
.row .d{font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
.row .s{font-size:12px;color:var(--muted);grid-column:2;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row .p{grid-column:3;grid-row:1;text-align:right}
.row .pl{grid-column:3;grid-row:2;justify-self:end}
.pill{display:inline-block;font-family:var(--f-mono);font-size:11px;padding:1px 7px;border-radius:99px;white-space:nowrap}
.pill.good{background:var(--good-bg);color:var(--good)}
.pill.warn{background:var(--warn-bg);color:var(--warn)}
.pill.bad{background:var(--bad-bg);color:var(--bad)}
tr.lost td{color:var(--muted);font-style:italic}
.pill.none{background:var(--surface2);color:var(--muted)}
.pill.new{background:transparent;color:var(--accent);border:1px solid var(--accent)}
.legend{display:flex;flex-wrap:wrap;gap:4px 14px;padding:9px 14px;border-top:1px solid var(--line);font-size:12px;color:var(--muted)}
.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px;vertical-align:-1px}
.dot.ok{background:var(--good)}.dot.warn{background:var(--amber)}.dot.old{background:var(--bad)}.dot.new{background:var(--accent)}.dot.quo{background:var(--muted)}
.row[data-st="quoted"]{border-left-color:var(--muted)}

.editor{display:flex;flex-direction:column}
.hdrwrap{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--surface);border-radius:6px 6px 0 0}
.stick,.summary{display:none!important}
.cfm{position:fixed;inset:0;background:rgba(15,25,55,.55);z-index:200;display:flex;align-items:center;justify-content:center}
.cfm[hidden]{display:none}
.cfm-b{background:var(--surface);border-radius:14px;padding:24px 28px;width:min(460px,92%);box-shadow:0 24px 70px rgba(10,20,50,.45);border-top:6px solid var(--bad,#b3261e)}
.cfm-b h3{margin:0 0 8px;font-size:19px;color:var(--ink)}
.cfm-b p{margin:0 0 20px;font-size:14px;color:var(--ink);line-height:1.45}
.cfm-a{display:flex;gap:12px;justify-content:flex-end}
.cfm-a .btn{min-width:96px;padding:10px 18px;font-size:15px}
#cfm-n{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);box-shadow:0 0 0 3px rgba(40,60,160,.25)}
#cfm-y{background:#fff;border-color:var(--bad,#b3261e);color:var(--bad,#b3261e)}
#cfm-y:hover{background:var(--bad,#b3261e);color:#fff}

.rowh,.row{grid-template-columns:36px minmax(200px,1fr) 52px 66px 74px 150px 104px 112px 72px!important}
.ra{display:inline-flex;gap:6px;justify-content:flex-end;align-self:center;grid-row:1/span 2;grid-column:9}
.etabs button,.etabs .tab,.pc-tabs button{font-size:14px!important;font-weight:700!important;color:var(--ink)}
.etabs [aria-selected="true"]{color:var(--accent)!important}
.kpi .l,.dflt .l,.dflt span,.kpi>span:first-child{font-size:13.5px!important;font-weight:700!important;color:var(--ink)!important}
.dh,.pl-h span,.panel-h h3{font-size:13px!important;font-weight:800!important;color:var(--ink)!important}
.gm-s,.gm-t{font-size:13px!important}
.rowh{font-size:12px!important;font-weight:800!important;color:var(--ink)!important}
.edb{width:30px;height:30px}
.edb.dl:hover,.edb.dl.arm{background:var(--bad,#b3261e);border-color:var(--bad,#b3261e);color:#fff}
.edb.dl{color:var(--bad,#b3261e)}
.crumbbar{display:none!important}
.pidline{font-family:var(--f-mono);font-size:12px;color:var(--muted);align-self:center}
.fi-dots{display:inline-flex;gap:12px;align-items:center;font-weight:700;font-size:14px}
.fi-dots span{display:inline-flex;align-items:center;gap:5px}
.fi-dots .dot{width:11px;height:11px;border-radius:50%;display:inline-block}
.btn{background:#eaf0fb;color:var(--navy,#1f3a6e);border:1px solid #8ea3cf;font-weight:700}
.btn:hover{background:#dbe6fa;border-color:var(--accent)}
.btn.sm{padding:7px 14px;font-size:13.5px}
.btn.pri,.btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn.pri:hover{filter:brightness(1.12)}
.btn.danger{color:var(--bad)}
.side .btn{background:transparent;color:var(--side-ink);border:1px solid var(--side-line)}
label.f>span.lb,.sec .f>span.lb,.f>span.lb,.meta label,.meta.panel label,.hl>span,.lb{font-size:14px!important;font-weight:800!important;color:var(--ink)!important;letter-spacing:0;text-transform:none}
.pc-filters input,.pc-filters select{font-size:13.5px}

.rowh,.row{grid-template-columns:36px minmax(200px,1fr) 52px 66px 74px 150px 104px 112px 34px!important}
body[data-tab="itens"] #v-itens>#topmeta.panel{flex:0 0 auto!important;min-height:0!important}
.edb{align-self:center;display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;color:var(--navy,#1f3a6e);border:1px solid var(--line)}
.edb:hover{background:var(--navy,#1f3a6e);color:#fff}
.row{cursor:pointer}
body[data-tab="itens"] #v-itens>.panel:not(.editor){flex:1 1 0!important;max-height:none}
#editor{display:none!important}
body.ed-open[data-tab="itens"] #editor{display:flex!important;position:fixed!important;left:50%;top:calc(3vh / var(--z));transform:translateX(-50%);width:min(1100px,calc(94vw / var(--z)));height:calc(94vh / var(--z));max-height:none!important;overflow:auto;z-index:60;box-shadow:0 20px 60px rgba(10,20,50,.35);margin:0;order:0}
.edmask{position:fixed;inset:0;background:rgba(15,25,55,.45);z-index:55}
.edmask[hidden]{display:none}
.edbar{position:sticky;top:0;z-index:12;display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--surface);border-bottom:1px solid var(--line)}
.edbar b{font-size:15px}.edbar .edt{color:var(--muted,#667);font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.edbar .sp{flex:1}
.hdrwrap{top:49px!important}
.etnav{top:58px!important}

/* v58 */
.dbox>svg{max-height:210px}
body:not([data-sub="sv"]) #b-new{display:none}
.ibn{width:30px;height:30px;padding:0!important;display:inline-flex;align-items:center;justify-content:center;border-radius:9px}
.ibn.danger:hover,.ibn.arm{background:#e5484d!important;border-color:#e5484d!important;color:#fff!important}
.gm-a .ibn.pri{color:#fff}
.pl-row{cursor:pointer;grid-template-columns:150px minmax(0,1.6fr) 60px 120px 130px 110px 120px!important}
.pl-row.pl-h{cursor:default}
.st-pill[data-s="Fechado"]{background:#e0e8ff!important;color:#1b3fa8!important}
.pl-a{gap:4px}

/* v57: Proposta comercial (hub) */
body:not([data-sub="itens"]) #banner{display:none!important}
#v-pc{display:flex;flex-direction:column;gap:8px;min-height:0}
#v-pc[hidden]{display:none!important}
#pc-body{display:flex;flex-direction:column;gap:8px;min-height:0}
.pc-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:0 12px 0 6px}
.pc-bar .pc-tabs{border:0;padding:0;background:none}
.pc-bar .pc-tabs button{padding:11px 12px}
.pc-bar .sp{flex:1}
.pc-filters{display:flex;gap:6px;align-items:center}
.pc-bar .pc-filters input{width:240px!important;min-width:240px;flex:0 0 240px}.pc-bar .pc-filters select{width:auto!important;min-width:0!important;flex:0 0 auto}
.pl-h span:nth-child(4){text-align:right}
body[data-sub="itens"] .pc-filters,body[data-sub="prop"] .pc-filters,body[data-sub="in"] .pc-filters{display:none}
body:not([data-sub="itens"]) #b-save{display:none}
#v-in:not([hidden]),#v-sv:not([hidden]){display:block;background:var(--surface);border:1px solid var(--line);border-radius:14px;overflow:auto;min-height:0}
#v-in #inbox{border:0;box-shadow:none}
#v-in .hint{padding:14px}
#inbox:not([hidden])~#in-empty{display:none}
.pl-row{display:grid;grid-template-columns:150px minmax(0,1.6fr) 60px 120px 130px 110px 210px;gap:12px;align-items:center;padding:9px 16px;border-top:1px solid var(--line);font-size:13px}
.pl-row.pl-h{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:700;background:var(--surface2);border-top:0;position:sticky;top:0;z-index:2}
.pl-row.cur{background:var(--surface2)}
.pl-row:not(.pl-h):hover{background:var(--surface2)}
.pl-c{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.pl-c small{display:block;font-weight:500;color:var(--muted);font-size:11.5px}
.pl-v{font-family:var(--f-mono);text-align:right}
.pl-t{color:var(--muted);font-size:12px}
.pl-a{display:flex;gap:6px;justify-content:flex-end}
.st-pill{display:inline-block;padding:2px 10px;border-radius:99px;font-size:11.5px;font-weight:700;background:#fff1d6;color:#9a5a00}
.st-pill[data-s="Fechado"]{background:#d9f2e3;color:#14683a}
#v-itens>.meta.panel{order:0!important;flex:0 0 auto!important;display:grid!important;overflow:visible!important;min-height:0!important}

/* v55: ocupa a janela toda */
.shell{max-width:none!important;margin:0!important}
body{padding-inline:12px!important}
/* v54: capa CÉREBRO MISTA */
.cr-act{display:flex;gap:8px;margin-left:auto}
.crumbbar .pidline{font-family:var(--f-mono);font-size:12px;color:var(--muted);padding:0}
body[data-tab="ini"] .cr-act,body[data-tab="cap"] .cr-act,body[data-tab="pc"] .cr-act,body[data-tab="par"] .cr-act,body[data-tab="prop"] .cr-act{display:none}
body[data-tab="cap"] .crumbbar,body[data-tab="pc"] .crumbbar,body[data-tab="cap"] .meta,body[data-tab="pc"] .meta,body[data-tab="cap"] .loadbar,body[data-tab="pc"] .loadbar,body[data-tab="cap"] #banner,body[data-tab="pc"] #banner{display:none!important}
body[data-tab="cap"] #crumb-t,body[data-tab="pc"] #crumb-t{display:none}

/* v52: tela de Itens cabe na janela */
.sec[data-t=dados] h3{display:none}
.sec[data-t=dados] .g2>:nth-child(1){grid-column:span 2}.sec[data-t=dados] .g2>:nth-child(2){grid-column:span 1}.sec[data-t=dados] .g2>:nth-child(3){grid-column:span 1}.sec[data-t=dados] .g2>:nth-child(4){grid-column:span 3}.sec[data-t=dados] .g2>:nth-child(5){grid-column:span 2}.sec[data-t=dados] .g2>:nth-child(6){grid-column:span 2}.sec[data-t=dados] .g2>:nth-child(7){grid-column:span 1}
.editor{position:relative}
.etnav{position:absolute;z-index:8;top:6px;right:12px;display:flex;gap:6px;margin:0!important;padding:0!important;border:0!important;background:none!important}
.hbox{margin:6px 0!important}
#closebox{margin-top:0;padding:6px 14px}
#closebox .sec{display:flex!important;flex-direction:row!important;align-items:center;gap:12px;flex-wrap:nowrap;padding:0!important;border:0}
#closebox h3,#closebox .cb-sum{display:none}
#closebox .sec{margin:0!important}
#closebox .actions{margin:0;display:flex;flex-direction:row;align-items:center;gap:10px;flex-wrap:nowrap}
#closebox .hint{white-space:nowrap;font-size:12px}
.work:has(#list.big) .editor{display:none}
/* v53: escala compacta + painel inicial enxuto */
:root{--z:.8}
@media(min-width:1000px){body{zoom:var(--z)}}
.pwrap{gap:10px}
.kpis{gap:10px}
.kpi{padding:9px 14px}.kpi .n{font-size:22px}.kpi .l{font-size:12px;margin-bottom:2px}
.dbox{padding:10px 14px}.dbox h3{font-size:13px;margin:0 0 6px}
.dcols.dc3{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) minmax(0,1fr)}
@media(max-width:1100px){.dcols.dc3{grid-template-columns:minmax(0,1fr)}}
.dn{gap:12px}.dn svg{width:96px!important;height:96px!important;flex:0 0 96px!important}
.dn-l{gap:5px;font-size:12px}
.fn .l{padding:2px 0}.fn{gap:4px}
.dbox .gm{padding:5px 6px}
@media(min-width:1000px) and (min-height:560px){
 body[data-tab="itens"],body[data-tab="ini"],body[data-tab="cap"],body[data-tab="pc"]{height:calc(100vh / var(--z));overflow:hidden;padding-block:10px}
 body[data-tab="itens"] .shell,body[data-tab="ini"] .shell,body[data-tab="cap"] .shell,body[data-tab="pc"] .shell{height:calc(100vh / var(--z) - 20px);align-items:stretch}
 body[data-tab="itens"] .side,body[data-tab="ini"] .side,body[data-tab="cap"] .side,body[data-tab="pc"] .side{max-height:100%}
 body[data-tab="itens"] .app,body[data-tab="ini"] .app,body[data-tab="cap"] .app,body[data-tab="pc"] .app{height:100%;min-height:0;gap:8px}
 body[data-tab="itens"] .crumbbar{padding:0}
 body[data-tab="itens"] #crumb-t{display:none}
 body[data-tab="itens"] .meta.panel{padding:6px 14px;gap:10px}
 body[data-tab="itens"] .app>main,body[data-tab="ini"] .app>main,body[data-tab="cap"] .app>main,body[data-tab="pc"] .app>main{flex:1;min-height:0;display:flex;flex-direction:column;gap:8px}
 body[data-tab="ini"] #v-ini{flex:1;min-height:0;overflow:auto}
 body[data-tab="cap"] #v-cap,body[data-tab="pc"] #v-cap{flex:1;min-height:0}
 body[data-tab="pc"] #v-pc,body[data-tab="itens"] #v-pc{flex:1;min-height:0}
 body[data-tab="pc"] #pc-body,body[data-tab="itens"] #pc-body{flex:1;min-height:0}
 body[data-tab="pc"] #v-prop{flex:1;min-height:0;overflow:auto}
 body[data-tab="itens"] #v-itens.work:not([hidden]){flex:1;min-height:0;gap:8px}
 body[data-tab="itens"] #v-itens .editor{flex:0 0 auto;max-height:calc(46vh / var(--z));overflow:auto}
 body[data-tab="itens"] #v-itens>.panel:not(.editor){flex:1 1 0;min-height:120px;display:flex;flex-direction:column;overflow:hidden}
 body[data-tab="itens"] #list,body[data-tab="itens"] #list.big{flex:1;min-height:0!important;max-height:none!important;overflow:auto}
 body[data-tab="itens"] .ifoot{position:static;flex:0 0 auto;margin-top:0}
 body[data-tab="itens"] #closebox{flex:0 0 auto}
}

/* v51: campos compactos, rótulos em destaque */
.sec[data-t=dados] .grid.g1,.sec[data-t=dados] .grid.g2{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:6px 12px}
.sec[data-t=dados] .g1>:nth-child(1){grid-column:span 3}.sec[data-t=dados] .g1>:nth-child(2){grid-column:span 3}.sec[data-t=dados] .g1>:nth-child(3){grid-column:span 3}.sec[data-t=dados] .g1>:nth-child(4){grid-column:span 1}.sec[data-t=dados] .g1>:nth-child(5){grid-column:span 2}
@media(max-width:900px){.sec[data-t=dados] .grid>*{grid-column:span 6!important}}
.sec label.f>span.lb,.sec .f>span.lb,label.f>span.lb{font-size:13px;font-weight:700;color:var(--ink);letter-spacing:0}
.meta label,.meta.panel label{font-size:13px;font-weight:700;color:var(--ink);letter-spacing:0;text-transform:none}
.sec[data-t=dados]{padding-top:6px;padding-bottom:8px}
.hbox{padding:8px 12px!important}

#v-itens .ifoot{order:3}
.ifoot{position:sticky;bottom:0;z-index:5;display:flex;align-items:center;gap:26px;flex-wrap:wrap;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:10px 20px;margin-top:10px;box-shadow:0 -4px 14px rgba(20,22,58,.07)}
.ifoot .fi span{display:block;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.ifoot .fi b{font-family:var(--f-mono);font-size:16px;font-weight:600}
.ifoot .fi.big b{font-size:22px}
.ifoot .fi-sp{flex:1}
.ifoot .fi-att{font-size:12px;font-weight:600;color:var(--muted)}
.hh .hm{font-family:var(--f-mono);font-size:14px;margin-left:12px}
.hh .hp{font-family:var(--f-mono)}
.hbox details summary{cursor:pointer;font-size:12px;font-weight:600;color:var(--muted);padding:6px 0}
.stick{background:var(--surface);border-bottom:1px solid var(--line);border-radius:6px 6px 0 0;padding:10px 14px;display:flex;flex-wrap:wrap;gap:6px 22px;align-items:baseline}
.stick .big{font-family:var(--f-mono);font-variant-numeric:tabular-nums;font-size:24px;font-weight:500}
.stick .lbl{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);display:block}
.sec{padding:14px;border-bottom:1px solid var(--line);display:flex;flex-direction:column;gap:10px}
.sec:last-child{border-bottom:0}
.grid{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(140px,1fr))}
.grid.w2{grid-template-columns:minmax(0,2fr) minmax(0,1.3fr) minmax(90px,.6fr)}
@media (max-width:560px){.grid.w2{grid-template-columns:minmax(0,1fr)}}
.tbl{width:100%;border-collapse:collapse}
.tbl th{font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);text-align:left;font-weight:600;padding:4px 8px 6px 0}
.tbl td{padding:4px 8px 4px 0;vertical-align:middle}
.tbl td:last-child,.tbl th:last-child{padding-right:0}
.tbl .r{text-align:right}
.tbl .subh td{padding-top:12px;font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);font-weight:600;border-top:1px solid var(--line)}
.scroll{overflow-x:auto}
.calc{background:var(--surface2);border-radius:5px;padding:10px;display:flex;flex-wrap:wrap;gap:8px 12px;align-items:flex-end}
.calc label{flex:1 1 100px}
.alert{display:flex;flex-direction:column;gap:4px;background:var(--warn-bg);color:var(--warn);border-radius:5px;padding:9px 12px;font-size:13px}
.alert.bad{background:var(--bad-bg);color:var(--bad)}
.checks{display:flex;flex-wrap:wrap;gap:6px 18px}
.checks label{display:flex;gap:7px;align-items:center;font-size:13px}
.checks input{width:auto}
.brk{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:3px 16px;max-width:430px}
.brk dt{color:var(--muted)}
.brk dd{margin:0;text-align:right;font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.brk .tot{font-weight:600;color:var(--ink);border-top:1px solid var(--line);padding-top:4px}
.pricebox{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px}
.actions{display:flex;flex-wrap:wrap;gap:8px}

.hbox{border:1px solid var(--line);border-left-width:6px;border-radius:5px;padding:10px 12px;display:flex;flex-direction:column;gap:8px;background:var(--surface2)}
.hbox[data-st="ok"]{border-left-color:var(--good)}
.hbox[data-st="warn"]{border-left-color:var(--amber)}
.hbox[data-st="old"]{border-left-color:var(--bad)}
.hbox[data-st="new"]{border-left-color:var(--accent)}
.hbox .hh{display:flex;flex-wrap:wrap;gap:4px 14px;align-items:baseline}
.hbox .hp{font-family:var(--f-mono);font-size:22px;font-weight:500}
.hbox .ht{font-weight:600}
.hbox .hl{display:flex;flex-direction:column;gap:3px;font-size:13px}
.hbox table{border-collapse:collapse;font-size:12px;width:100%;max-width:520px}
.hbox th{font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);text-align:left;padding:2px 8px 2px 0}
.hbox td{padding:2px 8px 2px 0}
.hbox .r{text-align:right}
.hbox .wl{display:flex;flex-direction:column;gap:3px;font-size:13px;color:var(--warn)}
.hbox .wl.bad{color:var(--bad)}
.reqtxt{white-space:pre-wrap;font-size:12px;color:var(--muted);max-height:120px;overflow:auto;border:1px dashed var(--line);border-radius:4px;padding:6px 8px;margin:0;font-family:var(--f-body)}

.doc{padding:18px;display:flex;flex-direction:column;gap:14px;max-width:900px}
.doc table{width:100%;border-collapse:collapse}
.doc th{font-size:11px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);text-align:left;padding:6px 8px;border-bottom:2px solid var(--ink)}
.doc td{padding:8px;border-bottom:1px solid var(--line);vertical-align:top}
.doc .r{text-align:right}
.doc textarea{min-height:230px;font-family:var(--f-mono);font-size:12.5px;line-height:1.5}
.pwrap{display:flex;flex-direction:column;gap:14px}
.ini .dh{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.ini .dh h2{margin:0;font-size:20px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px}
.kpi{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:12px 14px}
.kpi .n{font-size:26px;font-weight:700;line-height:1.1}
.kpi .l{font-size:12px;color:var(--muted);margin-top:2px}
.kpi.alert{border-color:#C75A0F}.kpi.alert .n{color:#C75A0F}
.dcols{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px}
@media(max-width:900px){.dcols{grid-template-columns:minmax(0,1fr)}}
.dbox{padding:12px 14px}.dbox h3{margin:0 0 8px;font-size:14px}
.dflt{display:flex;gap:6px}.dflt button[aria-pressed="true"]{background:var(--ink);color:var(--bg)}

.p-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:14px}
@media (max-width:420px){.p-grid{grid-template-columns:minmax(0,1fr)}}
.empty{padding:28px 14px;color:var(--muted);text-align:center}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(18px + env(safe-area-inset-bottom,0px));background:var(--ink);color:var(--bg);padding:8px 16px;border-radius:5px;font-size:13px;z-index:60;max-width:90vw}
@media (prefers-reduced-motion:no-preference){.row{transition:background .12s}}

/* ===== Layout tipo sistema de gestão: menu lateral escuro + área de trabalho ===== */
:root{--side:#0C1238;--side-ink:#E8EBFA;--side-mute:#9AA3D1;--side-line:#232C5E}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--side:#0A0F26;--side-ink:#E8EBFA;--side-mute:#8F99C8;--side-line:#1E2750}}
:root[data-theme="dark"]{--side:#0A0F26;--side-ink:#E8EBFA;--side-mute:#8F99C8;--side-line:#1E2750}
body{font-size:13.5px}
.shell{display:grid;grid-template-columns:216px minmax(0,1fr);gap:16px;max-width:1500px;margin:0 auto;align-items:start}
.app{max-width:none;margin:0;gap:12px;min-width:0}
.side{position:sticky;top:16px;background:var(--side);color:var(--side-ink);border-radius:8px;padding:16px 12px;display:flex;flex-direction:column;gap:16px;min-height:calc(100vh - 32px)}
.side .brand{flex-direction:column;align-items:stretch;gap:12px}
.side .logo{height:auto;width:100%;max-height:64px;object-fit:contain}
.side .eyebrow{color:var(--side-mute)}
.side h1{font-size:23px;line-height:1.05;color:var(--side-ink);border-left:3px solid var(--red);padding-left:9px;margin-top:2px}
.side .pidline{color:var(--side-mute);padding-left:12px}
.side-act{display:flex;flex-direction:column;gap:8px}
.side .btn{background:transparent;color:var(--side-ink);border:1px solid var(--side-line);padding:8px 12px;text-align:left}
.side .btn:hover{border-color:var(--side-mute);background:rgba(255,255,255,.05)}
.side #b-new{background:var(--red);border-color:var(--red);color:#fff;font-weight:600}
.side #b-new:hover{filter:brightness(1.08)}
.side .tabs{flex-direction:column;gap:2px;border:0;margin-top:2px}
.side .tabs button{text-align:left;border:0;border-left:3px solid transparent;border-radius:0 4px 4px 0;padding:9px 12px;font-family:var(--f-body);font-size:14px;font-weight:500;letter-spacing:0;color:var(--side-mute)}
.side .tabs button:hover{background:rgba(255,255,255,.05);color:var(--side-ink)}
.side .tabs button[aria-selected="true"]{background:rgba(255,255,255,.09);color:#fff;border-left-color:var(--red);font-weight:600}
.side-foot{margin-top:auto;border-top:1px solid var(--side-line);padding-top:10px}
.side .hint{color:var(--side-mute);font-size:11px;line-height:1.35}
.meta.panel{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1.6fr) minmax(0,.8fr);gap:12px;padding:10px 14px}
.meta.panel input,.meta.panel select{min-width:0!important;width:100%}
.summary{border-radius:6px}
.summary>div{padding:8px 14px}
.summary .v{font-size:17px}
.loadbar{padding:0;border:0;background:none;gap:10px}
.loadbar:not(:has(.inbox:not([hidden]),.askbox:not([hidden]),.pastebox:not([hidden]))){display:none}
.banner{padding:7px 12px;font-size:12.5px}
.panel-h{padding:9px 12px}
.panel-h h3,.sec h3{font-size:11.5px;letter-spacing:.1em}
.sec h3{padding-bottom:6px;border-bottom:1px solid var(--line)}
.list .row{padding:9px 12px}
.work{grid-template-columns:minmax(250px,310px) minmax(0,1fr);gap:12px}
@media (max-width:1100px){.work{grid-template-columns:minmax(0,1fr)}}
@media (max-width:900px){
  .shell{grid-template-columns:minmax(0,1fr)}
  .side{position:static;min-height:0;flex-direction:row;flex-wrap:wrap;align-items:center;gap:10px 14px}
  .side .brand{flex-direction:row;align-items:center;gap:10px}
  .side .logo{width:auto;height:44px}
  .side-act{flex-direction:row}
  .side .tabs{flex-direction:row;flex:1 1 100%}
  .side .tabs button{border-left:0;border-bottom:3px solid transparent;border-radius:0}
  .side .tabs button[aria-selected="true"]{border-bottom-color:var(--red)}
  .side-foot{display:none}
  .meta.panel{grid-template-columns:minmax(0,1fr)}
}

/* ===== lista de itens em tabela, acima do editor ===== */
.work{grid-template-columns:minmax(0,1fr)!important;gap:12px}
.ph-act{display:flex;gap:8px}
.rowh,.row{display:grid;grid-template-columns:36px minmax(200px,1fr) 52px 66px 74px 150px 104px 112px;column-gap:12px;align-items:center}
.rowh{padding:7px 12px 7px 17px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--line);background:var(--surface2);overflow:hidden;scrollbar-gutter:stable}
.rowh span:nth-child(n+7){text-align:right}
.rowh span:nth-child(5),.rowh span:nth-child(6){text-align:left}
#list{max-height:236px;overflow-y:auto;scrollbar-gutter:stable;position:relative}
#list.big{max-height:68vh}
.row{padding:8px 12px;border-left:5px solid transparent;grid-template-columns:36px minmax(200px,1fr) 52px 66px 74px 150px 104px 112px}
.row .n{grid-row:span 2;font-size:20px}
.row .d{grid-column:2;grid-row:1}
.row .s{grid-column:2;grid-row:2}
.row .rv,.row .pz{grid-row:span 2;font-size:12.5px;color:var(--muted)}
.row .dw{grid-column:5;grid-row:span 2}
.dwb{display:inline-block;font-size:12px;padding:3px 8px;border:1px solid var(--line);border-radius:4px;background:var(--surface);color:var(--ink);cursor:pointer}
.dwb:hover{background:var(--surface2);border-color:var(--ink)}
.alarm{position:fixed;left:50%;top:22px;transform:translateX(-50%);background:#B3261E;color:#fff;padding:12px 22px;border-radius:6px;font-size:15px;font-weight:600;z-index:80;box-shadow:0 6px 24px rgba(0,0,0,.35)}
.row .pl{grid-column:6;grid-row:span 2;justify-self:start}
.row .p{grid-column:7;grid-row:span 2;text-align:right}
.row .tt{grid-column:8;grid-row:span 2;text-align:right;font-weight:500}
@media (max-width:760px){
  .rowh{display:none}
  .row{grid-template-columns:28px minmax(0,1fr) auto}
  .row .rv,.row .pz,.row .tt,.row .dw{display:none}
  .row .p{grid-column:3;grid-row:1}
  .row .pl{grid-column:3;grid-row:2;justify-self:end}
}

/* ===== identidade por empresa ===== */
:root{--on-red:#fff}
.side #b-new{color:var(--on-red)}
.emp-sw{display:flex;flex-direction:column;gap:6px}
.emp-sw .eyebrow{color:var(--side-mute)}
.emp-btns{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--side-line);border-radius:6px;overflow:hidden}
.emp-btns button{background:transparent;color:var(--side-mute);border:0;padding:8px 0;font-weight:600;letter-spacing:.06em}
.emp-btns button+button{border-left:1px solid var(--side-line)}
.emp-btns button[aria-pressed="true"]{background:var(--red);color:var(--on-red)}
.emp-tag{font-family:var(--f-mono);font-size:10px;padding:1px 6px;border-radius:99px;border:1px solid var(--line);color:var(--muted);margin-left:4px;vertical-align:1px}
.emp-tag[data-e="STAR"]{border-color:#C75A0F;color:#C75A0F}
.emp-form{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;align-items:end;padding:12px 0;border-top:1px solid var(--line)}
.emp-h{grid-column:1/-1;display:flex;align-items:center;gap:12px}
.emp-h img{height:44px;width:auto;background:#fff;border:1px solid var(--line);border-radius:4px;padding:2px 6px}
:root[data-emp="STAR"]{--side:#001C3E;--side-line:#183A66;--side-mute:#93A9C6;--red:#FF781F;--on-red:#001C3E;--accent:#0A2F5C;--accent-ink:#FFFFFF}
@media (prefers-color-scheme: dark){:root[data-emp="STAR"]:not([data-theme="light"]){--side:#00142E;--side-line:#14335A;--accent:#FF9A57;--accent-ink:#1A0A00}}
:root[data-emp="STAR"][data-theme="dark"]{--side:#00142E;--side-line:#14335A;--accent:#FF9A57;--accent-ink:#1A0A00}

/* ===== MISTA: visual de sistema (tema claro, cores por empresa) ===== */
:root{--bg:#F1F3FA;--surface:#FFFFFF;--surface2:#EEF0FB;--ink:#14163A;--muted:#6E7391;--line:#E3E6F2;--f-body:'Plus Jakarta Sans','IBM Plex Sans',system-ui,sans-serif}
body{font-size:14px;padding-block:18px 40px}
.panel,.summary,.kpi,.dbox{border-radius:16px}
.panel{border-color:var(--line);box-shadow:0 1px 2px rgba(20,22,58,.04)}
.side{border-radius:20px;padding:20px 14px;gap:14px}
.side h1{display:none}
.side .eyebrow{display:none}
.side .pidline{padding-left:8px}
.emp-btns{border-radius:12px;border-color:var(--side-line);padding:3px;gap:3px;background:rgba(255,255,255,.06)}
.emp-btns button{border-radius:9px}
.emp-btns button+button{border-left:0}
.side .btn{border-radius:12px}

.side{overflow-y:auto;max-height:calc(100vh / var(--z) - 36px)}
.mods{display:flex;flex-direction:column;gap:2px}
.mod,.mod2{display:flex;align-items:center;gap:12px;width:100%;padding:9px 12px;border-radius:12px;background:none;border:0;color:var(--side-ink);font:600 13.5px var(--f-body);text-align:left;cursor:pointer}
.mod:hover,.mod2:hover{background:rgba(255,255,255,.07)}
.mod .ic{flex:0 0 20px}
.mod .chev,.mod2 .chev{margin-left:auto;color:var(--side-mute);transition:transform .15s}
.mod.open .chev,.mod2.open .chev{transform:rotate(90deg)}
.mod.open{color:#fff}
.subs{display:none;flex-direction:column;gap:2px;padding-left:20px;border-left:1px solid var(--side-line);margin:2px 0 4px 20px}
.subs.open{display:flex}
.mod2{padding:7px 10px;font-size:13px}
.subs2{display:none;flex-direction:column;gap:2px;padding-left:6px}
.subs2.open{display:flex}
.mod3{padding:4px 10px 2px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--red);font-weight:800}
.side .tabs{padding-left:0}
.side .tabs button{padding:6px 12px;font-size:13px}
@media (max-width:900px){.mods>.mod:not([data-tog]){display:none}}
.grp{padding:6px 8px 0;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--side-mute);font-weight:700}
.sub1{padding:2px 8px 0 14px;font-size:14px;font-weight:600;color:#fff}
.sub2{padding:2px 8px 4px 24px;font-size:14px;font-weight:700;color:#fff;border-left:3px solid var(--red);margin-left:12px}
.side .tabs{margin-top:0;padding-left:8px}
.side .tabs button{border-left:0;border-radius:12px;padding:9px 14px 9px 34px;font-size:13.5px}
.side .tabs button[aria-selected="true"]{background:#fff;color:var(--side);font-weight:700}
.crumbbar{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;padding:2px 4px 0}
.crumbbar .cr{font-size:12px;color:var(--muted);font-weight:600}
.crumbbar .cr b{color:var(--ink)}
.crumbbar h2{margin:0;font-size:24px;letter-spacing:-.02em;width:100%}
.btn{border-radius:10px}
.btn.pri,.btn.primary{border-radius:10px}
.pill{border-radius:99px}
.list{border-radius:0 0 16px 16px}
.row{padding-block:11px}
.ini .dh h2{display:none}
.kpis{gap:16px}
.kpi{padding:18px 20px;border-color:var(--line)}
.kpi .l{order:-1;font-size:13px;font-weight:600;color:var(--muted);margin:0 0 6px}
.kpi{display:flex;flex-direction:column}
.kpi .n{font-size:30px;font-weight:800;letter-spacing:-.02em}
.kpi.alert{border-color:var(--red);box-shadow:0 0 0 1px var(--red) inset}.kpi.alert .n{color:var(--ink)}
.dbox{padding:18px 20px}.dbox h3{font-size:15px;font-weight:700;margin:0 0 12px}
.dflt button{border-radius:99px}
.rk{display:grid;grid-template-columns:34px minmax(0,1fr) 110px 90px;gap:12px;align-items:center;padding:10px 0;border-top:1px solid var(--line);font-size:13px}
.rk:first-of-type{border-top:0}
.rk .av{width:32px;height:32px;border-radius:50%;background:var(--accent);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:11px}
.rk .nm{font-weight:700}.rk .nm small{display:block;color:var(--muted);font-weight:500;font-size:12px}
.rk .r{text-align:right;font-weight:700}
.bar2{height:8px;border-radius:99px;background:var(--surface2);overflow:hidden}.bar2 i{display:block;height:100%;border-radius:99px;background:var(--accent)}
.fn{display:flex;flex-direction:column;gap:12px}
.fn .l{display:grid;grid-template-columns:120px minmax(0,1fr) 28px;gap:10px;align-items:center;font-size:12.5px;font-weight:600;color:var(--muted)}
.fn .l b{color:var(--ink);text-align:right}
.dc21{grid-template-columns:minmax(0,2fr) minmax(0,1fr)!important}
@media(max-width:900px){.dc21{grid-template-columns:minmax(0,1fr)!important}}
.dbox h3 small{font-weight:500;color:var(--muted);font-size:12px;margin-left:6px;text-transform:none;letter-spacing:0}
.dn{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.dn svg{width:140px!important;height:140px!important;flex:0 0 140px}
.dn-l{display:flex;flex-direction:column;gap:8px;font-size:13px;flex:1 1 160px}
.dn-l div{display:flex;align-items:center;gap:8px}.dn-l i{width:10px;height:10px;border-radius:3px;flex:0 0 10px}.dn-l span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.dn-l b{font-weight:700}
.dbox .gm{grid-template-columns:12px minmax(0,1.4fr) minmax(0,1fr) 90px auto}
.inbox{background:var(--surface);border-radius:16px;padding:14px 16px;gap:0}
.inbox h3{padding-bottom:8px}
.gm{display:grid;grid-template-columns:12px minmax(140px,240px) minmax(0,1fr) 110px auto;gap:12px;align-items:center;padding:9px 6px;border-top:1px solid var(--line);font-size:13.5px}
.gm:hover{background:var(--surface2);border-radius:10px}
.gm-dot{width:8px;height:8px;border-radius:50%;background:transparent}
.gm.unread .gm-dot{background:var(--red)}
.gm.unread .gm-c{font-weight:800}
.gm-c{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.gm-s{color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.gm-t{color:var(--muted);font-size:12px;text-align:right;white-space:nowrap}
.gm-a{display:flex;gap:6px;opacity:.9}
.gm.done{opacity:.6}
.ib-done summary{cursor:pointer;color:var(--muted);font-size:12.5px;padding:8px 6px}
@media (max-width:760px){.gm{grid-template-columns:12px minmax(0,1fr) auto}.gm-s,.gm-t{display:none}}
#v-itens.work:not([hidden]){display:flex!important;flex-direction:column}
#v-itens .editor{order:1}
#v-itens .work-list,#v-itens>.panel:not(.editor){order:2}
#list{max-height:56vh!important;min-height:260px}
#list.big{max-height:78vh!important}
.row{padding-block:5px!important}
.row .n{font-size:16px!important}
#v-itens.work{align-items:stretch!important}
#v-itens>.panel{width:100%}
.row{padding-block:3px!important;row-gap:0!important}
.row .d{font-size:13px;line-height:1.25}
.row .s{font-size:11.5px;line-height:1.2}
.row .dwb{padding:2px 8px}
.row .pill{padding-block:1px}
.ini .side-act{flex-direction:row;flex-wrap:wrap}.ini .side-act .btn{width:auto}
body[data-tab="ini"] #inbox,body[data-tab="ini"] #summary,body[data-tab="ini"] #banner{display:none!important}

.row[data-st="new"]{border-left-color:var(--accent)}

/* ===== v61: Início e menu lateral =====
   Conceito: folha de desenho técnico. A capa é uma prancha escura na cor da empresa, com malha milimetrada,
   a rede de agentes como esquema, índice de agentes à esquerda e carimbo no canto. O menu usa um só tom, e o destaque vem do acento da empresa. */
:root{
  --f-disp:'Archivo','Arial Narrow',sans-serif;
  --cap-bg:#070B30;--cap-bg2:#121A5C;--cap-ink:#F1F3FF;--cap-mute:#98A1D8;
  --cap-line:rgba(152,161,216,.20);--cap-grid:rgba(152,161,216,.055);--cap-grid2:rgba(152,161,216,.11);
}
:root[data-emp="STAR"]{--cap-bg:#00132B;--cap-bg2:#023566;--cap-mute:#8FB0D2;--cap-line:rgba(143,176,210,.20);--cap-grid:rgba(143,176,210,.055);--cap-grid2:rgba(143,176,210,.11)}

/* menu lateral */
.side{gap:18px}
.side .brand{display:none}
.mk{display:flex;align-items:center;gap:11px;padding:2px 6px 4px}
.mk-ic{width:34px;height:34px;flex:0 0 34px}
.mk-n{font:800 22px/1 var(--f-disp);font-stretch:78%;letter-spacing:.06em;color:var(--side-ink)}
.mk-s{font:600 10.5px/1.2 var(--f-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--side-mute);margin-top:4px}
.side .emp-sw .eyebrow{display:block;font:600 10.5px var(--f-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--side-mute);padding:0 6px}
.emp-btns{background:rgba(0,0,0,.18);border:1px solid var(--side-line)}
.emp-btns button{font:700 12.5px var(--f-body);letter-spacing:.08em;padding:7px 0}
.mods{gap:1px}
.side{overflow-x:hidden}
.mod,.mod2{font-weight:600;color:var(--side-ink);position:relative;gap:10px;min-width:0}
.mod>span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mod .ic{color:var(--side-mute);stroke:currentColor;transition:color .15s}
.mod:hover .ic,.mod.open .ic{color:var(--side-ink)}
.mod[aria-current="page"]{background:rgba(255,255,255,.09)}
.mod[aria-current="page"]::before,.side .tabs button[aria-selected="true"]::before{content:"";position:absolute;left:0;top:9px;bottom:9px;width:3px;border-radius:0 3px 3px 0;background:var(--red)}
.mod[aria-current="page"] .ic{color:var(--red)}
.mod[data-dev]{color:var(--side-mute)}
.mod[data-dev] .chev{display:none}
.mod[data-dev]::after{content:"";margin-left:auto;flex:0 0 7px;width:7px;height:7px;border-radius:50%;border:1.5px solid var(--side-mute);opacity:.7}
.mod3{color:var(--side-mute);font-family:var(--f-mono);font-weight:600;letter-spacing:.12em}
.side .tabs button{position:relative;color:var(--side-mute);font-weight:600}
.side .tabs button[aria-selected="true"]{background:rgba(255,255,255,.09);color:var(--side-ink)}

/* capa */
.cap{display:grid;grid-template-columns:minmax(300px,390px) minmax(0,1fr);position:relative;isolation:isolate;border-radius:20px;overflow:hidden;min-height:440px;color:var(--cap-ink);
  background:radial-gradient(110% 90% at 68% 42%,var(--cap-bg2) 0%,var(--cap-bg) 64%)}
.cap[hidden]{display:none!important}
.cap::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
  background-image:linear-gradient(var(--cap-grid2) 1px,transparent 1px),linear-gradient(90deg,var(--cap-grid2) 1px,transparent 1px),linear-gradient(var(--cap-grid) 1px,transparent 1px),linear-gradient(90deg,var(--cap-grid) 1px,transparent 1px);
  background-size:120px 120px,120px 120px,24px 24px,24px 24px;background-position:-1px -1px}
.cap-t{display:flex;flex-direction:column;gap:22px;padding:34px 30px 28px;border-right:1px solid var(--cap-line);min-width:0;overflow:auto;background:linear-gradient(90deg,rgba(0,0,0,.22),rgba(0,0,0,.08))}
.cap-k{display:flex;align-items:center;gap:8px;font:600 11px var(--f-mono);letter-spacing:.14em;text-transform:uppercase;color:var(--cap-mute)}
.cap-k::before{content:"";width:8px;height:8px;background:var(--red)}
.cap-t h1{margin:0;border:0;padding:0;font:800 clamp(44px,4.6vw,64px)/.9 var(--f-disp);font-stretch:72%;letter-spacing:.01em;text-transform:uppercase;color:var(--cap-ink)}
.cap-t h1 b{display:block;color:var(--red);font-weight:800}
.cap-t p{margin:0;font-size:14.5px;line-height:1.55;color:var(--cap-mute);max-width:34ch}
.cap-m{display:flex;flex-direction:column;gap:8px}
.cap-mh{display:flex;justify-content:space-between;align-items:baseline;font:600 11px var(--f-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--cap-mute)}
.cap-mh b{font:500 20px var(--f-mono);letter-spacing:0;color:var(--cap-ink);font-variant-numeric:tabular-nums}
.cap-bar{display:grid;grid-template-columns:repeat(10,1fr);gap:3px}
.cap-bar i{height:6px;background:var(--cap-line)}
.cap-bar i.on{background:var(--red)}
.cap-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:0 14px;border-top:1px solid var(--cap-line)}
.cap-list li{border-bottom:1px solid var(--cap-line)}
.cap-list button{display:flex;align-items:center;gap:9px;width:100%;padding:8px 2px;background:none;border:0;color:var(--cap-mute);font:500 12.5px var(--f-body);text-align:left;cursor:pointer;transition:color .15s}
.cap-list button span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cap-list button i{flex:0 0 8px;width:8px;height:8px;border-radius:50%;border:1.5px solid var(--cap-mute)}
.cap-list button.on{color:var(--cap-ink);font-weight:700}
.cap-list button.on i{background:var(--red);border-color:var(--red)}
.cap-list button:hover,.cap-list button.ag-hl{color:var(--cap-ink)}
.cap-list button.ag-hl i{border-color:var(--cap-ink)}
.cap-go{align-self:flex-start;display:inline-flex;align-items:center;gap:10px;margin-top:4px;padding:11px 18px;border:0;border-radius:10px;background:var(--red);color:var(--on-red);font:700 14px var(--f-body);cursor:pointer;transition:filter .15s,transform .15s}
.cap-go:hover{filter:brightness(1.08)}
.cap-go:active{transform:translateY(1px)}
.cap-go:focus-visible,.cap-list button:focus-visible{outline:2px solid var(--cap-ink);outline-offset:2px}
.cap-stage{position:relative;min-width:0;min-height:360px}
#brain{position:absolute;inset:0;width:100%;height:100%;display:block}
.cap-reg{position:absolute;width:14px;height:14px;pointer-events:none;border-color:var(--cap-mute);border-style:solid;opacity:.55}
.cap-reg.a{top:18px;left:18px;border-width:1px 0 0 1px}.cap-reg.b{top:18px;right:18px;border-width:1px 1px 0 0}
.cap-reg.c{bottom:18px;left:18px;border-width:0 0 1px 1px}.cap-reg.d{bottom:18px;right:18px;border-width:0 1px 1px 0}
.cap-leg{position:absolute;top:22px;right:40px;display:flex;gap:16px;font:600 10.5px var(--f-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--cap-mute)}
.cap-leg span{display:inline-flex;align-items:center;gap:6px}
.cap-leg i{width:8px;height:8px;border-radius:50%;border:1.5px solid var(--cap-mute)}
.cap-leg i.on{background:var(--red);border-color:var(--red)}
.cap-cb{position:absolute;right:40px;bottom:36px;display:grid;grid-template-columns:auto auto auto auto;border:1px solid var(--cap-line);background:rgba(0,0,0,.25);font-family:var(--f-mono)}
.cap-cb>div{padding:6px 12px;border-left:1px solid var(--cap-line);min-width:0}
.cap-cb>div:first-child{border-left:0}
.cap-cb span{display:block;font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--cap-mute)}
.cap-cb b{display:block;font-size:12.5px;font-weight:500;color:var(--cap-ink);white-space:nowrap}
@media (max-width:900px){
  .cap{grid-template-columns:minmax(0,1fr)}
  .cap-t{border-right:0;border-bottom:1px solid var(--cap-line);overflow:visible}
  .cap-go{margin-top:0}
  .cap-cb{left:16px;right:16px;bottom:16px;grid-template-columns:repeat(4,minmax(0,1fr))}
  .cap-leg{right:auto;left:42px}
}
@media (max-width:480px){.cap-list{grid-template-columns:minmax(0,1fr)}.cap-cb>div:nth-child(n+3){display:none}.cap-cb{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (prefers-reduced-motion:reduce){.cap-go,.cap-list button,.mod .ic{transition:none}}
</style>

<div class="shell">
<aside class="side" aria-label="Menu">
  <div class="mk"><svg class="mk-ic" viewBox="0 0 34 34" aria-hidden="true"><rect width="34" height="34" rx="9" style="fill:var(--red)"/><circle cx="17" cy="17" r="9" fill="none" stroke-width="2.4" style="stroke:var(--on-red)"/><circle cx="17" cy="17" r="3.2" style="fill:var(--on-red)"/><path d="M3 17h5M26 17h5M17 3v5M17 26v5" fill="none" stroke-width="1.6" stroke-linecap="round" style="stroke:var(--on-red)"/></svg><div><div class="mk-n">MISTA</div><div class="mk-s">Gestão integrada</div></div></div>
  <div class="brand"><img class="logo" id="logo" alt="MIX Usinagem Componentes" src="DATA">
    <div><div class="eyebrow" id="brand-eb">MIX Usinagem</div><h1>Vendas</h1></div>
  </div>
  <div class="emp-sw" role="group" aria-label="Empresa do rascunho"><span class="eyebrow">Empresa</span>
    <div class="emp-btns"><button type="button" id="emp-MIX" data-emp="MIX" aria-pressed="true">MIX</button><button type="button" id="emp-STAR" data-emp="STAR" aria-pressed="false">STAR</button></div></div>
  <div class="mods" aria-label="Módulos">
    <button type="button" class="mod" data-cap="1"><svg class="ic" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#5aa2ff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h5v-6h4v6h5V10"/></svg><span>Início</span></button>
    <button type="button" class="mod open" data-tog="adm" aria-expanded="true"><svg class="ic" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#8f8cff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2M3 13h18"/></svg><span>Administrativo</span><svg class="chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
    <div class="subs" id="s-adm">
      <button type="button" class="mod2 open" data-tog="ven" aria-expanded="true"><span>Vendas</span><svg class="chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
      <div class="subs2" id="s-ven">
        <nav class="tabs" role="tablist" aria-label="Seções">
    <button type="button" role="tab" id="t-ini" aria-selected="true" data-tab="ini">Dashboard</button>
    <button type="button" role="tab" id="t-pc" aria-selected="false" data-tab="pc">Proposta comercial</button>
  </nav>
      </div>
    </div>
    <button type="button" class="mod" data-tog="ctl" aria-expanded="false"><svg class="ic" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#ff6b88" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3v9l7 5"/></svg><span>Controladoria</span><svg class="chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
    <div class="subs" id="s-ctl"><nav class="tabs" role="tablist" aria-label="Controladoria"><button type="button" role="tab" id="t-par" aria-selected="false" data-tab="par">Parâmetros de custo</button></nav></div>
  </div>
</aside>
<div class="app">
  <div class="crumbbar"><div class="cr" id="crumb"></div><h2 id="crumb-t"></h2></div>
  
<section class="panel loadbar" id="loadbar">
    <div class="askbox" id="newbox" hidden></div>
    <div class="askbox" id="askbox" hidden></div>
    <div class="pastebox" id="pastebox" hidden>
      <textarea id="paste-ta" placeholder="Um código por linha, com a quantidade. Exemplo:&#10;28.12.23 - 20 peças&#10;35.12.10 - 5 peças&#10;&#10;Ou cole a tabela do e-mail (SC, Produto, Descrição, Quantidade)."></textarea>
      <div class="actions"><button class="btn pri sm" id="paste-go" type="button">Gerar itens</button><button class="btn sm" id="paste-x" type="button">Fechar</button></div>
    </div>
  </section>

  <section class="summary" id="summary" aria-label="Resumo do orçamento"></section>

  <div class="banner" id="banner">
    <span>Exemplo carregado: os 4 itens do orçamento 0537/26. Carregue um pedido de cliente para começar um orçamento de verdade.</span>
    <span class="acts">
      <button class="btn sm" id="b-reset" type="button">Restaurar exemplo</button>
      <button class="btn sm" id="b-blank" type="button">Começar em branco</button>
    </span>
  </div>


  <main>
    <section id="v-cap" class="cap" hidden>
      <div class="cap-t">
        <div class="cap-k">MIX Usinagem · STAR Tornearia</div>
        <h1>Cérebro <b>MISTA</b></h1>
        <p>Agentes conectados que vão evoluir até formar o sistema nervoso da fábrica.</p>
        <div class="cap-m"><div class="cap-mh">Agentes ativos <b id="cap-n"></b></div><div class="cap-bar" id="cap-bar"></div></div>
        <ul class="cap-list" id="cap-list" aria-label="Agentes"></ul>
        <button type="button" class="cap-go" id="cap-go">Abrir Vendas <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      </div>
      <div class="cap-stage">
        <canvas id="brain" aria-label="Rede de agentes do CÉREBRO MISTA"></canvas>
        <i class="cap-reg a"></i><i class="cap-reg b"></i><i class="cap-reg c"></i><i class="cap-reg d"></i>
        <div class="cap-leg"><span><i class="on"></i>Ativo</span><span><i></i>Em desenvolvimento</span></div>
        <div class="cap-cb"><div><span>Sistema</span><b>MISTA</b></div><div><span>Empresa</span><b id="cap-emp">MIX Usinagem</b></div><div><span>Versão</span><b id="cap-ver"></b></div><div><span>Data</span><b id="cap-dt"></b></div></div>
      </div>
    </section>
    <section id="v-ini" class="ini"><div class="pwrap" id="dash"></div></section>
    <section id="v-pc" hidden>
      <div class="pc-bar">
        <nav class="etabs pc-tabs" id="pc-tabs" role="tablist" aria-label="Proposta comercial">
          <button type="button" role="tab" data-pcs="in" aria-selected="false">Caixa de entrada <span class="bd" id="bd-in"></span></button>
          <button type="button" role="tab" data-pcs="sv" aria-selected="false">Propostas <span class="bd" id="bd-sv"></span></button>
          <button type="button" role="tab" data-pcs="itens" aria-selected="false">Itens</button>
        </nav>
        <span class="pc-filters"><input id="pf-q" placeholder="Filtrar por cliente, nº, código…" autocomplete="off"><select id="pf-st" hidden></select><select id="pf-emp"><option value="">Todas as empresas</option><option>MIX</option><option>STAR</option></select></span>
        <span class="sp"></span><span class="pidline" id="pid-badge"></span>
        <button class="btn sm pri" id="b-new" type="button">+ Nova proposta</button>
        <button class="btn sm" id="b-save" type="button">Salvar proposta</button>
        <input type="file" id="file-in" accept=".xls,.xlsx,.csv" multiple hidden>
      </div>
      <div id="pc-body">
      <div id="v-in" hidden><div class="inbox" id="inbox" hidden></div><div class="hint" id="in-empty">Nenhum pedido na caixa de entrada.</div></div>
      <div id="v-sv" hidden><div class="pl-row pl-h"><span>Nº</span><span>Cliente</span><span>Itens</span><span>Total</span><span>Status</span><span>Atualizado</span><span></span></div><div id="pf-list"></div></div>
    <section id="v-itens" class="work" hidden>
      <div class="meta panel" id="topmeta">
      <label>Cliente<input id="cli" value="" autocomplete="off" list="dl-cli" placeholder="Digite para buscar o cliente"></label>
      <label>Solicitação do cliente<input id="sol-in" value="" autocomplete="off" placeholder="ex.: Cotação 21854 de 16/10" style="min-width:230px"></label>
      <label>Pagamento<select id="cond" style="min-width:130px"></select></label>
    </div>
      <div class="panel">
        <div class="panel-h"><h3>Itens do orçamento</h3><span class="ph-act"><button class="btn sm" id="b-paste" type="button">Colar lista</button><button class="btn sm" id="b-imp" type="button">Importar</button><button class="btn sm pri" id="add" type="button">+ Novo item</button></span></div>
        <div class="rowh" id="listh"><span>#</span><span>Item</span><span>Rev.</span><span>Prazo</span><span>Desenho</span><span>Situação</span><span>Unitário</span><span>Total</span><span></span></div>
        <div class="list" id="list"></div>
        <div class="legend"><span><span class="dot ok"></span>preço recente</span><span><span class="dot warn"></span>atenção</span><span><span class="dot old"></span>preço antigo</span><span><span class="dot new"></span>código novo</span><span><span class="dot quo"></span>cotado, sem venda</span></div>
      </div>
      <div class="edmask" id="edmask" hidden></div><div class="panel editor" id="editor"></div>
      <div class="ifoot" id="ifoot"></div>
      <datalist id="dl-cli"></datalist><datalist id="dl-cod"></datalist><datalist id="dl-desc"></datalist>
    </section>

    <section class="panel" id="closebox" hidden><div class="sec"><h3>Fechar rascunho</h3>
      <div class="cb-sum" id="cb-sum"></div>
      <label class="f" hidden style="max-width:300px"><span class="lb">Nº da proposta no Caprind (preencher depois de lançar no Caprind)</span><input id="prop-no" value="" autocomplete="off" placeholder="ex.: 547/26"></label>
      <div class="actions"><button class="btn pri" id="b-close" type="button">Fechar rascunho</button><button class="btn pri" id="b-pdf" type="button" hidden>Gerar PDF</button><button class="btn" id="b-reopen" type="button" hidden>Reabrir para editar</button></div>
      <span class="hint" id="cb-hint"></span></div></section>

    <section id="v-prop" hidden><div class="panel doc" id="proposal"></div></section>
      </div>
    </section>
    <section id="v-par" hidden><div class="hint" id="hist-status" style="margin-bottom:10px"></div><div class="pwrap" id="params"></div></section>
  </main>
  <p class="hint" id="foot" hidden>Rascunho salvo neste navegador. Os arquivos carregados são lidos aqui mesmo, no seu navegador, e não são enviados a lugar nenhum. Protótipo: ainda não grava no Caprind nem lê e-mails.</p>
</div>
</div>
<div class="cfm" id="cfm" hidden><div class="cfm-b" role="alertdialog" aria-modal="true"><h3 id="cfm-t">Excluir?</h3><p id="cfm-p"></p><div class="cfm-a"><button type="button" class="btn" id="cfm-n">Não</button><button type="button" class="btn pri" id="cfm-y">Sim</button></div></div></div>
<div class="alarm" id="alarm" role="alert" hidden></div>
<div class="toast" id="toast" hidden></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
(function(){
"use strict";
var LS="mesa-orcamento-mix-v0", LSH="mesa-historico-mix-v1";
var VER=7, DENS=7.85, NM=9, MS=86400000;
var $=function(id){return document.getElementById(id)};

/* ---------- formas de matéria-prima e densidade ---------- */
var SHAPES=[
  {k:"red",n:"Barra redonda",dims:["Ø (mm)"],vol:function(a,b,c,L){return Math.PI/4*a*a*L}},
  {k:"quad",n:"Barra quadrada",dims:["Lado (mm)"],vol:function(a,b,c,L){return a*a*L}},
  {k:"sext",n:"Barra sextavada",dims:["Entre faces (mm)"],vol:function(a,b,c,L){return 0.8660254*a*a*L}},
  {k:"ret",n:"Barra retangular / chata / chapa",dims:["Largura (mm)","Espessura (mm)"],vol:function(a,b,c,L){return a*b*L}},
  {k:"furada",n:"Barra furada (tarugo oco)",dims:["Ø externo (mm)","Ø interno (mm)"],vol:function(a,b,c,L){return b<a?Math.PI/4*(a*a-b*b)*L:NaN}},
  {k:"tubo",n:"Tubo redondo",dims:["Ø externo (mm)","Parede (mm)"],vol:function(a,b,c,L){return b>0&&2*b<a?Math.PI*(a-b)*b*L:NaN}},
  {k:"tubq",n:"Tubo quadrado / retangular",dims:["Lado A (mm)","Lado B (mm)","Parede (mm)"],vol:function(a,b,c,L){return c>0&&2*c<Math.min(a,b)?(a*b-(a-2*c)*(b-2*c))*L:NaN}}
];
function densDefault(n,f){
  var t=(n+" "+f).toUpperCase().replace(/EXCETO\s*7075/,"");
  if(/7075/.test(t))return 2.81;
  if(/ALUM/.test(t))return 2.70;
  if(/LAT[ÃA]O/.test(t))return 8.50;
  if(/BRONZE|TM\s?23|TM\s?360/.test(t))return 8.80;
  if(/316/.test(t))return 7.98;
  if(/304|303/.test(t))return 7.93;
  if(/410|416|420|430|440/.test(t))return 7.75;
  if(/NODULAR|FERRO FUNDIDO/.test(t))return 7.10;
  if(/\bD6\b/.test(t))return 7.70;
  if(/ACR[ÍI]LICO/.test(t))return 1.19;
  if(/POLIURETANO/.test(t))return 1.25;
  if(/NYLON|POLIAMIDA/.test(t))return 1.14;
  if(/\bPOM\b|ACETAL/.test(t))return 1.41;
  return 7.85;
}
function shapeFromForm(f){
  var t=String(f||"").toUpperCase();
  if(/QUADRADA/.test(t))return 1;
  if(/SEXTAV/.test(t))return 2;
  if(/CHAPA|RETANG|CHATA/.test(t))return 3;
  if(/REDONDA/.test(t))return 0;
  return -1;
}
function rawKg(it){
  var P=S.P,m=P.mat[it.mat]||P.mat[0],sh=SHAPES[it.forma||0]||SHAPES[0];
  var dn=n0(m&&m.d)>0?n0(m.d):DENS;
  var a=n0(it.cd),b=n0(it.c2),c=n0(it.c3),L=n0(it.cl);
  var v=(a>0&&L>0)?sh.vol(a,b,c,L):NaN;
  var kg=isFinite(v)&&v>0?v/1000*dn/1000:NaN;
  return{kg:kg,dens:dn,sh:sh};
}

/* ---------- parâmetros ---------- */
function defaultParams(){return withDens({
  condcli:["GASCAT = 120 DDL","PROMAQUINA = 28 DDL","MARRUCCI = 28 DDL","NEXT = 30 DDL","NEDERMAN = 30 DDL","HINE = 30 DDL","MULTIPACK = 28 DDL","MULTI PACK = 28 DDL"],
  conds:["À vista","7 DDL","14 DDL","21 DDL","28 DDL","30 DDL","30/60 DDL","30/60/90 DDL","45 DDL","60 DDL","90 DDL","120 DDL"],
  maq:[{n:"Torno CNC",r:150},{n:"Centro de usinagem",r:180},{n:"Torno mecânico (convencional)",r:100},{n:"Fresadora",r:100},
       {n:"Serra de fita",r:50},{n:"Inspeção de qualidade",r:60},
       {n:"Retífica (terceiro)",r:120,ext:true},{n:"Erosão a fio (terceiro)",r:200,ext:true},{n:"Soldagem (terceiro)",r:40,ext:true,pp:true},{n:"Corte a laser (terceiro)",r:20,ext:true,pp:true,kg:true}],
  mat:[{n:"Aço 1010 / 1020 / 1040 / 1045",f:"Barra redonda",r:12},
       {n:"Aço 4140 / 4340 / 8620 / 20MnCr5 / 11SMn30 / 11SMn37 / 12L14",f:"Barra redonda",r:20},
       {n:"Aço 1020 / 1045 / A36 / A516 GR70 / SAC350",f:"Chapa (laser ou oxicorte)",r:22},
       {n:"Aço 1020 / 1045 / A36 / A516 GR70 / SAC350",f:"Barra quadrada",r:20},
       {n:"Inox 316 / 316L",f:"Barra redonda",r:65},{n:"Inox 304",f:"Barra redonda",r:50},{n:"Inox 410 / 420",f:"Barra redonda",r:40},
       {n:"Alumínio em geral: 6351, 5052, 6061 (exceto 7075)",f:"Barra redonda",r:50},{n:"Alumínio 7075",f:"Barra redonda",r:75},
       {n:"Latão C360",f:"Barra redonda",r:100},{n:"Bronze TM23",f:"Barra redonda",r:110},
       {n:"Aço ferramenta D6",f:"Barra redonda",r:0},{n:"Ferro fundido nodular",f:"Barra redonda",r:0},
       {n:"Nylon (poliamida)",f:"Barra redonda",r:0},{n:"Poliacetal (POM)",f:"Barra redonda",r:0},{n:"Acrílico",f:"Barra redonda",r:0}],
  terc:[{n:"Nenhum",r:0,mode:"kg"},
        {n:"Zincagem / Bicromatizado / Zincado branco",r:10,mode:"kg",minKg:10,forn:"Vários fornecedores"},
        {n:"Oxidação negra",r:15,mode:"kg",minKg:10,forn:"Vários fornecedores"},
        {n:"TENOX (nitretação + oxidação negra)",r:485,mode:"lote",capKg:20,forn:"Lote de até 20 kg"},
        {n:"Anodização dura (camada 0,030 a 0,040 mm)",r:180,mode:"kg",minR:200},
        {n:"Anodização decorativa",r:20,mode:"kg"},
        {n:"Cementação, camada 0,2 a 1,0 mm (Agemetal)",r:7.8,mode:"kg",minR:170,forn:"Agemetal"},
        {n:"Cementação, camada 1,01 a 1,4 mm (Agemetal)",r:11.2,mode:"kg",minR:170,forn:"Agemetal"},
        {n:"Têmpera/revenimento: aços ferramenta e inox 410-440 (Agemetal)",r:11.4,mode:"kg",minR:170,forn:"Agemetal"},
        {n:"Têmpera/revenimento: aços ligados e construção mecânica (Agemetal)",r:6.3,mode:"kg",minR:170,forn:"Agemetal"},
        {n:"Jateamento automático (Agemetal)",r:2.8,mode:"kg",minR:170,forn:"Agemetal"},
        {n:"Normalização (Agemetal)",r:2.8,mode:"kg",minR:170,forn:"Agemetal"},
        {n:"Recozimento (Agemetal)",r:3.2,mode:"kg",minR:170,forn:"Agemetal"},
        {n:"Alívio de tensão: construção mecânica (Agemetal)",r:2,mode:"kg",minR:170,forn:"Agemetal"},
        {n:"Alívio de tensão: aços ferramenta (Agemetal)",r:2.4,mode:"kg",minR:170,forn:"Agemetal"}],
  imp:13,mar:35,alerta:30,fixo:175000,gasto:275000,
  hAt:120,hOld:365,hStale:12
})}
function withDens(P){P.mat.forEach(function(m){if(!(n0(m.d)>0))m.d=densDefault(m.n,m.f)});return P}
function tercIdx(P,name){var k=-1;P.terc.forEach(function(t,i){if(t.n===name)k=i});return k}
var uid=0;
function emptyT(){var a=[];for(var i=0;i<NM;i++)a.push(["",""]);return a}
function blankItem(){uid++;return{ex:[],id:"i"+Date.now()+"_"+uid,desc:"",dwg:"",qtd:"1",mat:0,pa:"",pb:"",terc:0,corrida:"1",outros:"",
  t:emptyT(),preco:"",modo:"auto",ref:"",cd:"",c2:"",c3:"",forma:0,cl:"",f:{tol:false,exo:false,trat:false},cli:"",nota:"",
  cod:"",ordem:"",tipo:"Venda",prazo:"",entTxt:"",revReq:"",matTxt:"",req:""}}
function sampleItems(){
  var P=defaultParams();
  function mk(o){var b=blankItem();for(var k in o)b[k]=o[k];return b}
  function tt(m){var a=emptyT();for(var k in m)a[k]=m[k];return a}
  return[
   mk({desc:"Chaveta D60 LD24 lisa",dwg:"10.010.005.207.01",qtd:"2",pa:"0,12",pb:"0,20",terc:tercIdx(P,"Têmpera/revenimento: aços ligados e construção mecânica (Agemetal)"),
       t:tt({3:["15","40"]}),ref:"135",cd:"19",cl:"104",nota:"T.R. 34-38 HRc no desenho. Se for tratada sozinha, vale o mínimo de R$ 170 da Agemetal. Aumente “itens na mesma corrida” se for junto com outros."}),
   mk({desc:"Anel distanciador",dwg:"10.010.007.270.00",qtd:"2",pa:"0,15",pb:"0,60",t:tt({0:["15","40"]}),ref:"125",cd:"63,5",cl:"25"}),
   mk({desc:"Flange extrusora 60 lisa x troca tela",dwg:"10.018.018.367.00",qtd:"2",pa:"16,73",pb:"24",t:tt({0:["15","180"],3:["15","60"]}),ref:"870",cd:"254",cl:"60"}),
   mk({desc:"Flange extrusora D60 lisa x cabeçote",dwg:"10.010.008.720.01",qtd:"2",pa:"10,52",pb:"17",terc:tercIdx(P,"TENOX (nitretação + oxidação negra)"),
       t:tt({0:["15","150"],3:["15","60"]}),ref:"780",cd:"216",cl:"60",f:{tol:false,exo:false,trat:true},
       nota:"TENOX indicado no desenho. Confirmar se foi aplicado nesta peça e como o TENOX é cobrado acima de 20 kg."})
  ];
}
var S={v:VER,P:defaultParams(),items:sampleItems(),sel:0,cli:"Multi Pack Plas Ind. e Com. de Máquinas Ltda.",prop:"0537/26",cond:"28 DDL",sample:true,tab:"ini",hist:null};
function migrate(o){
  if(o.v>=VER)return o;
  var NP=defaultParams();
  if(o.v<2){
    var oldT=(o.P&&o.P.terc)||[];
    var map={"Nenhum":"Nenhum","Zincagem":"Zincagem / Bicromatizado / Zincado branco","Anodização":"Anodização decorativa",
      "Oxidação":"Oxidação negra","Têmpera e revenimento":"Têmpera/revenimento: aços ligados e construção mecânica (Agemetal)"};
    o.items=o.items.filter(function(it){return it.id!=="seed_gascat_28_12_23"});
    o.items.forEach(function(it){
      var nm=oldT[it.terc]?oldT[it.terc].n:"Nenhum",k=tercIdx(NP,map[nm]||"Nenhum");
      it.terc=k<0?0:k;
      if(!it.t)it.t=[];
      while(it.t.length<NM)it.t.push(["",""]);
      if(it.mat>1)it.mat=0;
    });
    o.P=NP;
  }
  o.items.forEach(function(it){
    if(!it.corrida)it.corrida="1";
    ["nota","cli","cod","ordem","entTxt","revReq","matTxt","req"].forEach(function(k){if(it[k]==null)it[k]=""});
    if(!it.modo)it.modo="auto";fillRev(it);
  });
  ["hAt","hOld","hStale"].forEach(function(k){if(o.P[k]==null)o.P[k]=NP[k]});
  (function(){
    var ren={"Aço 1010 / 1020 / 1045":"Aço 1010 / 1020 / 1040 / 1045",
      "Aço 4140 / 4340 / 8620 / 20MnCr5 / 11SMn30":"Aço 4140 / 4340 / 8620 / 20MnCr5 / 11SMn30 / 11SMn37 / 12L14",
      "Inox 316":"Inox 316 / 316L","Latão":"Latão C360","Alumínio em geral (exceto 7075)":"Alumínio em geral: 6351, 5052, 6061 (exceto 7075)"};
    o.P.mat.forEach(function(m){if(ren[m.n]&&m.f==="Barra redonda")m.n=ren[m.n]});
    NP.mat.forEach(function(m){
      if(!o.P.mat.some(function(x){return x.n===m.n&&x.f===m.f}))o.P.mat.push({n:m.n,f:m.f,r:m.r,d:m.d});
    });
  })();
  NP.maq.forEach(function(m,i){if(!o.P.maq.some(function(x){return x.n===m.n}))o.P.maq.push({n:m.n,r:m.r,ext:m.ext,pp:m.pp,kg:m.kg})});
  if(!o.P.conds)o.P.conds=NP.conds.slice();
  if(!o.P.condcli)o.P.condcli=NP.condcli.slice();
  withDens(o.P);
  o.items.forEach(function(it){if(it.forma==null)it.forma=0;if(it.c2==null)it.c2="";if(it.c3==null)it.c3=""});
  if(o.cond==null)o.cond="28 DDL";
  if(o.sel>=o.items.length)o.sel=0;
  o.v=VER;
  return o;
}
try{var raw=localStorage.getItem(LS);if(raw){var o=JSON.parse(raw);if(o&&o.items&&o.P){S=migrate(o);S.tab="ini"}}}catch(e){}
S.hist=null;
try{var rh=localStorage.getItem(LSH);if(rh){var oh=JSON.parse(rh);if(oh&&oh.map)S.hist=oh}}catch(e){}
var saveT=null,warnedQuota=false;
function lsSave(){try{localStorage.setItem(LS,JSON.stringify(S,function(k,v){return k==="hist"?undefined:v}))}catch(e){}}
function save(){clearTimeout(saveT);saveT=setTimeout(lsSave,300);pQueue()}
function saveHist(){
  try{localStorage.setItem(LSH,JSON.stringify(S.hist))}catch(e){
    if(!warnedQuota){warnedQuota=true;toast("O histórico é grande demais para ficar guardado. Carregue o arquivo de novo na próxima vez.")}
  }
}

/* ---------- números e datas ---------- */
function parse(s){
  if(typeof s==="number")return s;
  s=String(s==null?"":s).trim();
  if(!s)return NaN;
  if(s.indexOf(",")>-1)s=s.replace(/\./g,"").replace(",",".");
  var v=parseFloat(s);return isNaN(v)?NaN:v;
}
function n0(s){var v=parse(s);return isNaN(v)?0:v}
function num(x){if(typeof x==="number")return x;var v=parseFloat(String(x==null?"":x).replace(",","."));return v}
function brl(v){return isFinite(v)?v.toLocaleString("pt-BR",{style:"currency",currency:"BRL"}):"–"}
function nf(v,d){return isFinite(v)?v.toLocaleString("pt-BR",{minimumFractionDigits:d,maximumFractionDigits:d}):"–"}
function pct(v){return isFinite(v)?nf(v*100,1)+"%":"–"}
function fh(h){if(!isFinite(h)||h<=0)return "–";var m=Math.round(h*60);return Math.floor(m/60)+" h "+("0"+(m%60)).slice(-2)+" min"}
function esc(s){return String(s==null?"":s).replace(/&/g,"&amp;").replace(/"/g,"&quot;").replace(/</g,"&lt;")}
function dayStart(d){return new Date(d.getFullYear(),d.getMonth(),d.getDate()).getTime()}
function today0(){return dayStart(new Date())}
function toDay(v){
  if(v==null||v==="")return NaN;
  if(v instanceof Date){return isNaN(v.getTime())?NaN:dayStart(new Date(v.getTime()+12*3600000))}
  if(typeof v==="number"){if(v>20000&&v<80000){var u=new Date(Math.round((v-25569)*MS));return new Date(u.getUTCFullYear(),u.getUTCMonth(),u.getUTCDate()).getTime()}return NaN}
  var s=String(v).trim(),m;
  if((m=s.match(/^(\d{4})-(\d{2})-(\d{2})/)))return new Date(+m[1],+m[2]-1,+m[3]).getTime();
  if((m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2,4})/))){var y=+m[3];if(y<100)y+=2000;return new Date(y,+m[2]-1,+m[1]).getTime()}
  return NaN;
}
function fmtD(ms){return isFinite(ms)?new Date(ms).toLocaleDateString("pt-BR"):"–"}
function ageLabel(days){
  if(days<1)return "hoje";
  if(days<31)return "há "+days+(days===1?" dia":" dias");
  var m=Math.round(days/30.44);
  if(m<12)return "há "+m+(m===1?" mês":" meses");
  var y=Math.floor(m/12),r=m%12;
  return "há "+y+(y===1?" ano":" anos")+(r?" e "+r+(r===1?" mês":" meses"):"");
}
function monthsBetween(a,b){return Math.round((b-a)/(30.44*MS))}

/* ---------- histórico de faturamento ---------- */
function parseFaturadas(rows){
  var map={},sec="",pend="",lines=0,first=Infinity,last=0;
  rows.forEach(function(r){
    var v=r.filter(function(c){return c!=null&&String(c).trim()!==""});
    if(!v.length)return;
    var s=String(v[0]).trim();
    if(/^Proposta\/pedido/i.test(s)){sec=pend;return}
    if(v.length===1&&!/^(Follow|Faturadas|Tel|Site|K:)/i.test(s)){pend=s.split(/\s+/)[0].toUpperCase();return}
    if(!/^\d{4}\/\d{2}\s*-\s*\d+/.test(s)||v.length<8)return;
    var rest=v.slice(2),n=rest.length;
    var ms=toDay(rest[n-1]),q=num(rest[n-3]),u=num(rest[n-4]),desc=String(rest[n-5]),cod=String(rest[n-6]);
    if(!isFinite(u)||!isFinite(q)||isNaN(ms))return;
    var cp=cod.split(/\s+-\s+/),c0=cp[0].trim().toUpperCase(),rev=cp.slice(1).join("-").trim();
    var prop=s.replace(/\s*-\s*\d+\s*$/,"").trim();
    var e=map[c0]||(map[c0]={ev:[],desc:"",lastMs:0});
    e.ev.push([ms,u,q,prop,sec,rev]);
    if(ms>=e.lastMs){e.lastMs=ms;e.desc=desc}
    lines++;if(ms<first)first=ms;if(ms>last)last=ms;
  });
  return{map:map,lines:lines,codes:Object.keys(map).length,first:first,last:last};
}
/* número do desenho: usado quando o código do cliente não aparece no histórico */
function dwgKey(s){
  s=String(s||"").trim().replace(/(?:(?<=\d)\s*|\s+)R\s*:?\s*[0-9]+[A-Za-z]?\s*$|\s+R\s*:?\s*[0-9A-Za-z]+\s*$/i,"").replace(/^[^0-9A-Za-z]+/,"").replace(/[^0-9A-Za-z.\-\/]+$/,"");
  return s.length>=6&&/\d/.test(s)?s.toUpperCase():"";
}
var DWG_LINKS={"30.019.4": {"u": "/_blob/327a867d3e437c55ea23f913e4979e2a", "n": "30.019.4_R2.pdf", "r": "2"}, "14.030.3": {"u": "/_blob/4080886483d210ba8587d446824eb580", "n": "14.030.3_R2.pdf", "r": "2"}, "30.170.3": {"u": "/_blob/94f68ea77247178b03af9493cea098d5", "n": "30.170.3_R4.pdf", "r": "4"}};
function revN(r){return String(r||"").replace(/^R/i,"").replace(/^0+(?=.)/,"").toUpperCase()}
function dwgUrl(it){var u=String(it.dwgUrl||"").trim();if(!u){var k=dwgKey(it.dwg);u=k&&DWG_LINKS[k]?DWG_LINKS[k].u:""}return/^(https?:\/\/|\/_blob\/)/i.test(u)?u:""}
var CFM_YES=null;
function askDel(title,detail,yes){
  $("cfm-t").textContent=title;$("cfm-p").textContent=detail||"";CFM_YES=yes;$("cfm").hidden=false;$("cfm-n").focus();setTimeout(function(){$("cfm-n").focus()},60);
}
function cfmClose(){$("cfm").hidden=true;CFM_YES=null}
function alarm(m){var a=$("alarm");a.textContent=m;a.hidden=false;clearTimeout(alarm.h);alarm.h=setTimeout(function(){a.hidden=true},2000)}
function openDwg(it){var u=it?dwgUrl(it):"";if(!u){alarm("Desenho não encontrado");return}
  var k=dwgKey(it.dwg),f=k&&DWG_LINKS[k],rq=revN(it.revReq||((String(it.dwg||"").match(/\sR:?\s*([0-9A-Za-z]+)\s*$/i)||[])[1]));
  if(!it.dwgUrl&&f&&rq&&revN(f.r)!==rq)alarm("Atenção: o arquivo é revisão R"+f.r+" e o pedido pede R"+rq);
  if(u.indexOf("/_blob/")===0){
    fetch(u).then(function(r){if(!r.ok)throw 0;return r.blob()}).then(function(b){
      var nm=(f&&f.n)||"desenho.pdf",pdf=new Blob([b],{type:"application/pdf"});
      if(DLC&&DLC.save){DLC.save({filename:nm,data:pdf}).then(function(){toast("Desenho salvo. Abra o arquivo baixado.")}).catch(function(){toast("Download cancelado.")})}
      else window.open(URL.createObjectURL(pdf),"_blank")
    }).catch(function(){alarm("Não consegui abrir o desenho")});return}
  window.open(u,"_blank","noopener")}
function dwgLinkHtml(it){var u=dwgUrl(it);
  return'<div style="display:flex;gap:6px;align-items:center">'+(u?'<a class="btn sm pri" id="dwg-open" href="'+esc(u)+'" target="_blank" rel="noopener">Abrir desenho</a>':'<span class="hint">Sem link ainda.</span>')+
  '<input id="f-dwgurl" data-f="dwgUrl" value="'+esc(it.dwgUrl||"")+'" placeholder="Cole o link do desenho (Drive)" style="flex:1;min-width:0"></div>'}
function dwgIndex(H){
  if(H._dw)return H._dw;
  var ix={},last={};
  for(var k in H.map){
    var e=H.map[k],m=String(e.desc||"").match(/DES\.?:?\s*:?\s*\.*([A-Za-z]{0,3}[0-9][0-9A-Za-z.\-\/]*[0-9])/i);
    if(!m)continue;
    var d=m[1].toUpperCase();
    if(!last[d]||e.lastMs>=last[d]){last[d]=e.lastMs;ix[d]=k}
  }
  try{Object.defineProperty(H,"_dw",{value:ix,enumerable:false,configurable:true})}catch(x){}
  return ix;
}
function revOf(d){var m=String(d||"").trim().match(/(?:^|[\s_\-])(?:REV(?:IS[ÃA]O)?\.?\s*:?\s*|R\s?)([A-Z]{1,2}|\d{1,2})\s*$/i);return m?m[1].toUpperCase():""}
function fillRev(it){if(it&&!String(it.revReq||"").trim()&&it.dwg){var r=revOf(it.dwg);if(r)it.revReq=r}return it}
function normRev(x){return String(x==null?"":x).trim().replace(/^0+(?=\d)/,"").toUpperCase()}
function matKeys(t){
  t=String(t||"").toUpperCase();var k={},m;
  var re=/\b(316L?|304L?|303|410|416|420|430B?|440C?|4340|4140|8620|1010|1020|1040|1045|12L14|11SMN3[07]|20MNCR5|D6|A516|A36|ALUM[ÍI]NIO|5052|6351|6061|BRONZE|TM[\s-]?23|TM[\s-]?360|LAT[ÃA]O|C360|FERRO FUNDIDO|NODULAR|NYLON|POLIACETAL|ACR[ÍI]LICO)\b/g;
  while((m=re.exec(t))){
    var x=m[1].replace(/[\s-]/g,"");
    if(/^316/.test(x))x="316";else if(/^304/.test(x))x="304";else if(/^430/.test(x))x="430";else if(/^440/.test(x))x="440";
    else if(/^TM/.test(x)||x==="BRONZE")x="BRONZE";else if(/^ALUM|^5052$|^6351$|^6061$/.test(x))x="ALUMINIO";else if(/^LAT|^C360$/.test(x))x="LATAO";else if(x==="1040")x="1020";else if(x==="12L14"||/^11SMN/.test(x)||x==="20MNCR5")x="4140";else if(x==="FERROFUNDIDO")x="NODULAR";
    k[x]=1;
  }
  return Object.keys(k);
}
function hinfo(it){
  var H=S.hist;if(!H||!it.cod)return null;
  var key=String(it.cod).trim().toUpperCase(),e=H.map[key],via="";
  if(!e&&it.dwg){
    var dk=dwgKey(it.dwg),ix=dwgIndex(H);
    if(dk&&ix[dk]){via=key;key=ix[dk];e=H.map[key]}
  }
  if(!e){
    var b=key.replace(/[A-Z]+$/,""),vs=[];
    for(var k in H.map){if(k!==key&&k.replace(/[A-Z]+$/,"")===b)vs.push(k)}
    return{none:true,variants:vs.slice(0,6)};
  }
  var P=S.P,all=e.ev.slice().sort(function(a,b){return a[0]-b[0]});
  var evs=all.filter(function(x){return x[7]!=="o"}),ops=all.filter(function(x){return x[7]==="o"});
  var oi=null;
  if(ops.length){
    var ol=ops[ops.length-1],wl=evs.length?evs[evs.length-1]:null;
    var pr={};ops.forEach(function(x){pr[x[1]]=1});
    oi={ev:ol,age:Math.max(0,Math.floor((today0()-ol[0])/MS)),n:ops.length,price:ol[1],
      newer:!wl||ol[0]>wl[0],diff:wl&&wl[1]>0?ol[1]/wl[1]-1:NaN,wonPrice:wl?wl[1]:NaN,prices:Object.keys(pr).length};
  }
  if(!evs.length)return{none:true,variants:[],open:oi,via:via,viaCod:key,desc:e.desc};
  var rr=normRev(it.revReq),same=null;
  if(rr)same=evs.filter(function(x){return normRev(x[5])===rr});
  var use=(same&&same.length)?same:evs,last=use[use.length-1];
  var revDiff=!!(rr&&!(same&&same.length));
  var future=last[0]>today0();
  var age=Math.max(0,Math.floor((today0()-last[0])/MS));
  var status=age<=P.hAt?"ok":(age<=P.hOld?"warn":"old");
  var run=[last];
  for(var i=use.length-2;i>=0;i--){if(Math.abs(use[i][1]-last[1])<0.005)run.unshift(use[i]);else break}
  var runMonths=monthsBetween(run[0][0],last[0]);
  var min=Infinity,max=0;use.forEach(function(x){if(x[1]<min)min=x[1];if(x[1]>max)max=x[1]});
  var kr=matKeys(it.matTxt||""),kh=matKeys(e.desc),matDiff=false;
  if(kr.length&&kh.length&&!kr.some(function(x){return kh.indexOf(x)>-1}))matDiff=true;
  return{none:false,open:oi,ops:ops,via:via,viaCod:key,e:e,evs:evs,last:last,price:last[1],age:age,future:future,status:status,n:use.length,min:min,max:max,
    runMonths:runMonths,runN:run.length,stale:run.length>=2&&runMonths>=P.hStale,revDiff:revDiff,revReq:rr,revHist:normRev(last[5]),
    matDiff:matDiff,kr:kr,kh:kh,desc:e.desc,tipo:(same&&same.length)?"rev":"all"};
}

/* ---------- cálculo ---------- */
function matPrice(i){var m=S.P.mat[i]||S.P.mat[0];return m.r}
function treat1(it,ti){
  var P=S.P,q=Math.max(1,n0(it.qtd)||1),tr=P.terc[ti];
  var R={pp:0,lot:0,kg:0,minV:0,minApplied:false,warn:""};
  if(!tr||!ti)return R;
  var kg=(n0(it.pa)||brutoTot(it))*q,N=Math.max(1,n0(it.corrida)||1);
  R.kg=kg;
  if(tr.mode==="lote"){
    R.minV=tr.r;R.lot=tr.r/N;
    if(N===1&&tr.capKg&&kg>tr.capKg)R.warn="O peso do lote ("+nf(kg,2)+" kg) passa de "+tr.capKg+" kg. A cobrança do TENOX acima disso ainda não foi confirmada.";
  }else{
    var base=kg*tr.r,minV=Math.max(tr.minR||0,(tr.minKg||0)*tr.r);
    R.minV=minV;
    var share=minV/N;
    R.lot=Math.max(base,share);
    R.minApplied=share>base;
  }
  R.pp=R.lot/q;
  return R;
}
function trList(it){return(it.trs||(it.terc?[it.terc]:[])).filter(function(i){return i>0})}
function treat(it){
  var A={pp:0,lot:0,kg:0,minV:0,minApplied:false,warn:""};
  trList(it).forEach(function(i){var R=treat1(it,i);A.pp+=R.pp;A.lot+=R.lot;A.kg=R.kg;
    if(R.minApplied&&!A.minApplied){A.minApplied=true;A.minV=R.minV}
    if(R.warn)A.warn+=(A.warn?" ":"")+R.warn});
  return A;
}
function MAR(){var m=parse(S.mar);return(S.mar!==""&&S.mar!=null&&isFinite(m)&&m>=0&&m<100)?m:S.P.mar}
function calc(it){
  var P=S.P,q=Math.max(1,n0(it.qtd)||1);
  var ind=it.tipo==='Industrialização';
  var mat1=ind?0:n0(it.pb)*matPrice(it.mat),matx=0,maq=0,hrs=0,mc=[],ppc=0;
  if(!ind)(it.ex||[]).forEach(function(x){matx+=n0(x.pb)*(n0(x.qp)||1)*matPrice(x.mat)});
  var mat=mat1+matx;
  for(var i=0;i<P.maq.length;i++){
    var t=(it.t&&it.t[i])||["",""],M=P.maq[i];
    if(M.pp){var qv=n0(t[1]);if(M.kg&&!String(t[1]||"").trim()&&it.ops&&it.ops.indexOf(i)>-1)qv=brutoTot(it);var vp=qv*M.r;mc.push(vp);maq+=vp;ppc+=vp;continue}
    var s=M.ext?0:n0(t[0])/60,c=n0(t[1])/60,h=s/q+c;
    hrs+=h;var v=h*M.r;mc.push(v);maq+=v;
  }
  var tr=treat(it),terc=tr.pp,outros=it.os?it.os.reduce(function(a,x){return a+n0(x.v)},0):n0(it.outros);
  var custo=mat+maq+terc+outros;
  var den=1-P.imp/100-MAR()/100;
  var sugRaw=den>0?custo/den:NaN;
  var calcOk=hrs>0||ppc>0||terc>0||outros>0;
  var sug=calcOk?Math.round(sugRaw):NaN;
  var hi=hinfo(it),hp=(hi&&!hi.none)?hi.price:NaN;
  var fin=parse(it.preco),custom=!isNaN(fin)&&fin>0;
  var modo=it.modo||"auto",src,preco;
  if(custom){src="manual";preco=fin}
  else if(modo==="calc"){src="calc";preco=sug}
  else if(isFinite(hp)){src="hist";preco=hp}
  else if(hi&&hi.none&&hi.open&&hi.open.price>0){src="open";preco=hi.open.price}
  else{src="calc";preco=sug}
  var ok=isFinite(preco)&&preco>0;
  var eff=(ok&&calcOk)?1-P.imp/100-custo/preco:NaN;
  var ref=parse(it.ref);
  return{q:q,mat:mat,mat1:mat1,matx:matx,maq:maq,mc:mc,terc:terc,tr:tr,outros:outros,custo:custo,sug:sug,sugRaw:sugRaw,hrs:hrs,calcOk:calcOk,ok:ok,
    preco:preco,src:src,custom:custom,hp:hp,hi:hi,eff:eff,imposto:ok?preco*P.imp/100:NaN,ref:isNaN(ref)?NaN:ref,total:ok?preco*q:NaN}
}
function tone(eff){if(!isFinite(eff))return"none";if(eff>=S.P.alerta/100)return"good";if(eff>=0)return"warn";return"bad"}
function cur(){return S.items[S.sel]||null}
function srcLabel(s){return s==="open"?"última cotação, não fechou":s==="hist"?"última venda":s==="calc"?"calculado":"digitado"}

/* ---------- leitura de pedido do cliente ---------- */
function normTxt(s){return String(s==null?"":s).toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g,"").trim()}
function parsePedido(rows){
  var hi=-1,cols={};
  for(var i=0;i<Math.min(rows.length,40);i++){
    var r=rows[i]||[],nm=r.map(normTxt);
    if(nm.indexOf("ordem")>-1&&nm.indexOf("codigo")>-1){
      hi=i;
      nm.forEach(function(x,j){
        if(x==="ordem")cols.ordem=j;else if(x==="codigo")cols.cod=j;else if(x.indexOf("unid")===0)cols.un=j;
        else if(x==="entrega")cols.ent=j;else if(x.indexOf("qtd")===0)cols.qtd=j;else if(x.indexOf("descri")===0)cols.desc=j;
      });
      break;
    }
  }
  if(hi<0)return null;
  var cli="";
  for(var a=0;a<Math.min(hi,6)&&!cli;a++){
    (rows[a]||[]).forEach(function(c){if(!cli&&c!=null&&String(c).trim()&&!/^rela[cç][aã]o/i.test(String(c).trim()))cli=String(c).trim()});
  }
  var items=[];
  for(var k=hi+1;k<rows.length;k++){
    var r2=rows[k]||[],cod=r2[cols.cod];
    if(cod==null||!/^\d{2}\.\d{2}\.\d{2,3}/.test(String(cod).trim()))continue;
    items.push({ordem:r2[cols.ordem]==null?"":String(r2[cols.ordem]).trim(),cod:String(cod).trim().toUpperCase(),
      ent:toDay(r2[cols.ent]),qtd:num(r2[cols.qtd]),desc:String(r2[cols.desc]==null?"":r2[cols.desc])});
  }
  return{cli:cli,items:items};
}
function cleanReq(t){return String(t).replace(/\r/g,"").split("\n").map(function(l){return l.replace(/[ \t]{2,}/g," ").trim()}).filter(Boolean).join("\n")}
function reqFields(desc){
  var lines=cleanReq(desc).split("\n"),first=lines[0]||"";
  var name=first.split(/\s+DES/i)[0].replace(/\s+/g," ").trim()||first;
  var mm=cleanReq(desc).match(/DES(?:ENHO)?\.?:?\s*([0-9][0-9.]*[0-9])([A-Za-z](?![A-Za-z]))?\s*(?:REV(?:IS[ÃA]O)?\.?\s*:?\s*([0-9]+))?/i);
  var dwg="",rev="";
  if(mm){dwg=mm[1]+(mm[2]||"");rev=mm[3]||""}
  var matTxt="";
  for(var i=0;i<lines.length;i++){
    var l=lines[i];
    if(/^OP\b/i.test(l))break;
    if(/^USO/i.test(l))continue;
    if(/(AISI|ASTM|SAE|INOX|BRONZE|LAT[ÃA]O|ALUM|FERRO FUNDIDO)/i.test(l)&&(i>0||/MAT/i.test(l))){matTxt=l.replace(/^MAT(ERIAL)?\s*:\s*/i,"");break}
  }
  if(!matTxt&&/(AISI|ASTM|INOX|BRONZE|LAT[ÃA]O|ALUM)/i.test(first))matTxt=first;
  var keep=[];
  lines.forEach(function(l,i){
    if(i===0)return;
    if(/^OP\b/i.test(l)||/^Total\s*:/i.test(l))return;
    if(/^\d[\d.]*\s+\d+(\s+\d+)?(\s+\d)/.test(l))return;
    if(/^REV\.?\s*\d+\s*(\d\d\/\d\d\/\d\d|CONF)/i.test(l)||/^REV\.?\s*\d+\s+CONF/i.test(l))return;
    keep.push(l);
  });
  return{name:name,dwg:dwg,rev:rev,matTxt:matTxt,nota:keep.join(" · ").slice(0,320),req:cleanReq(desc).slice(0,1500)};
}
function matIndexFrom(keys){
  var P=S.P;function idx(re){for(var i=0;i<P.mat.length;i++){if(re.test(P.mat[i].n+" "+P.mat[i].f))return i}return -1}
  var k=keys||[],r=-1;
  for(var i=0;i<k.length&&r<0;i++){
    var x=k[i];
    if(x==="316")r=idx(/Inox 316/);else if(x==="304")r=idx(/Inox 304/);
    else if(x==="410"||x==="420"||x==="416")r=idx(/410/);
    else if(x==="4340"||x==="4140"||x==="8620")r=idx(/4140/);
    else if(x==="1010"||x==="1020"||x==="1045")r=idx(/1010/);
    else if(x==="A516"||x==="A36")r=idx(/Chapa/);
    else if(x==="NODULAR")r=idx(/nodular/i);else if(x==="D6")r=idx(/D6/);else if(x==="NYLON")r=idx(/Nylon/);else if(x==="POLIACETAL")r=idx(/Poliacetal/);else if(/^ACR/.test(x))r=idx(/Acr.lico/);
    else if(x==="ALUMINIO")r=idx(/Alum.nio em geral/);else if(x==="BRONZE")r=idx(/Bronze/);else if(x==="LATAO")r=idx(/Lat/);
  }
  return r<0?0:r;
}
function histName(d){return String(d||"").split(/\s*-\s*DES/i)[0].replace(/\s+/g," ").trim()}
function histDwg(d){var m=String(d||"").match(/DES\.?:?\s*:?\s*\.*([0-9][0-9.]*[0-9])\s*[_ ]?\s*R:?\s*([0-9A-Za-z]+)/i);return m?m[1]+" R"+m[2]:""}
function itemFromReq(r){
  if(r.name!==undefined)return itemFromPaste(r);
  var it=blankItem(),f=reqFields(r.desc);
  it.cod=r.cod;it.ordem=r.ordem;it.qtd=String(isFinite(r.qtd)?r.qtd:1);
  it.entTxt=isFinite(r.ent)?fmtD(r.ent):"";
  it.desc=f.name;it.dwg=f.dwg?f.dwg+(f.rev?" R"+f.rev:""):"";it.revReq=f.rev;it.matTxt=f.matTxt;it.req=f.req;it.nota=f.nota;
  var hi=hinfo(it);
  var keys=matKeys(f.matTxt);
  if(!keys.length&&hi&&!hi.none)keys=hi.kh;
  it.mat=matIndexFrom(keys);
  return it;
}
/* tabela de solicitação (corpo do e-mail, CSV ou texto colado): SC, Produto, Descrição, Quantidade */
var COD_RE=/\b(\d{2}\.\d{2}\.\d{2}\.\d{6,10}|\d{4}-\d{5}[A-Za-z]?|\d{2}\.\d{2}\.\d{2,3}[A-Za-z]?)\b/;
function splitDesc(s){
  s=String(s==null?"":s).replace(/\s+/g," ").trim();
  var m=s.match(/^([0-9][0-9.\-\/A-Za-z]*[0-9])\s*[-–:]?\s*(.*)$/);
  if(m&&m[1].length>=6)return{dwg:m[1],name:m[2]||""};
  var m2=s.match(/\b([A-Za-z]{1,3}\d{5,8})\b/);
  if(m2)return{dwg:m2[1].toUpperCase(),name:s};
  return{dwg:"",name:s};
}
function parseTabela(rows){
  var hi=-1,cols={};
  for(var i=0;i<Math.min(rows.length,40);i++){
    var nm=(rows[i]||[]).map(normTxt);
    var hp=nm.some(function(x){return /^(produto|codigo|cod\b)/.test(x)}),hq=nm.some(function(x){return /^(quant|qtd|qtde)/.test(x)});
    if(hp&&hq){
      hi=i;
      nm.forEach(function(x,j){
        if(cols.sc==null&&(/\bsc\b/.test(x)||/^(numero|n[o°º]?\b)/.test(x)||x==="ordem"))cols.sc=j;
        else if(cols.prod==null&&/^(produto|codigo|cod\b)/.test(x))cols.prod=j;
        else if(cols.desc==null&&/^descri/.test(x))cols.desc=j;
        else if(cols.qtd==null&&/^(quant|qtd|qtde)/.test(x))cols.qtd=j;
        else if(cols.ent==null&&/(prazo|entrega)/.test(x))cols.ent=j;
      });
      break;
    }
  }
  var items=[];
  for(var k=hi+1;k<rows.length;k++){
    var r=rows[k]||[],cells=r.map(function(c){return c==null?"":String(c).trim()});
    var pj=cols.prod!=null&&COD_RE.test(cells[cols.prod]||"")?cols.prod:-1;
    var loose=false;
    if(pj<0&&cols.prod!=null&&/^[A-Za-z0-9][A-Za-z0-9.\-\/_]{3,30}$/.test(cells[cols.prod]||"")&&/\d/.test(cells[cols.prod])){pj=cols.prod;loose=true}
    if(pj<0){for(var j=0;j<cells.length;j++){if(COD_RE.test(cells[j])){pj=j;break}}}
    if(pj<0)continue;
    var cod=loose?cells[pj].toUpperCase():cells[pj].match(COD_RE)[1].toUpperCase();
    var q=NaN,dsc="",sc="";
    if(cols.qtd!=null)q=parse(cells[cols.qtd]);
    if(!isFinite(q)){for(var z=cells.length-1;z>pj;z--){var v=parse(cells[z]);if(isFinite(v)&&/^[\d.,]+$/.test(cells[z])){q=v;break}}}
    if(cols.desc!=null)dsc=cells[cols.desc];
    else{for(var y=0;y<cells.length;y++){if(y!==pj&&cells[y].length>dsc.length&&!/^[\d.,]+$/.test(cells[y]))dsc=cells[y]}}
    if(cols.sc!=null)sc=cells[cols.sc];else if(pj>0&&/^\d+$/.test(cells[0]))sc=cells[0];
    var sd=splitDesc(dsc);
    items.push({ordem:sc,cod:cod,qtd:isFinite(q)&&q>0?q:1,ent:cols.ent!=null?toDay(cells[cols.ent]):NaN,name:sd.name,dwg:sd.dwg,desc:""});
  }
  return{cli:"",items:items,tabela:true};
}
function parsePaste(txt){
  var out=[],lines=String(txt).replace(/\r/g,"").split("\n"),tab=[];
  lines.forEach(function(l){
    if(!l.trim())return;
    var cells=l.indexOf("\t")>-1?l.split("\t"):l.split(/\s{3,}/);
    if(cells.length>=3)tab.push(cells);
  });
  if(tab.length){
    var p=parseTabela(tab);
    if(p.items.length)return p.items;
  }
  lines.forEach(function(l){
    var m=l.match(/(\d{2}\.\d{2}\.\d{2}\.\d{6,10}|\d{4}-\d{5}[A-Za-z]?|\d{2}\.\d{2}\.\d{2,3}[A-Za-z]?)\D{0,40}?(\d+)/);
    if(m)out.push({cod:m[1].toUpperCase(),qtd:+m[2]});
  });
  return out;
}
function itemFromPaste(r){
  var it=blankItem();it.cod=r.cod;it.qtd=String(r.qtd);
  if(r.ordem)it.ordem=r.ordem;
  if(r.dwg)it.dwg=r.dwg;
  if(r.rev)it.revReq=String(r.rev);else fillRev(it);
  if(isFinite(r.ent))it.entTxt=fmtD(r.ent);
  var hi=hinfo(it);
  if(hi&&!hi.none){it.desc=histName(hi.desc);if(!it.dwg)it.dwg=histDwg(hi.desc);it.mat=matIndexFrom(hi.kh)}
  if(r.name)it.desc=r.name;
  return it;
}

/* ---------- carga de arquivos ---------- */
/* CSV: decodifica UTF-8 ou Windows-1252, detecta o separador e respeita aspas */
function decodeText(buf){
  var u=new Uint8Array(buf);
  try{return new TextDecoder("utf-8",{fatal:true}).decode(u).replace(/^﻿/,"")}
  catch(e){return new TextDecoder("windows-1252").decode(u)}
}
function parseCSV(text){
  var lineMode=/follow up de vendas/i.test(text.slice(0,600));
  var first=text.split(/\r?\n/)[0]||"",cnt={";":0,",":0,"\t":0},q=false;
  for(var i=0;i<first.length;i++){var ch=first[i];if(ch==='"')q=!q;else if(!q&&cnt[ch]!=null)cnt[ch]++}
  var d=";";if(cnt[","]>cnt[d])d=",";if(cnt["\t"]>cnt[d])d="\t";
  var rows=[],row=[],cell="",inq=false,had=false;
  for(var p=0;p<text.length;p++){
    var c=text[p];
    if(inq&&lineMode&&(c==="\n"||c==="\r")){
      inq=false;
      if(c==="\r"&&text[p+1]==="\n")p++;
      row.push(cell);cell="";
      if(row.some(function(x){return String(x).trim()!==""}))rows.push(row);
      row=[];
    }else if(inq){
      if(c==='"'){if(text[p+1]==='"'){cell+='"';p++}else inq=false}
      else cell+=c;
    }else if(c==='"'){inq=true;had=true}
    else if(c===d){row.push(cell);cell=""}
    else if(c==="\n"||c==="\r"){
      if(c==="\r"&&text[p+1]==="\n")p++;
      row.push(cell);cell="";
      if(row.some(function(x){return String(x).trim()!==""}))rows.push(row);
      row=[];
    }else cell+=c;
  }
  if(cell!==""||row.length){row.push(cell);if(row.some(function(x){return String(x).trim()!==""}))rows.push(row)}
  return rows;
}
/* relatório Caprind "Follow up de Vendas (Detalhado)": cada linha traz o cabeçalho repetido, depois os dados */
var SEM_DATA=new Date(2010,0,1).getTime();
function detSplit(r){
  var cells=r.map(function(c){return c==null?"":String(c).trim()}),ci=-1,ce=-1;
  for(var i=0;i<cells.length;i++){
    if(ci<0&&/^c[óo]d\. interno/i.test(cells[i]))ci=i;
    if(/^dt\. cancel/i.test(cells[i])){ce=i;break}
  }
  if(ci<0||ce<0)return null;
  var H=cells.slice(ci,ce+1).map(normTxt),D=r.slice(ce+1).map(function(c){return c==null?"":String(c).trim()});
  function col(re){for(var j=0;j<H.length;j++){if(re.test(H[j]))return j}return -1}
  var prop="",sec="";
  for(var m=0;m<ci;m++){
    var mm=cells[m].match(/^Proposta\/pedido:\s*(.+)$/i);if(mm)prop=mm[1].trim();
    if(/^Grupo do cliente/i.test(cells[m])&&m>0)sec=cells[m-1].split(/\s+/)[0].toUpperCase();
  }
  return{D:D,col:col,prop:prop,sec:sec};
}
function propKey(p){var m=String(p).match(/^(\d+)\s*\/\s*(\d{2})/);return m?{n:+m[1],y:+m[2]}:null}
function parseFaturadasDet(rows){
  var map={},lines=0,semData=0,estim=0,first=Infinity,last=0;
  var sp=rows.map(detSplit);
  /* proposta sem data (01/01/00): estima pela numeração, que é sequencial dentro do ano */
  var known={};
  sp.forEach(function(x){
    if(!x)return;
    var d=toDay(x.D[x.col(/^dt\. venda/)]),k=propKey(x.prop);
    if(k&&!isNaN(d)&&d>=SEM_DATA){var yk=k.y;(known[yk]||(known[yk]={}))[k.n]=d}
  });
  var sorted={};for(var y in known)sorted[y]=Object.keys(known[y]).map(Number).sort(function(a,b){return a-b});
  function guess(prop){
    var k=propKey(prop);if(!k||!sorted[k.y])return NaN;
    var arr=sorted[k.y],best=null;
    for(var i=0;i<arr.length;i++){if(arr[i]<=k.n)best=arr[i];else break}
    if(best==null)best=arr[0];
    return known[k.y][best];
  }
  sp.forEach(function(x){
    if(!x)return;
    var D=x.D,col=x.col;
    var cUn=col(/^valor unitario/),cQt=col(/^qtde\.$/),cFa=col(/^qtde\. faturada/),cDt=col(/^dt\. faturam/),cSt=col(/^status/);
    if(cUn<0||cQt<0||cDt<0||!D[0])return;
    var stt=(D[cSt]||"").toUpperCase();
    if(/CANCEL|REVISADA/.test(stt))return;
    var cls=/^ABERTA/.test(stt)?"o":"w",est=0;
    var ms=cls==="w"?toDay(D[cDt]):NaN,usedF=!isNaN(ms)&&ms>=SEM_DATA;
    if(isNaN(ms)||ms<SEM_DATA)ms=toDay(D[col(/^dt\. venda/)]);
    if(isNaN(ms)||ms<SEM_DATA){ms=guess(x.prop);est=1}
    if(isNaN(ms)){semData++;return}
    if(est)estim++;
    var u=parse(D[cUn]),q=parse(D[cFa]);
    if(!(q>0))q=parse(D[cQt]);
    if(!isFinite(u)||!isFinite(q))return;
    var desc="";
    for(var k=D.length-1;k>=0;k--){if(/^descri[çc][ãa]o\s*:/i.test(D[k])){desc=D[k].replace(/^descri[çc][ãa]o\s*:\s*/i,"");break}}
    var cp=D[0].split(/\s+-\s+/),c0=cp[0].trim().toUpperCase(),rev=cp.slice(1).join("-").trim();
    var e=map[c0]||(map[c0]={ev:[],desc:"",lastMs:0});
    e.ev.push([ms,u,q,x.prop,x.sec,rev,(cls==="w"&&usedF)?1:2,cls,est]);
    if(ms>=e.lastMs){e.lastMs=ms;e.desc=desc}
    lines++;if(ms<first)first=ms;if(ms>last)last=ms;
  });
  return{map:map,lines:lines,semData:semData,estim:estim,codes:Object.keys(map).length,first:first,last:last};
}
function mergeHist(old,h,name){
  var map=old&&old.map?old.map:{};
  for(var k in h.map)map[k]=h.map[k];
  var codes=Object.keys(map).length,lines=0,first=Infinity,last=0;
  for(var c in map){map[c].ev.forEach(function(x){lines++;if(x[0]<first)first=x[0];if(x[0]>last)last=x[0]})}
  var fn=old&&old.meta&&old.meta.file&&old.meta.file!==name?(old.meta.file.indexOf(name)>-1?old.meta.file:old.meta.file+" + "+name):name;
  return{meta:{file:fn,at:Date.now(),lines:lines,codes:codes,first:first,last:last},map:map};
}
function classify(name,rows){
  var head=rows.slice(0,16).map(function(x){return x.map(function(c){return c==null?"":String(c)}).join(" ")}).join(" ").toLowerCase();
  if(/follow up de vendas|faturadas/.test(head)){
    var det=/\(detalhado\)|dt\. faturam/.test(head);
    var h=det?parseFaturadasDet(rows):parseFaturadas(rows);
    if(!h.lines)return{name:name,err:"Reconheci o relatório de faturadas"+(det?" (Detalhado)":"")+", mas não achei linhas de item faturadas."};
    return{name:name,kind:"hist",data:h};
  }
  var p=parsePedido(rows);
  if(p&&p.items.length)return{name:name,kind:"pedido",data:p};
  var t=parseTabela(rows);
  if(t.items.length)return{name:name,kind:"pedido",data:t};
  return{name:name,err:"Formato não reconhecido. Esperado: relatório de faturadas do Caprind, “Relação para Cotação” ou uma tabela com as colunas Produto, Descrição e Quantidade."};
}
function readFile(f){
  return new Promise(function(res){
    var isCsv=/\.(csv|txt|tsv)$/i.test(f.name);
    if(!isCsv&&typeof XLSX==="undefined"){res({name:f.name,err:"A biblioteca de leitura de planilhas não carregou. Verifique a conexão com a internet e recarregue a página."});return}
    var r=new FileReader();
    r.onerror=function(){res({name:f.name,err:"Não consegui abrir o arquivo."})};
    r.onload=function(){
      try{
        var rows;
        if(isCsv)rows=parseCSV(decodeText(r.result));
        else{
          var wb=XLSX.read(new Uint8Array(r.result),{type:"array",cellDates:true});
          var ws=wb.Sheets[wb.SheetNames[0]];
          rows=XLSX.utils.sheet_to_json(ws,{header:1,raw:true,defval:null,blankrows:false});
        }
        res(classify(f.name,rows));
      }catch(e){res({name:f.name,err:"Erro ao ler o arquivo: "+e.message})}
    };
    r.readAsArrayBuffer(f);
  });
}
function hasWork(){return S.items.some(function(it){return it.desc||it.cod||(it.t&&it.t.some(function(p){return p[0]||p[1]}))})}
var pending=null,pendingInbox=null;
function handleFiles(list){
  var files=[].slice.call(list);if(!files.length)return;
  Promise.all(files.map(readFile)).then(function(rs){
    var msgs=[];
    rs.forEach(function(x){if(x.err)msgs.push(x.name+": "+x.err)});
    rs.forEach(function(x){
      if(x.kind==="hist"){
        S.hist=mergeHist(S.hist,x.data,x.name);
        saveHist();
        msgs.push("Histórico carregado: "+nf(x.data.codes,0)+" códigos e "+nf(x.data.lines,0)+" linhas. Total no sistema: "+nf(S.hist.meta.codes,0)+" códigos."+(x.data.estim?" "+nf(x.data.estim,0)+" linhas sem data tiveram a data estimada pelo número da proposta.":"")+(x.data.semData?" "+nf(x.data.semData,0)+" ficaram de fora por falta de data.":""));
      }
    });
    rs.forEach(function(x){
      if(x.kind==="pedido"){
        if(S.sample||!hasWork()){applyPedido(x.data,"replace");if(!S.sol&&x.name){S.sol="Arquivo "+String(x.name).replace(/\.[a-z0-9]+$/i,"");fullRender()}msgs.push("Pedido carregado: "+x.data.items.length+" itens.")}
        else{pending=x.data;showAsk()}
      }
    });
    renderStatus();renderParamsIfOpen();refreshAll();
    if(msgs.length)toast(msgs.join(" "));
  });
}
function applyPedido(p,mode){
  if(mode!=="add")pStart();
  if(S.sample){S.prop="";S.cli="";S.cond="28 DDL"}
  var items=p.items.map(itemFromReq);
  if(mode==="add")S.items=S.items.filter(function(it){return it.desc||it.cod}).concat(items);else S.items=items;
  S.sel=mode==="add"?Math.max(0,S.items.length-items.length):0;
  S.sample=false;
  if(p.cli&&(mode==="replace"||!S.cli))S.cli=p.cli;
  if(p.tabela&&!p.cli&&!S.cli&&p.items.length&&p.items.every(function(x){return /^\d{4}-\d{5}/.test(x.cod)}))S.cli="MULTIPACK";
  if(p.tabela&&!p.cli&&!S.cli&&p.items.length&&p.items.every(function(x){return /^\d{2}\.\d{2}\.\d{2}\.\d{6,10}/.test(x.cod)}))S.cli="EQUIP NEXT";
  autoCond(true);
  fullRender();
}
function showAsk(){
  var b=$("askbox");b.hidden=false;
  b.innerHTML='<span>Já existem itens na mesa. O que fazer com os '+pending.items.length+' itens do pedido?</span>'+
    '<button class="btn sm pri" data-ask="replace" type="button">Substituir os itens atuais</button>'+
    '<button class="btn sm" data-ask="add" type="button">Adicionar aos atuais</button>'+
    '<button class="btn sm" data-ask="no" type="button">Cancelar</button>';
}
function renderStatus(){
  var H=S.hist,el=$("hist-status");
  if(!H){el.textContent=PR.db?"Histórico de preços: carregando do banco do sistema…":"Histórico de preços: não disponível neste momento.";return}
  var m=H.meta;
  el.textContent="Histórico de preços: "+nf(m.codes,0)+" códigos e "+nf(m.lines,0)+" linhas ("+m.file+"), de "+fmtD(m.first)+" a "+fmtD(m.last)+". Atualizado em "+fmtD(m.at)+".";
}

/* ---------- resumo ---------- */
function renderSummary(){
  var cust=0,rec=0,mrec=0,done=0,nOld=0,nWarn=0,nNew=0,nRev=0,nMat=0;
  S.items.forEach(function(it){
    var c=calc(it);
    if(c.ok){done++;rec+=c.total}
    if(c.ok&&c.calcOk){cust+=c.custo*c.q;mrec+=c.preco*c.q}
    var hi=c.hi;
    if(hi&&!hi.none){if(hi.status==="old")nOld++;else if(hi.status==="warn")nWarn++;if(hi.revDiff)nRev++;if(hi.matDiff)nMat++}
    else if(it.cod)nNew++;
  });
  var eff=mrec>0?1-S.P.imp/100-cust/mrec:NaN;
  var att=[];
  if(nOld)att.push(nOld+(nOld===1?" preço antigo":" preços antigos"));
  if(nWarn)att.push(nWarn+" com atenção");
  if(nNew)att.push(nNew+(nNew===1?" código novo":" códigos novos"));
  if(nRev)att.push(nRev+(nRev===1?" revisão mudou":" revisões mudaram"));
  if(nMat)att.push(nMat+" com material diferente");
  var cells=[["Itens",S.items.length+(done<S.items.length?" ("+(S.items.length-done)+" sem preço)":"")],
    ["Total a cotar",brl(rec)],["Custo (itens com tempo)",mrec>0?brl(cust):"–"],["Margem (itens com tempo)",pct(eff)]];
  var h=cells.map(function(c){return'<div><span class="k">'+c[0]+'</span><span class="v">'+c[1]+'</span></div>'}).join("");
  h+='<div><span class="k">Atenção</span><span class="v t">'+(att.length?esc(att.join(" · ")):(S.hist?"tudo recente":"–"))+'</span></div>';
  $("summary").innerHTML="";
  S._ft={n:S.items.length,sem:S.items.length-done,tot:rec,att:att,old:nOld,warn:nWarn,nw:nNew,rev:nRev};renderFoot();
}
function renderFoot(){
  var f=$("ifoot");if(!f||!S._ft)return;var it=cur(),c=it?calc(it):null,T=S._ft;
  var b=function(l,v,x){return'<div class="fi'+(x||"")+'"><span>'+l+'</span><b>'+v+'</b></div>'};
  var h=b("Itens",T.n+(T.sem?" · "+T.sem+" sem preço":""));
  if(it)h+=b("Item "+(S.sel+1)+" · unitário",c.ok?brl(c.preco):"–")+b("Total do item",c.ok?brl(c.total):"–")+(c.ok&&isFinite(c.eff)?b("Margem",pct(c.eff)):"");
  h+='<div class="fi-sp"></div>'+(T.old||T.warn||T.nw||T.rev?'<span class="fi-att fi-dots">'+(T.old?'<span title="Preço antigo"><i class="dot bad"></i>'+T.old+'</span>':"")+(T.warn?'<span title="Atenção"><i class="dot warn"></i>'+T.warn+'</span>':"")+(T.nw?'<span title="Código novo"><i class="dot new"></i>'+T.nw+'</span>':"")+(T.rev?'<span title="Revisão mudou"><i class="dot quo"></i>'+T.rev+'</span>':"")+'</span>':"")+b("Valor total",brl(T.tot)," big");
  f.innerHTML=h;
}

/* ---------- lista ---------- */
var MATRE=/\b(SAE\s*\d{3,5}[A-Z]?|AISI\s*\d{3}[A-Z]?|ASTM\s*[A-Z]?\s*-?\s*\d+[A-Z]?(?:\s*(?:GR\.?|TP\.?|TIPO)\s*[0-9A-Z]+)?|AL[UÚ]M[IÍ]NIO\s*\d{4}(?:-?[A-Z0-9]+)?|AL\s*\d{4}(?:-?T\d)?|A[ÇC]O\s*CF-?\d+|INOX\s*\d{3}|LAT[ÃA]O(?:\s*TM-?\d+)?|BRONZE(?:\s*[A-Z0-9]+)?|GGG\s*\d+|TM-?\s*\d{2,3}|WCB|CA15)\b/i;
var STD_MK=/\s*[-–]?\s*\b(DESENHO|DES\.|DES\b|REVIS[AÃ]O|REV\.?\s*:|REV\b|MAT\.?\s*:|MATERIAL\b|USO\b|ORIGEM\b|SUBST|APLICA)/i;
function stdDesc(it){
  var raw=String(it.desc||"").replace(/\s+/g," ").trim();if(!raw)return raw;
  var T=raw+" "+String(it.matTxt||"");
  var m=raw.search(STD_MK);
  if(m===0)return raw;
  var cut=m>0?m:raw.length,mm;
  mm=raw.search(/\s+·\s+/);if(mm>0&&mm<cut)cut=mm;
  mm=raw.search(/\s*\(\s*(?:peso|\d[\d,.]*\s*kg)/i);if(mm>0&&mm<cut)cut=mm;
  var dashRe=/\s+[-–—]\s+/g,dmx;
  while((dmx=dashRe.exec(raw))){
    if(dmx.index>=cut)break;
    var rest=raw.slice(dmx.index+dmx[0].length);
    if(MATRE.test(rest)||/\b(peso|HRC|zincad|bicromat|anodiz|pintad|oxida|t[eê]mpera|conjunto|tenox|retific|fosfat|trefil|soldad|niquel|níquel|galvaniz)/i.test(rest.slice(0,60))||/^[a-zçãõáéíóú]/.test(rest)){cut=dmx.index;break}
  }
  var name=raw.slice(0,cut).replace(/[\s(\[\-–:,.]+$/,"").trim();
  if(!name)return raw;
  var dwg="",rev=String(it.revReq||"").replace(/^R/i,"").trim();
  var d=String(it.dwg||"").trim(),dm=d.match(/^(.*?)\s*R:?\s*([0-9A-Za-z]+)\s*$/i);
  if(dm&&dm[1]){dwg=dm[1].trim();if(!rev)rev=dm[2]}else dwg=d;
  if(!dwg){var x=raw.match(/(?:DESENHO|DES\.?)\s*:?\s*([0-9][0-9.\/]*[0-9A-Za-z])/i);if(x)dwg=x[1]}
  if(!rev){var y=raw.match(/(?:REVIS[AÃ]O|REV\.?)\s*:?\s*([0-9]+[A-Za-z]?)/i)||raw.match(/\bR\s*:?\s*([0-9]{1,2})\b/);if(y)rev=y[1]}
  if(/^\d$/.test(rev))rev="0"+rev;
  var mat=String(it.matTxt||"").trim();
  if(!mat){var z=raw.match(/MAT(?:ERIAL)?\.?\s*:?\s*(.+)$/i);if(z)mat=z[1];else{var w=raw.match(/\b(AISI\s*\d+\w*|SAE\s*\d+\w*|ASTM\s*[A-Z]?-?\d+[^,]*|INOX\s*\d+\w*|BRONZE[^,]*|LAT[ÃA]O[^,]*|ALUM[IÍ]NIO[^,]*)/i);if(w)mat=w[1]}}
  mat=mat.replace(/^MAT(ERIAL)?\.?\s*:?\s*/i,"").split(/\s*,\s*|\s+-\s+|\s+(?:USO|ORIGEM|APLICA)/i)[0].trim();
  (function(){var mx=(String(it.matTxt||"")+" "+raw).match(MATRE);if(mx)mat=mx[1].replace(/\s+/g," ").toUpperCase();else if(/peso|\(|·/i.test(mat)||mat.length>28)mat=""})();
  if(mat&&name.toUpperCase().slice(-mat.length)===mat.toUpperCase()&&name.length>mat.length+3)name=name.slice(0,-mat.length).replace(/[\s\-–:,.]+$/,"");
  if(!dwg&&!mat)return raw;
  return name+(dwg?" - DES.:"+dwg+(rev?" REV:"+rev:""):"")+(mat?" - "+mat:"");
}
function pdfDesc(it){
  var d=stdDesc(it)||String(it.desc||"");
  return d.replace(/\s+R:([0-9A-Za-z]+)(?= - |$)/,function(m,a){return" REV:"+(/^\d$/.test(a)?"0"+a:a)}).replace(/\s+/g," ").trim();
}
function isCanon(d){d=String(d||"");return/^[^()·]+ - DES\.:\S+(?: REV:\w+)?(?: - [^,()·]+)?$/.test(d)&&!/ - .* - .* - /.test(d)&&d.length<110}
function applyStd(){
  var n=0;
  S.items.forEach(function(it){
    if(it.stdChk&&isCanon(it.desc))return;it.stdChk=true;
    var d=stdDesc(it);if(d&&d!==it.desc){it.desc=d;n++}
    if(!it.revReq){var r=String(d).match(/ (?:REV|R):([0-9A-Za-z]+)$|(?:REV|R):([0-9A-Za-z]+)(?= - )/);if(r)it.revReq=r[1]||r[2]}
  });
  return n;
}
function isVV(it){var t=[it.req,it.desc,it.nota,it.matTxt].join(" ");return/\bVAI\b[\s\S]{0,200}\bVOLTA\b|\bIDA\s+E\s+VOLTA\b|\bVAI\s*[\/&-]\s*VOLTA\b/i.test(t)}
function applyVV(){
  if(!/gascat/i.test(S.cli||""))return;
  S.items.forEach(function(it){
    if(it.vvChk)return;it.vvChk=true;
    if(isVV(it)){it.vv=true;if(it.tipo!=="Industrialização")it.tipo="Industrialização"}
  });
}
function renderList(){
  applyVV();if(applyStd())S.stdN=1;
  var l=$("list");
  if(!S.items.length){l.innerHTML='<div class="empty">Nenhum item ainda. Clique em “Novo item” ou carregue um pedido.</div>';return}
  var keepTop=l.scrollTop;
  l.innerHTML=S.items.map(function(it,i){
    var c=calc(it),hi=c.hi,st="",pc="none",pt="",sub=[];
    if(hi&&!hi.none){
      st=hi.status;pc=st==="ok"?"good":st==="warn"?"warn":"bad";pt=hi.future?"prazo "+fmtD(hi.last[0]).slice(0,5):ageLabel(hi.age);
      if(hi.stale)sub.push("preço parado");
      if(hi.revDiff)sub.push("revisão mudou");
      if(hi.matDiff)sub.push("material?");
    }else if(c.calcOk){pc=tone(c.eff);pt=pct(c.eff);st=it.cod?"new":""}
    else if(hi&&hi.none&&hi.open){st="quoted";pc="none";pt="cotado, não fechou";sub.push("sem venda")}
    else{st=it.cod?"new":"";pc=it.cod?"new":"none";pt=it.cod?"código novo":"sem preço"}
    if(it.vv)sub.push("vai e volta");
    var line=(it.cod?it.cod+" · ":"")+c.q+" un"+(sub.length?" · "+sub.join(" · "):"");
    var pz=String(it.prazo||"").trim();
    return'<button type="button" class="row" data-i="'+i+'" data-st="'+st+'"'+(i===S.sel?' aria-current="true"':"")+(it.vv?' data-vv="1"':"")+'>'+
      '<span class="n">'+(i+1)+'</span>'+
      '<span class="d">'+esc(it.desc||"Item sem descrição")+'</span>'+
      '<span class="s">'+esc(line)+'</span>'+
      '<span class="rv mono">'+esc(it.revReq?"R"+it.revReq:"–")+'</span>'+
      '<span class="pz mono">'+esc(pz?(/^\d+$/.test(pz)?pz+" d":pz):"–")+'</span>'+
      '<span class="dw"><span class="dwb" role="button" tabindex="0" data-dw="'+i+'" title="Abrir o desenho deste item">Abrir</span></span>'+
      '<span class="pl"><span class="pill '+pc+'">'+esc(pt)+'</span></span>'+
      '<span class="p mono">'+(c.ok?brl(c.preco):"–")+'</span>'+
      '<span class="tt mono">'+(c.ok?brl(c.total):"–")+'</span><span class="ra"><span class="edb" role="button" tabindex="0" data-ed="'+i+'" title="Editar item" aria-label="Editar item">'+IC.edit+'</span><span class="edb dl" role="button" tabindex="0" data-del="'+i+'" title="Excluir item" aria-label="Excluir item">'+IC.trash+'</span></span></button>';
  }).join("");
  l.scrollTop=keepTop;
  var cur=l.querySelector('[aria-current="true"]');
  if(cur&&l.dataset.follow==="1"){var t=cur.offsetTop;if(t<l.scrollTop)l.scrollTop=t;else if(t+cur.offsetHeight>l.scrollTop+l.clientHeight)l.scrollTop=t+cur.offsetHeight-l.clientHeight}
  l.dataset.follow="";
}

/* ---------- editor ---------- */
function blankEx(){return{mat:0,forma:0,cd:"",c2:"",c3:"",cl:"",pb:"",qp:"1"}}
function fmtKg(kg){return nf(kg,kg<0.1?4:(kg<1?3:2))}
function autoPb(o,id){var kg=rawKg(o).kg;if(kg>0){o.pb=fmtKg(kg);var e=$(id);if(e)e.value=o.pb}}
function brutoTot(it){return n0(it.pb)+(it.ex||[]).reduce(function(a,x){return a+n0(x.pb)*(n0(x.qp)||1)},0)}
function matRow(o,main,i){
  var P=S.P,pre=main?"":"x",at=function(k,num){return main?'data-f="'+k+'"'+(num?' data-num="1"':""):'data-x="'+i+'" data-xk="'+k+'"'+(num?' data-num="1"':"")};
  var id=function(n){return main?"f-"+n:"x"+n+"-"+i};
  var mo=P.mat.map(function(m,k){return'<option value="'+k+'"'+(o.mat===k?" selected":"")+'>'+esc(m.n+" · "+m.f)+'</option>'}).join("");
  var so=SHAPES.map(function(sh,k){return'<option value="'+k+'"'+((o.forma||0)===k?" selected":"")+'>'+esc(sh.n)+'</option>'}).join("");
  var ni=function(k,n,ph){return'<input class="num" id="'+id(n)+'" '+at(k)+' inputmode="decimal" value="'+esc(o[k])+'" placeholder="'+ph+'">'};
  return'<div class="mr'+(main?" main":"")+'">'+
    '<select id="'+id("mat")+'" '+at("mat",1)+' aria-label="Material">'+mo+'</select>'+
    '<select id="'+id("forma")+'" '+at("forma",1)+' aria-label="Forma">'+so+'</select>'+
    ni("cd","cd","Ø")+ni("c2","c2","")+ni("c3","c3","")+ni("cl","cl","c/ sobra")+
    (main?'<span class="q">1</span>':'<input class="num" id="xqp-'+i+'" '+at("qp")+' inputmode="decimal" value="'+esc(o.qp)+'" aria-label="Quantidade por peça">')+
    ni("pb","pb","auto")+
    (main?'<span></span>':'<button type="button" class="btn sm ic dl" title="Remover este material" data-xdel="'+i+'">×</button>')+
  '</div>';
}
function renderExtras(it){
  var box=$("extras");if(!box)return;
  box.innerHTML=(it.ex||[]).map(function(x,i){return matRow(x,false,i)}).join("");
}
function ensureOps(it){
  var P=S.P;
  if(!it.t)it.t=[];
  while(it.t.length<P.maq.length)it.t.push(["",""]);
  if(!it.ops){it.ops=[];for(var i=0;i<P.maq.length;i++){var t=it.t[i]||["",""];if(String(t[0]||"")!==""||String(t[1]||"")!=="")it.ops.push(i)}}
}
function opRow(it,r,kind){
  var P=S.P,i=it.ops[r],M=i>=0?P.maq[i]:null,t=i>=0?(it.t[i]||["",""]):["",""];
  var taxa=M?(M.kg?"R$ "+nf(M.r,2)+"/kg":M.pp?"R$ "+nf(M.r,0)+"/peça":"R$ "+nf(M.r,0)+"/h"):"";
  return'<div class="or"><input list="dl-'+kind+'" data-opn="'+r+'" value="'+esc(M?M.n:"")+'" placeholder="Digite para localizar…" autocomplete="off" aria-label="Operação">'+
    '<span class="mono r hint">'+taxa+'</span>'+
    (M&&M.ext?'<span class="hint r">'+(M.kg?'Kg':M.pp?'Quantidade':'Minutos')+' por peça →</span>':'<input class="num" id="m'+i+'s" inputmode="decimal" '+(M?'data-m="'+i+'" data-k="0"':'disabled')+' value="'+esc(t[0])+'" placeholder="min">')+
    '<input class="num" id="m'+i+'c" inputmode="decimal" '+(M?'data-m="'+i+'" data-k="1"':'disabled')+' value="'+esc(t[1])+'" placeholder="'+(M&&M.kg?"kg":M&&M.pp?"qtd":"min")+'" title="'+(M&&M.kg?"Kg por peça (vem do peso bruto)":M&&M.pp?"Quantidade por peça":"Minutos por peça")+'">'+
    '<span class="mono r" id="mc'+(i>=0?i:"x"+r)+'">–</span>'+
    '<button type="button" class="btn sm ic dl" data-opdel="'+r+'" data-kind="'+kind+'" title="Remover">×</button></div>';
}
function ensureTr(it){
  if(!it.trs)it.trs=it.terc?[it.terc]:[];
  if(!it.os){it.os=[];if(n0(it.outros)>0)it.os.push({d:"Outros",v:String(it.outros)});it.outros=""}
}
function syncTerc(it){it.terc=trList(it)[0]||0}
function renderTr(it){
  ensureTr(it);var P=S.P;
  var b=$("trs");if(b)b.innerHTML=it.trs.map(function(i,r){
    return'<div class="or tr"><input list="dl-tr" data-trn="'+r+'" value="'+esc(i>0?P.terc[i].n:"")+'" placeholder="Digite para localizar o tratamento…" autocomplete="off" aria-label="Tratamento"><button type="button" class="btn sm ic dl" data-trdel="'+r+'" title="Remover">×</button></div>'}).join("");
  var o=$("oss");if(o)o.innerHTML=it.os.map(function(x,r){
    return'<div class="or os"><input data-o="'+r+'" data-ok="d" value="'+esc(x.d)+'" placeholder="Descrição (ex.: análise, jateamento)"><input class="num" data-o="'+r+'" data-ok="v" inputmode="decimal" value="'+esc(x.v)+'" placeholder="R$/peça"><button type="button" class="btn sm ic dl" data-osdel="'+r+'" title="Remover">×</button></div>'}).join("");
  var tp=$("trpar");if(tp)tp.hidden=!trList(it).length;
}
function renderOps(it){
  ensureOps(it);
  ["int","ext"].forEach(function(kind){
    var box=$("ops-"+kind);if(!box)return;
    var h="";
    it.ops.forEach(function(i,r){var ext=i>=0?!!S.P.maq[i].ext:i===-2;if((kind==="ext")===ext)h+=opRow(it,r,kind)});
    box.innerHTML=h;
  });
}
function buildEditor(){
  var it=cur(),ed=$("editor");
  if(!it){ed.innerHTML='<div class="empty">Selecione ou crie um item para começar.</div>';return}
  var P=S.P;
  if(!n0(it.pb)){var k0=rawKg(it).kg;if(k0>0)it.pb=fmtKg(k0)}
  (it.ex||[]).forEach(function(x){if(!n0(x.pb)){var k1=rawKg(x).kg;if(k1>0)x.pb=fmtKg(k1)}});
  var matOpts=P.mat.map(function(m,i){return'<option value="'+i+'"'+(it.mat===i?" selected":"")+'>'+esc(m.n+" · "+m.f)+'</option>'}).join("");
  var shapeOpts=SHAPES.map(function(sh,i){return'<option value="'+i+'"'+((it.forma||0)===i?" selected":"")+'>'+esc(sh.n)+'</option>'}).join("");
  var terOpts=P.terc.map(function(m,i){return'<option value="'+i+'"'+(it.terc===i?" selected":"")+'>'+esc(m.n)+'</option>'}).join("");
  var mrows_unused=P.maq.map(function(m,i){
    var sub=(m.ext&&!(P.maq[i-1]&&P.maq[i-1].ext))?'<tr class="subh"><td colspan="4">Terceiros cobrados por hora (prazo de 7 dias úteis, sem lote mínimo)</td></tr>':"";
    var t=(it.t&&it.t[i])||["",""];
    return sub+'<tr><td>'+esc(m.n)+' <span class="hint mono">R$ '+nf(m.r,0)+'/h</span></td>'+
    '<td><input class="num" inputmode="decimal" id="m'+i+'s" data-m="'+i+'" data-k="0" value="'+esc(t[0])+'" placeholder="0" aria-label="Setup '+esc(m.n)+' em minutos"></td>'+
    '<td><input class="num" inputmode="decimal" id="m'+i+'c" data-m="'+i+'" data-k="1" value="'+esc(t[1])+'" placeholder="0" aria-label="Ciclo '+esc(m.n)+' em minutos"></td>'+
    '<td class="r mono" id="mc'+i+'">–</td></tr>';
  }).join("");
  ed.innerHTML=
  '<div class="edbar"><b>Item '+(S.sel+1)+'</b><span class="edt">'+esc(it.desc||"sem descrição")+'</span><span class="sp"></span><button type="button" class="btn sm" data-edx="cancel">Cancelar</button><button type="button" class="btn sm pri" data-edx="save">Salvar item</button></div>'+
  '<div class="hdrwrap"><div class="stick" id="stick"></div><div class="etabs" id="etabs" role="tablist"></div></div>'+
  '<datalist id="dl-int">'+P.maq.filter(function(m){return!m.ext}).map(function(m){return'<option value="'+esc(m.n)+'">'}).join("")+'</datalist>'+
  '<datalist id="dl-tr">'+P.terc.map(function(m,i){return i?'<option value="'+esc(m.n)+'">':""}).join("")+'</datalist>'+
  '<datalist id="dl-ext">'+P.maq.filter(function(m){return m.ext}).map(function(m){return'<option value="'+esc(m.n)+'">'}).join("")+'</datalist>'+
  '<div class="sec" data-t="dados"><h3>Histórico e pedido</h3><div class="hbox" id="hbox"></div>'+
    (it.req?'<pre class="reqtxt" id="reqtxt"></pre>':"")+'</div>'+
  '<div class="sec" data-t="dados"><h3>Identificação</h3><div class="grid g1">'+
    '<label class="f"><span class="lb">Descrição</span><input id="f-desc" data-f="desc" list="dl-desc" autocomplete="off" value="'+esc(it.desc)+'" placeholder="Ex.: Flange, bucha, eixo"></label>'+
    '<label class="f"><span class="lb">Nº do desenho / revisão</span><input id="f-dwg" data-f="dwg" value="'+esc(it.dwg)+'"></label>'+
    '<div class="f"><span class="lb">Desenho</span>'+dwgLinkHtml(it)+'</div>'+
    '<label class="f"><span class="lb">Quantidade</span><input class="num" id="f-qtd" data-f="qtd" inputmode="numeric" value="'+esc(it.qtd)+'"></label>'+
    '<label class="f"><span class="lb">Código interno</span><input id="f-cod" data-f="cod" data-up="1" list="dl-cod" autocomplete="off" value="'+esc(it.cod)+'" placeholder="Ex.: 26.13.61"></label>'+
  '</div><div class="grid g2">'+
    '<label class="f"><span class="lb">Tipo (Caprind)</span><select id="f-tipo" data-f="tipo"><option'+((it.tipo||"Venda")==="Venda"?" selected":"")+'>Venda</option><option'+(it.tipo==="Industrialização"?" selected":"")+'>Industrialização</option></select></label>'+
    '<label class="f"><span class="lb">Prazo (dias)</span><input id="f-prazo" data-f="prazo" value="'+esc(it.prazo)+'" placeholder="ex.: 15"></label>'+
    '<label class="f"><span class="lb">Rev. cliente</span><input id="f-revReq" data-f="revReq" value="'+esc(it.revReq)+'" placeholder="Ex.: 6"></label>'+
    '<label class="f"><span class="lb">Solicitação do cliente</span><input id="f-ordem" data-f="ordem" value="'+esc(it.ordem)+'"></label>'+
    '<label class="f"><span class="lb">Entrega pedida</span><input id="f-ent" data-f="entTxt" value="'+esc(it.entTxt)+'" placeholder="dd/mm/aaaa"></label>'+
    '<label class="f"><span class="lb">Observação</span><input id="f-nota" data-f="nota" value="'+esc(it.nota)+'"></label>'+
    '<label class="f"><span class="lb" title="Vale para todos os itens deste rascunho. Em branco usa a margem padrão (Controladoria › Parâmetros de custo).">Margem (%)</span><input class="num" id="mar-in" inputmode="decimal" value="'+esc(S.mar||"")+'" placeholder="'+nf(S.P.mar,0)+'"></label>'+
  '</div></div>'+
  '<div class="sec" data-t="mat"><h3>Materiais da peça</h3><div class="matlock" id="matlock">Industrialização: o material é enviado pelo cliente, então não entra no custo. Para voltar a preencher, mude o Tipo (aba Dados) para Venda.</div>'+
    '<div class="scroll"><div class="mt"><div class="mr mh"><span>Material</span><span>Forma</span><span class="r" id="mh-d0">Ø / lado</span><span class="r" id="mh-d1"></span><span class="r" id="mh-d2"></span><span class="r">Compr. (mm)</span><span class="r">Qtd</span><span class="r" title="Calculado pelas medidas. Você pode ajustar na mão.">Peso bruto (kg)</span><span></span></div>'+
    matRow(it,true,0)+'<div id="extras" class="exs"></div></div></div>'+
    '<div class="mfoot">'+'<button type="button" class="btn sm" id="xadd">+ Adicionar material</button>'+
    '<span class="hint" id="cavaco"></span></div>'+
    '</div>'+
  '<div class="sec" data-t="ops"><h3>Usinagem (máquinas próprias)</h3>'+
    '<div class="or oh"><span>Operação</span><span class="r">Taxa</span><span class="r">Setup (min/lote)</span><span class="r">Ciclo (min/peça)</span><span class="r">R$/peça</span><span></span></div>'+
    '<div id="ops-int" class="exs"></div>'+
    '<div class="mfoot"><button type="button" class="btn sm" id="op-add-int">+ Nova operação</button><span class="hint">Digite para localizar a operação. Tempos sempre em minutos. O setup é diluído pela quantidade; o ciclo é por peça.</span></div></div>'+
  '<div class="sec" data-t="ops"><h3>Terceiros (retífica, erosão, soldagem)</h3>'+
    '<div class="or oh"><span>Serviço</span><span class="r">Taxa</span><span></span><span class="r">Por peça</span><span class="r">R$/peça</span><span></span></div>'+
    '<div id="ops-ext" class="exs"></div>'+
    '<div class="mfoot"><button type="button" class="btn sm" id="op-add-ext">+ Novo terceiro</button><span class="hint">Retífica e erosão: informe o tempo por peça em minutos (o valor da hora já está na taxa). Soldagem: informe a quantidade por peça.</span></div></div>'+
  '<div class="sec" data-t="trat"><h3>Tratamento e outros custos</h3>'+
    '<div id="trs" class="exs"></div>'+
    '<div class="mfoot"><button type="button" class="btn sm" id="tr-add">+ Novo tratamento</button><span class="hint">Digite para localizar o tratamento (têmpera, zincagem, oxidação…).</span></div>'+
    '<div class="grid g3" id="trpar"'+(trList(it).length?"":" hidden")+'>'+
      '<label class="f"><span class="lb">Peso por peça a tratar (kg)</span><input class="num" id="f-pa" data-f="pa" inputmode="decimal" value="'+esc(it.pa)+'" placeholder="usa o peso bruto"></label>'+
      '<label class="f"><span class="lb" title="Divide o valor mínimo da nota (ex.: R$ 170 na Agemetal) entre os itens tratados juntos. Use 1 se a peça for tratada sozinha.">Itens na mesma corrida ⓘ</span><input class="num" id="f-corrida" data-f="corrida" inputmode="numeric" value="'+esc(it.corrida)+'"></label>'+
    '</div><span class="hint" id="tinfo"></span>'+
    '<div id="oss" class="exs"></div>'+
    '<div class="mfoot"><button type="button" class="btn sm" id="os-add">+ Outro custo por peça</button><span class="hint">Análise, jateamento, frete, embalagem… (valor em R$ por peça).</span></div>'+
    '<div class="checks">'+
    '<label><input type="checkbox" id="f-tol" data-flag="tol"'+(it.f.tol?" checked":"")+'>Tolerância muito fechada</label>'+
    '<label><input type="checkbox" id="f-exo" data-flag="exo"'+(it.f.exo?" checked":"")+'>Material exótico</label>'+
    '<label><input type="checkbox" id="f-trat" data-flag="trat"'+(it.f.trat?" checked":"")+'>Tratamento fora do padrão</label></div>'+
    '<div class="alert" id="flagbox" hidden></div></div>'+
  '<div class="sec" data-t="preco"><h3>Preço</h3><div class="pricebox">'+
    '<label class="f"><span class="lb">Preço a cotar (R$/peça), em branco usa o automático</span><input class="num" id="f-preco" data-f="preco" inputmode="decimal" value="'+esc(it.preco)+'"></label>'+
    '<label class="f"><span class="lb">Cotação anterior, como referência</span><input class="num" id="f-ref" data-f="ref" inputmode="decimal" value="'+esc(it.ref)+'"></label>'+
    '</div>'+
    '<dl class="brk" id="brk"></dl><div class="alert" id="pricebox" hidden></div>'+
    '<div class="actions"><button type="button" class="btn sm" id="use-hist">Usar último preço</button>'+
    '<button type="button" class="btn sm" id="use-calc">Usar preço calculado</button>'+
    '<button type="button" class="btn sm" id="dup">Duplicar item</button>'+
    '<button type="button" class="btn sm danger" id="del">Excluir item</button></div></div>'+
  '<div class="etnav"><button type="button" class="btn sm" data-etgo="-1">◂ Anterior</button><button type="button" class="btn sm pri" data-etgo="1">Próximo ▸</button></div>';
  renderExtras(it);renderOps(it);renderTr(it);
  if(it.req)$("reqtxt").textContent="Pedido do cliente:\n"+it.req;
  refreshEditor();
}
function renderHbox(it,c){
  var box=$("hbox");if(!box)return;
  var hi=c.hi,warns=[],bad=false;
  var ent=parseBR(it.entTxt);
  if(isFinite(ent)){
    var dd=Math.round((ent-today0())/MS);
    if(dd<0){warns.push("A entrega pedida ("+fmtD(ent)+") já passou.");bad=true}
    else if(dd<10)warns.push("Entrega pedida em "+dd+(dd===1?" dia":" dias")+". O padrão da "+empKey()+" é de 10 a 15 dias.");
  }
  var trs=(String(it.req||"")+" "+(hi&&!hi.none?hi.desc:"")).match(/NITRETA[ÇC][ÃA]O|TRATAMENTO T[ÉE]RMICO|T[ÊE]MPERA|ZINC\w*|ANODIZ\w*|N[ÍI]QUEL\w*|OXIDA\w*|CEMENTA\w*/gi);
  var trTxt="";
  if(trs){var u={};trs.forEach(function(x){u[x.toLowerCase()]=1});trTxt=Object.keys(u).join(", ")}
  if(!hi){
    box.setAttribute("data-st","");
    box.innerHTML='<div class="hl">'+(S.hist?'Informe o código interno para ver o histórico.':'Carregue o relatório de faturadas do Caprind para ver o histórico.')+'</div>'+
      (warns.length?'<div class="wl'+(bad?" bad":"")+'">'+warns.map(esc).join("<br>")+'</div>':"");
    return;
  }
  if(hi.none){
    box.setAttribute("data-st","new");
    var oi0=hi.open,vr=hi.variants&&hi.variants.length&&!oi0?'<div class="hl">Parecidos: '+hi.variants.map(esc).join(", ")+'</div>':"";
    box.innerHTML='<div class="hh"><span class="ht">'+(oi0?'COTADO, NÃO FECHOU':'CÓDIGO NOVO')+'</span>'+(oi0?'<span class="hm">'+esc(oi0.ev[3])+' · '+brl(oi0.price)+' · '+fmtD(oi0.ev[0])+'</span>':'')+'</div>'+vr+
      (trTxt?'<div class="hl">Tratamento: '+esc(trTxt)+'</div>':"")+
      (warns.length?'<div class="wl'+(bad?" bad":"")+'">'+warns.map(esc).join("<br>")+'</div>':"");
    return;
  }
  var st=hi.status,stTxt=st==="ok"?"Preço recente":st==="warn"?"Preço com alguma idade":"Preço antigo, merece atenção";
  var agTxt=hi.future?dtLbl(hi.last,true)+fmtD(hi.last[0]):ageLabel(hi.age);
  var l=hi.last;
  var show=hi.evs.slice(-5).concat((hi.ops||[]).slice(-3)).sort(function(a,b){return b[0]-a[0]});
  var rows=show.map(function(x){
    var op=x[7]==="o";
    return'<tr'+(op?' class="lost"':'')+'><td>'+fmtD(x[0])+(x[8]?' (estimada)':'')+'</td><td>'+esc(x[3])+'</td><td>'+esc(x[4])+'</td><td class="r">'+x[2]+'</td><td class="r mono">'+brl(x[1])+'</td><td>'+(op?'não fechou':x[6]===2?'vendido':'fechado')+'</td></tr>';
  }).join("");
  var w=[],oi=hi.open;
  if(oi){
    var o=oi.ev;
    if(oi.newer)w.push("Cotado e não fechou: "+o[3]+" · "+brl(oi.price)+" · "+fmtD(o[0])+(oi.age<=60?" — confira se já foi cotado.":"."));
    else w.push("Cotação antiga sem fechamento: "+o[3]+" · "+brl(oi.price)+" · "+fmtD(o[0])+".");
  }
  if(hi.via)w.push("Achado pelo desenho: código "+hi.viaCod+". Confirme a peça.");
  if(st==="old")w.push("Última venda há "+ageLabel(hi.age).replace("há ","")+": revise custos.");
  if(hi.future)w.push("Venda em aberto: "+l[3]+" · prazo "+fmtD(l[0])+".");
  if(!hi.future&&l[6]===2&&hi.age<=45)w.push("Venda recente sem faturar: "+l[3]+" · "+fmtD(l[0])+".");
  if(hi.stale)w.push("Preço igual há "+hi.runMonths+" meses.");
  if(hi.revDiff)w.push("Revisão R"+hi.revReq+" não consta (última: R"+hi.revHist+").");
  if(hi.matDiff)w.push("Material difere da última venda ("+hi.kh.join("/")+").");
  var allw=warns.concat(w);
  box.setAttribute("data-st",st);
  box.innerHTML='<div class="hh"><span class="ht">VENDIDO</span><span class="hm">'+esc(l[3])+' · '+brl(hi.price)+' · '+fmtD(l[0])+'</span><span class="ht" style="margin-left:12px;opacity:.7">'+agTxt+'</span></div>'+
    (trTxt?'<div class="hl">Tratamento: '+esc(trTxt)+'</div>':"")+
    (allw.length?'<div class="wl'+(bad||st==="old"?" bad":"")+'">'+allw.map(esc).join("<br>")+'</div>':"")+
    '<details><summary>Ver histórico ('+hi.n+(hi.n===1?" venda":" vendas")+')</summary><table><thead><tr><th>'+(l[6]?'Data':'Prazo final')+'</th><th>Proposta</th><th>Emp.</th><th class="r">Qtd</th><th class="r">Unit.</th><th>Situação</th></tr></thead><tbody>'+rows+'</tbody></table></details>';
}
function dtLbl(ev,long){var f=ev[6];return f===1?"faturada em ":f===2?(ev[7]==="o"?"cotada em ":"vendida em "):(long?"venda com prazo final em ":"prazo final em ")}
function parseBR(s){return toDay(s)}
var ETABS=[["dados","Dados"],["mat","Materiais"],["ops","Operações"],["trat","Tratamento e custos"],["preco","Preço"]];
function renderEtabs(it,c){
  var eb=$("etabs");if(!eb)return;
  var act=S.etab||"dados";$("editor").dataset.active=act;
  ensureOps(it);ensureTr(it);
  var cnt={mat:it.tipo==='Industrialização'?'cliente':1+(it.ex||[]).length,ops:it.ops.length,trat:trList(it).length+it.os.filter(function(x){return n0(x.v)>0}).length,preco:c.ok?brl(c.preco):"sem preço"};
  eb.innerHTML=ETABS.map(function(t){
    var n=cnt[t[0]];
    return'<button type="button" role="tab" data-et="'+t[0]+'" aria-selected="'+(act===t[0])+'">'+t[1]+(n!=null&&n!==0?' <span class="bd'+(t[0]==="preco"&&!c.ok?" warn":"")+'">'+esc(String(n))+'</span>':"")+'</button>'}).join("");
}
function refreshEditor(){
  (function(){var itx=cur();var sm=document.querySelector('.editor .sec[data-t=mat]');if(sm&&itx)sm.classList.toggle('locked',itx.tipo==='Industrialização')})();
  var it=cur();if(!it||!$("stick"))return;
  var c=calc(it),P=S.P;
  var hi=c.hi,t;
  if(c.ok&&isFinite(c.eff))t=tone(c.eff);else t="none";
  $("stick").innerHTML=
   '<div><span class="lbl">Item '+(S.sel+1)+' · preço por peça ('+srcLabel(c.src)+')</span><span class="big">'+(c.ok?brl(c.preco):"–")+'</span></div>'+
   (isFinite(c.eff)?'<div><span class="lbl">Margem sobre o custo calculado</span><span class="big">'+pct(c.eff)+'</span> <span class="pill '+t+'">'+(t==="good"?"dentro da meta":t==="warn"?"abaixo de "+P.alerta+"%":"abaixo do custo")+'</span></div>':
     '<div><span class="lbl">Margem</span><span class="big">–</span> <span class="pill none">informe os tempos</span></div>')+
   '<div><span class="lbl">Total do item</span><span class="big">'+(c.ok?brl(c.total):"–")+'</span></div>';
  renderHbox(it,c);renderEtabs(it,c);renderFoot();
  for(var i=0;i<P.maq.length;i++){var e=$("mc"+i);if(e)e.textContent=c.mc[i]>0?brl(c.mc[i]):"–"}
  var rk=rawKg(it),kg=rk.kg,sh=rk.sh;
  function dimsUI(sh,ids,hd){
    ids.forEach(function(id,i){var e=$(id);if(!e)return;e.style.visibility=sh.dims[i]?"visible":"hidden";e.placeholder=(sh.dims[i]||"").replace(" (mm)","");e.title=sh.dims[i]||""});
    if(hd)hd.forEach(function(id,i){var e=$(id);if(e)e.textContent=(sh.dims[i]||"").replace(" (mm)","")});
  }
  dimsUI(sh,["f-cd","f-c2","f-c3"],["mh-d0","mh-d1","mh-d2"]);
  var xs=it.ex||[];
  xs.forEach(function(x,i){
    var xr=rawKg(x);dimsUI(xr.sh,["xcd-"+i,"xc2-"+i,"xc3-"+i]);
  });
  var mt=P.mat[it.mat]||P.mat[0];
  $("cavaco").textContent="Densidade "+nf(rk.dens,2)+" g/cm³ ("+(mt?mt.n:"")+")."+(sh.k==="tubq"?" Cantos arredondados não são descontados.":"");
  
  var tr=c.tr,ti="";
  if(trList(it).length){
    ti="Peso tratado: "+nf(tr.kg,2)+" kg. Custo do tratamento no lote: "+brl(tr.lot)+" ("+brl(tr.pp)+" por peça).";
    if(tr.minApplied)ti+=" Vale o mínimo de "+brl(tr.minV)+": o peso sozinho custaria menos.";
  }
  $("tinfo").textContent=ti;
  var msgs=[];
  xs.forEach(function(x,i){if(!(matPrice(x.mat)>0)&&n0(x.pb)>0)msgs.push("O material adicional "+(i+1)+" está sem preço (R$/kg). Cadastre em Parâmetros.")});
  if(!(matPrice(it.mat)>0))msgs.push("Este material ainda está sem preço (R$/kg). Cadastre em Parâmetros, senão o custo do material sai zerado.");
  if(it.f.tol)msgs.push("Tolerância muito fechada: consultar o cliente antes de cotar.");
  if(it.f.exo)msgs.push("Material exótico: confirmar disponibilidade e preço com o fornecedor.");
  if(it.f.trat)msgs.push("Tratamento fora do padrão: conferir se preço do terceiro e lote mínimo estão no custo.");
  if(tr.minApplied)msgs.push("O valor mínimo do tratamento está pesando no custo. Agrupar com outros itens reduz o valor por peça.");
  if(tr.warn)msgs.push(tr.warn);
  var fb=$("flagbox");fb.hidden=!msgs.length;fb.innerHTML=msgs.map(esc).join("<br>");
  var rows=[["Material",c.mat],["Operações e terceiros",c.maq],["Tratamento",c.terc],["Outros terceiros",c.outros]];
  var h=rows.map(function(r){return"<dt>"+r[0]+"</dt><dd>"+brl(r[1])+"</dd>"}).join("");
  h+='<dt class="tot">Custo por peça</dt><dd class="tot">'+(c.calcOk?brl(c.custo):"–")+"</dd>";
  h+="<dt>Imposto ("+P.imp+"% do preço)</dt><dd>"+(c.ok?brl(c.imposto):"–")+"</dd>";
  h+="<dt>Preço calculado hoje (margem "+nf(MAR(),1)+"%)</dt><dd>"+(c.calcOk?brl(c.sug):"–")+"</dd>";
  h+="<dt>Última venda</dt><dd>"+(isFinite(c.hp)?brl(c.hp):"–")+"</dd>";
  h+="<dt>Horas por peça (setup diluído)</dt><dd>"+fh(c.hrs)+"</dd>";
  $("brk").innerHTML=h;
  $("f-preco").placeholder=c.ok?nf(c.preco,2)+" ("+srcLabel(c.src)+")":"";
  var pb=$("pricebox"),pm=[];
  if(c.ok&&isFinite(c.eff)&&c.eff<0)pm.push("Com este preço o item fica abaixo do custo cheio.");
  else if(c.ok&&isFinite(c.eff)&&c.eff<P.alerta/100)pm.push("Margem abaixo do mínimo de "+P.alerta+"%.");
  if(matPrice(it.mat)<=0)pm.push("O preço deste material está zerado: defina em Parâmetros.");
  if(c.src==="open"&&c.hi&&c.hi.open)pm.push("Preço lançado da última cotação que não fechou ("+brl(c.hi.open.price)+", proposta "+c.hi.open.ev[3]+"). Mantenha ou digite outro preço.");
  if(c.calcOk&&isFinite(c.hp)&&c.sug>0){var df=c.sug/c.hp-1;pm.push("O preço calculado hoje ("+brl(c.sug)+") está "+nf(Math.abs(df)*100,0)+"% "+(df>=0?"acima":"abaixo")+" da última venda ("+brl(c.hp)+").")}
  if(c.ok&&isFinite(c.ref)&&c.ref>0)pm.push("Cotação anterior: "+brl(c.ref)+" ("+(c.preco>=c.ref?"+":"")+nf((c.preco/c.ref-1)*100,0)+"% em relação a ela).");
  pb.hidden=!pm.length;pb.className="alert"+(c.ok&&isFinite(c.eff)&&c.eff<0?" bad":"");pb.innerHTML=pm.map(esc).join("<br>");
}

/* ---------- proposta ---------- */
function lineText(it,c,n){
  return n+". "+(it.cod?"Cód. "+it.cod+" - ":"")+(it.desc||"Item")+(it.dwg&&String(it.desc||"").indexOf("DES.:")<0?" (Des. "+it.dwg+")":"")+(it.ordem?" [solicitação "+it.ordem+"]":"")+" - "+c.q+" un x "+brl(c.preco)+" = "+brl(c.total);
}
function proposalText(){
  var L=[],tot=0;
  L.push("Prezados,","","Segue nossa proposta "+(S.prop||"")+" para "+(S.cli||"")+":","");
  var n=0;
  S.items.forEach(function(it){
    var c=calc(it);if(!c.ok)return;
    tot+=c.total;n++;L.push(lineText(it,c,n));
  });
  L.push("","Total: "+brl(tot),"","Condições: pagamento "+(S.cond||"28 DDL")+"; validade da proposta 5 dias; prazo de entrega a partir de 10 a 15 dias úteis, conforme a demanda; frete por nossa conta; certificado de material fornecido junto com a peça.","","Atenciosamente,","MIX Usinagem");
  return L.join("\n");
}
function renderProposal(){
  var rows="",tot=0;
  S.items.forEach(function(it,i){
    var c=calc(it);
    if(!c.ok){rows+='<tr><td>'+(i+1)+'</td><td>'+esc(it.desc||"Item sem descrição")+'<br><span class="hint">Sem preço, fora do total.</span></td><td class="r mono">'+c.q+'</td><td class="r mono">–</td><td class="r mono">–</td></tr>';return}
    tot+=c.total;
    rows+='<tr><td>'+(i+1)+'</td><td>'+esc(it.desc||"Item")+'<br><span class="hint mono">'+esc([it.cod,it.dwg,it.ordem?"solicitação "+it.ordem:""].filter(Boolean).join(" · "))+'</span></td><td class="r mono">'+c.q+'</td><td class="r mono">'+brl(c.preco)+'</td><td class="r mono">'+brl(c.total)+'</td></tr>';
  });
  $("proposal").innerHTML=
   '<img class="logo sm" alt="'+esc(empData().nome)+'" src="'+$("logo").src+'">'+
   '<div><div class="eyebrow">Proposta comercial</div><h2>'+esc(S.prop||"Sem número")+' · '+esc(S.cli||"Cliente")+'</h2><span class="hint">Emitida em '+new Date().toLocaleDateString("pt-BR")+'</span></div>'+
   '<div class="scroll"><table><thead><tr><th>#</th><th>Descrição</th><th class="r">Qtd</th><th class="r">Unitário</th><th class="r">Total</th></tr></thead><tbody>'+rows+
   '<tr><td colspan="4" class="r"><strong>Total</strong></td><td class="r mono"><strong>'+brl(tot)+'</strong></td></tr></tbody></table></div>'+
   '<div class="hint">Condições: '+esc(S.cond||"28 DDL")+' · validade 5 dias · prazo a partir de 10 a 15 dias · frete por conta da '+esc(empKey())+' · certificado de material incluso.</div>'+
   '<label class="f"><span class="lb">Texto pronto para o e-mail</span><textarea id="mail" readonly>'+esc(proposalText())+'</textarea></label>'+
   '<div class="actions"><button type="button" class="btn pri" id="copy">Copiar texto</button>'+
   '<button type="button" class="btn" disabled title="Disponível quando a integração com o Caprind estiver pronta">Enviar ao Caprind</button></div>'+
   '<span class="hint">“Enviar ao Caprind” depende da API do sistema. Hoje a proposta sai daqui como texto para você colar no e-mail.</span>';
}

/* ---------- parâmetros ---------- */
function empPanel(){
  var F=[["razao","Razão social"],["cnpj","CNPJ"],["ie","Inscrição estadual"],["end","Endereço"],["tel","Telefone"],["email","E-mail"]];
  return '<div class="panel"><div class="panel-h"><h3>Empresas (MIX e STAR)</h3></div><div class="sec">'+
    '<span class="hint">Os dados e o logo aparecem no PDF do rascunho. Os preços e o histórico são os mesmos para as duas empresas.</span>'+
    ["MIX","STAR"].map(function(k){var e=empData(k);
      return '<div class="emp-form" data-e="'+k+'"><div class="emp-h"><img src="'+esc(e.logoPng)+'" alt=""><b>'+esc(e.nome)+'</b></div>'+
        F.map(function(f){return '<label class="f"><span class="lb">'+f[1]+'</span><input data-pe="'+k+'.'+f[0]+'" value="'+esc(e[f[0]]||"")+'" autocomplete="off"></label>'}).join("")+
        '<label class="f"><span class="lb">Logo (imagem PNG ou JPG)</span><input type="file" accept="image/png,image/jpeg" data-pelogo="'+k+'"></label>'+
        '<div><button type="button" class="btn sm" data-peres="'+k+'">Voltar ao logo original</button></div></div>'}).join("")+
    '</div></div>';
}
function renderParams(){
  var P=S.P;
  function inp(path,val){return'<input class="num" inputmode="decimal" data-p="'+path+'" value="'+esc(val==null?"":val)+'" aria-label="'+esc(path)+'">'}
  var maq=P.maq.map(function(m,i){return'<tr><td>'+esc(m.n)+'</td><td>'+inp("maq."+i+".r",m.r)+'</td></tr>'}).join("");
  function txt(path,val,w){return'<input data-pt="'+path+'" value="'+esc(val==null?"":val)+'" style="width:'+w+'" aria-label="'+esc(path)+'">'}
  var mat=P.mat.map(function(m,i){return'<tr><td colspan="4" style="padding-bottom:0">'+txt("mat."+i+".n",m.n,"100%")+'</td></tr><tr><td>'+txt("mat."+i+".f",m.f,"100%")+'</td><td>'+inp("mat."+i+".r",m.r)+'</td><td>'+inp("mat."+i+".d",m.d)+'</td><td><button type="button" class="btn sm" data-delmat="'+i+'" aria-label="Remover material">×</button></td></tr>'}).join("");
  var ter=P.terc.map(function(m,i){return i===0?"":'<tr><td>'+esc(m.n)+'<br><span class="hint">'+(m.mode==="lote"?"Valor por lote"+(m.capKg?" de até "+m.capKg+" kg":""):"Valor por kg")+(m.forn?" · "+esc(m.forn):"")+'</span></td>'+
    '<td>'+inp("terc."+i+".r",m.r)+'</td><td>'+(m.mode==="lote"?"":inp("terc."+i+".minR",m.minR||""))+'</td><td>'+(m.mode==="lote"?"":inp("terc."+i+".minKg",m.minKg||""))+'</td></tr>'}).join("");
  var H=S.hist;
  $("params").innerHTML=
   '<div class="p-grid">'+
   '<div class="panel"><div class="panel-h"><h3>Histórico de preços</h3></div><div class="sec">'+
     '<label class="f"><span class="lb">Atenção após (dias desde o último faturamento)</span>'+inp("hAt",P.hAt)+'</label>'+
     '<label class="f"><span class="lb">Preço antigo após (dias)</span>'+inp("hOld",P.hOld)+'</label>'+
     '<label class="f"><span class="lb">Avisar “preço parado” após (meses com o mesmo preço)</span>'+inp("hStale",P.hStale)+'</label>'+
     '<span class="hint">A tela usa sempre o último preço faturado. Verde: até o primeiro limite. Amarelo: entre os dois. Vermelho: acima do segundo.</span>'+
     '<span class="hint">'+(H?esc("Histórico carregado: "+nf(H.meta.codes,0)+" códigos, "+nf(H.meta.lines,0)+" linhas."):"Nenhum histórico carregado.")+'</span>'+
     (H?'<div class="actions"><button class="btn sm danger" id="hist-clear" type="button">Apagar histórico deste navegador</button></div>':"")+
   '</div></div>'+
   '<div class="panel"><div class="panel-h"><h3>Custo/hora (máquinas e setores)</h3></div><div class="sec"><div class="scroll"><table class="tbl"><thead><tr><th>Máquina</th><th class="r">R$/hora</th></tr></thead><tbody>'+maq+'</tbody></table></div><span class="hint">Já embute os custos fixos. Não são somados de novo.</span></div></div>'+
   '<div class="panel"><div class="panel-h"><h3>Material (R$/kg e densidade)</h3></div><div class="sec"><div class="scroll"><table class="tbl"><thead><tr><th>Material e forma de compra</th><th class="r">R$/kg</th><th class="r">g/cm³</th><th></th></tr></thead><tbody>'+mat+'</tbody></table></div><div class="actions"><button type="button" class="btn sm pri" id="mat-add">+ Adicionar material</button></div><span class="hint">A densidade entra no cálculo do peso da barra: aço 7,85, inox 7,93 a 7,98, alumínio 2,70, latão 8,50, bronze 8,80. Confira com a ficha do fornecedor. Ao remover um material, os itens que o usavam voltam para o primeiro da lista.</span></div></div>'+
   '<div class="panel"><div class="panel-h"><h3>Tratamentos (terceiros)</h3></div><div class="sec"><div class="scroll"><table class="tbl"><thead><tr><th>Tratamento</th><th class="r">Valor (R$)</th><th class="r">Mín. (R$)</th><th class="r">Mín. (kg)</th></tr></thead><tbody>'+ter+'</tbody></table></div><span class="hint">O mínimo vale por lote ou nota fiscal. Zincagem e oxidação: lote mínimo de 10 kg. Anodização dura: R$ 200. Agemetal: R$ 170 por nota fiscal.</span></div></div>'+
   empPanel()+'<div class="panel"><div class="panel-h"><h3>Pagamento padrão por cliente</h3></div><div class="sec"><textarea data-pcc="1" rows="8" style="width:100%">'+esc((P.condcli||[]).join("\n"))+'</textarea><span class="hint">Um cliente por linha, no formato NOME = condição. O sistema reconhece o nome dentro do cliente digitado (ex.: GASCAT reconhece "GASCAT IND. E COM. LTDA"). A condição precisa existir na lista ao lado.</span></div></div>'+
   '<div class="panel"><div class="panel-h"><h3>Condições de pagamento</h3></div><div class="sec"><textarea data-pc="1" rows="8" style="width:100%">'+esc((P.conds||[]).join("\n"))+'</textarea><span class="hint">Uma condição por linha. Elas aparecem na lista "Pagamento" do topo.</span></div></div>'+
   '<div class="panel"><div class="panel-h"><h3>Regras gerais</h3></div><div class="sec">'+
     '<label class="f"><span class="lb">Imposto sobre o preço (%): Simples Nacional</span>'+inp("imp",P.imp)+'</label>'+
     '<label class="f"><span class="lb">Margem alvo sobre o preço (%)</span>'+inp("mar",P.mar)+'</label>'+
     '<label class="f"><span class="lb">Margem mínima de alerta (%)</span>'+inp("alerta",P.alerta)+'</label>'+
     '<label class="f"><span class="lb">Custo fixo mensal médio (R$, informativo)</span>'+inp("fixo",P.fixo)+'</label>'+
     '<label class="f"><span class="lb">Gasto mensal total médio (R$, informativo)</span>'+inp("gasto",P.gasto)+'</label>'+
     '<span class="hint">Preço = custo ÷ (1 − imposto − margem). Custos fixos e gasto mensal não entram no cálculo: já estão embutidos no custo/hora. Valide a alíquota com o contador.</span></div></div>'+
   '</div>';
}
function renderParamsIfOpen(){if(S.tab==="par")renderParams()}

/* ---------- navegação / eventos ---------- */
function toast(m){var t=$("toast");t.textContent=m;t.hidden=false;clearTimeout(toast.h);toast.h=setTimeout(function(){t.hidden=true},4200)}

$("t-ini").closest(".mods").addEventListener("click",function(e){
  var b=e.target.closest("button");if(!b)return;
  if(b.dataset.cap){showTab("cap");return}
  if(b.dataset.dev){toast(b.dataset.dev+": em desenvolvimento");return}
  if(b.dataset.tog){var id={adm:"s-adm",ven:"s-ven",ctl:"s-ctl"}[b.dataset.tog],on=!b.classList.contains("open");
    b.classList.toggle("open",on);b.setAttribute("aria-expanded",String(on));$(id).classList.toggle("open",on)}
});
$("s-adm").classList.add("open");$("s-ven").classList.add("open");

var APPV="64",APPD="22/10/2026";
var BOOTCAP=true;try{BOOTCAP=localStorage.getItem("mista_ver")!==APPV}catch(e){}
var BR=(function(){
  var cv=$("brain"),cx=cv.getContext("2d"),raf=0,nodes=[],edges=[],ag=[],parts=[],W=0,H=0,S=1,ox=0,oy=0,dpr=1,hover=-1,built=false,still=false;
  try{still=window.matchMedia("(prefers-reduced-motion: reduce)").matches}catch(e){}
  function mul(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
  function el(u,v,cx_,cy,rx,ry,rot){var c=Math.cos(rot),s_=Math.sin(rot),dx=u-cx_,dy=v-cy,x=dx*c+dy*s_,y=-dx*s_+dy*c;return x*x/(rx*rx)+y*y/(ry*ry)<=1}
  function inside(u,v){return el(u,v,.50,.40,.33,.24,-.05)||el(u,v,.40,.47,.22,.16,0)||el(u,v,.47,.57,.19,.075,.12)||el(u,v,.71,.66,.11,.075,0)||el(u,v,.585,.74,.03,.135,.06)}
  var AG=[["Vendas",.34,.36,1],["Compras",.47,.24,0],["Estoque",.62,.30,0],["PCP",.44,.45,0],["Engenharia",.58,.46,0],["Qualidade",.71,.42,0],["Manutenção",.29,.53,0],["Controladoria",.52,.59,0],["Financeiro",.71,.67,0],["Caprind (ERP)",.585,.82,0]];
  function build(){
    var r=mul(11),i,j,tries=0;nodes=[];edges=[];ag=[];parts=[];
    AG.forEach(function(a){var n={u:a[1],v:a[2],a:1,name:a[0],on:a[3],ph:r()*6,adj:[]};nodes.push(n);ag.push(n)});
    while(nodes.length<160&&tries<9000){tries++;var u=.15+r()*.7,v=.14+r()*.78;if(!inside(u,v))continue;var ok=true;for(i=0;i<nodes.length;i++){var dx=nodes[i].u-u,dy=nodes[i].v-v;if(dx*dx+dy*dy<.0014){ok=false;break}}if(ok)nodes.push({u:u,v:v,ph:r()*6,adj:[]})}
    var seen={};
    nodes.forEach(function(n,i){var d=[];nodes.forEach(function(m,j2){if(i!==j2){var dx=n.u-m.u,dy=n.v-m.v;d.push([dx*dx+dy*dy,j2])}});d.sort(function(a,b){return a[0]-b[0]});
      for(var q=0;q<(n.a?4:3);q++){if(!d[q]||d[q][0]>.015)continue;var j3=d[q][1],key=i<j3?i+"-"+j3:j3+"-"+i;if(!seen[key]){seen[key]=1;edges.push({a:i,b:j3})}}});
    edges.forEach(function(e){nodes[e.a].adj.push(e.b);nodes[e.b].adj.push(e.a)});
    for(i=0;i<30;i++){var st=i<12?0:Math.floor(r()*nodes.length);if(!nodes[st].adj.length)continue;parts.push({at:st,to:nodes[st].adj[Math.floor(r()*nodes[st].adj.length)],prev:-1,p:r(),sp:.004+r()*.007,hot:i<12})}
    built=true;
  }
  function px(n,t){return[ox+(n.u+Math.sin(t*.0006+n.ph)*.0035)*S,oy+(n.v+Math.cos(t*.0005+n.ph)*.0035)*S]}
  function resize(){var b=cv.parentNode.getBoundingClientRect();if(!b.width||!b.height)return false;dpr=Math.min(window.devicePixelRatio||1,2);W=b.width;H=b.height;cv.width=Math.round(W*dpr);cv.height=Math.round(H*dpr);S=Math.min(H*1.02,W*.92);ox=W*.5-.5*S;oy=H*.47-.52*S;return true}
  function draw(t){
    cx.setTransform(dpr,0,0,dpr,0,0);cx.clearRect(0,0,W,H);
    var cs=getComputedStyle(document.documentElement);function tk(n,d){return cs.getPropertyValue(n).trim()||d}
    var red=tk("--red","#EE3239"),ln=tk("--cap-line","rgba(152,161,216,.2)"),mu=tk("--cap-mute","#98A1D8"),ink=tk("--cap-ink","#F1F3FF"),bg=tk("--cap-bg","#070B30");
    cx.fillStyle=tk("--cap-grid","rgba(152,161,216,.055)");cx.beginPath();
    [[.50,.40,.33,.24,-.05],[.40,.47,.22,.16,0],[.47,.57,.19,.075,.12],[.71,.66,.11,.075,0],[.585,.74,.03,.135,.06]].forEach(function(e){cx.moveTo(ox+(e[0]+e[2])*S,oy+e[1]*S);cx.ellipse(ox+e[0]*S,oy+e[1]*S,e[2]*S,e[3]*S,e[4],0,6.2832)});
    cx.fill();
    var P=nodes.map(function(n){return px(n,t)});
    cx.lineWidth=1;
    edges.forEach(function(e){var a=P[e.a],b=P[e.b],hot=nodes[e.a].on||nodes[e.b].on,hl=hover>=0&&(nodes[e.a]===ag[hover]||nodes[e.b]===ag[hover]);cx.strokeStyle=hot?red:(hl?ink:ln);cx.globalAlpha=hot?.6:(hl?.5:1);cx.beginPath();cx.moveTo(a[0],a[1]);cx.lineTo(b[0],b[1]);cx.stroke()});
    cx.globalAlpha=.6;cx.fillStyle=mu;
    nodes.forEach(function(n,i2){if(n.a)return;cx.beginPath();cx.arc(P[i2][0],P[i2][1],1.4,0,6.2832);cx.fill()});
    cx.globalAlpha=1;
    parts.forEach(function(q){var a=P[q.at],b=P[q.to],x=a[0]+(b[0]-a[0])*q.p,y=a[1]+(b[1]-a[1])*q.p;cx.save();if(q.hot){cx.shadowBlur=8;cx.shadowColor=red}cx.fillStyle=q.hot?red:ink;cx.globalAlpha=q.hot?1:.55;cx.beginPath();cx.arc(x,y,q.hot?2.4:1.6,0,6.2832);cx.fill();cx.restore()});
    ag.forEach(function(n,k){var i3=nodes.indexOf(n),p=P[i3],h=hover===k,r0=h?7.5:6;
      if(n.on){var ph=(t%2400)/2400;cx.strokeStyle=red;cx.globalAlpha=(1-ph)*.8;cx.lineWidth=1.2;cx.beginPath();cx.arc(p[0],p[1],r0+ph*20,0,6.2832);cx.stroke();cx.globalAlpha=1}
      cx.fillStyle=n.on?red:bg;cx.strokeStyle=n.on?ink:(h?ink:mu);cx.lineWidth=1.6;cx.beginPath();cx.arc(p[0],p[1],r0,0,6.2832);cx.fill();cx.stroke();
      if(!n.on){cx.fillStyle=h?ink:mu;cx.beginPath();cx.arc(p[0],p[1],1.6,0,6.2832);cx.fill()}
      if(!n.on&&!h)return;
      cx.font=(n.on?"700 13px ":"600 12.5px ")+"'Plus Jakarta Sans',system-ui,sans-serif";cx.textBaseline="middle";var left=n.u>.62;cx.textAlign=left?"left":"right";
      var tx=p[0]+(left?14:-14);cx.fillStyle=ink;cx.fillText(n.name,tx,p[1]);
      cx.font="600 10px 'IBM Plex Mono',ui-monospace,monospace";cx.fillStyle=n.on?red:mu;cx.fillText(n.on?"ATIVO":"EM DESENVOLVIMENTO",tx,p[1]+15);
    });
  }
  function step(){parts.forEach(function(q){q.p+=q.sp;if(q.p>=1){var nx=nodes[q.to].adj.filter(function(x){return x!==q.at}),n=nx.length?nx[Math.floor(Math.random()*nx.length)]:q.at;q.prev=q.at;q.at=q.to;q.to=n;q.p=0}})}
  function loop(t){raf=requestAnimationFrame(loop);step();draw(t)}
  function hit(e){var b=cv.getBoundingClientRect(),zx=b.width/cv.offsetWidth||1,x=(e.clientX-b.left)/zx,y=(e.clientY-b.top)/zx,t=performance.now(),best=-1,bd=24*24;ag.forEach(function(n,k){var p=px(n,t),dx=p[0]-x,dy=p[1]-y,d=dx*dx+dy*dy;if(d<bd){bd=d;best=k}});return best}
  function setHover(k){if(k===hover)return;hover=k;if(api.onhover)api.onhover(k);if(still&&built)draw(0)}
  function open(k){if(AG[k][3])showTab("ini");else toast(AG[k][0]+": em desenvolvimento")}
  cv.addEventListener("mousemove",function(e){var k=hit(e);cv.style.cursor=k>=0?"pointer":"default";setHover(k)});
  cv.addEventListener("mouseleave",function(){setHover(-1)});
  cv.addEventListener("click",function(e){var k=hit(e);if(k>=0)open(k)});
  window.addEventListener("resize",function(){if(document.body.dataset.tab==="cap"&&resize()&&still)draw(0)});
  var api={agents:AG,hover:setHover,open:open,onhover:null,start:function(){if(!built)build();if(!resize()){setTimeout(BR.start,80);return}cancelAnimationFrame(raf);if(still)draw(0);else raf=requestAnimationFrame(loop)},stop:function(){cancelAnimationFrame(raf);raf=0}};
  return api;
})();
(function(){
  var L=$("cap-list"),A=BR.agents,on=A.filter(function(a){return a[3]}).length;
  L.innerHTML=A.map(function(a,k){return'<li><button type="button" data-ag="'+k+'"'+(a[3]?' class="on"':'')+' title="'+(a[3]?"Ativo":"Em desenvolvimento")+'"><i></i><span>'+a[0]+'</span></button></li>'}).join("");
  $("cap-n").textContent=on+"/"+A.length;
  $("cap-bar").innerHTML=A.map(function(a){return'<i'+(a[3]?' class="on"':'')+'></i>'}).join("");
  function k(e){var b=e.target.closest("[data-ag]");return b?+b.dataset.ag:-1}
  L.addEventListener("mouseover",function(e){BR.hover(k(e))});
  L.addEventListener("focusin",function(e){BR.hover(k(e))});
  L.addEventListener("mouseleave",function(){BR.hover(-1)});
  L.addEventListener("click",function(e){var i=k(e);if(i>=0)BR.open(i)});
  BR.onhover=function(i){Array.prototype.forEach.call(L.querySelectorAll("[data-ag]"),function(b){b.classList.toggle("ag-hl",+b.dataset.ag===i)})};
  $("cap-go").addEventListener("click",function(){showTab("ini")});
})();
$("cap-ver").textContent=APPV;$("cap-dt").textContent=APPD;
var PCS=["in","sv","itens","prop"];
function pcBadges(){
  var n=0;try{n=(IB.docs||[]).filter(function(d){return d.status==="novo"}).length}catch(e){}
  var a=$("bd-in"),b=$("bd-sv");
  if(a){a.textContent=n||"";a.style.display=n?"":"none";a.classList.toggle("warn",!!n)}
  if(b){var c=(PR.list||[]).length;b.textContent=c||"";b.style.display=c?"":"none"}
}
function showTab(tab){
  if(tab==="pc")tab=S.sub||"sv";
  var pc=PCS.indexOf(tab)>-1;
  if(pc)S.sub=tab;
  S.tab=tab;
  document.body.dataset.tab=pc?(tab==="itens"?"itens":"pc"):tab;
  document.body.dataset.sub=tab;
  ["cap","ini","par"].forEach(function(k){$("v-"+k).hidden=k!==tab});
  $("v-pc").hidden=!pc;
  PCS.forEach(function(k){$("v-"+k).hidden=k!==tab});
  [["t-ini",tab==="ini"],["t-pc",pc],["t-par",tab==="par"]].forEach(function(a){var tb=$(a[0]);if(tb)tb.setAttribute("aria-selected",a[1]?"true":"false")});
  Array.prototype.forEach.call(document.querySelectorAll("[data-pcs]"),function(b){b.setAttribute("aria-selected",b.dataset.pcs===tab?"true":"false")});
  if(tab==="cap")BR.start();else BR.stop();
  $("closebox").hidden=tab!=="itens";
  var SUB={in:"Caixa de entrada",sv:"Propostas",itens:"Itens",prop:"Proposta (PDF)"};
  if(tab==="par"){var cb=document.querySelector('[data-tog="ctl"]');cb.classList.add("open");cb.setAttribute("aria-expanded","true");$("s-ctl").classList.add("open");$("crumb").innerHTML='Controladoria › <b>Parâmetros de custo</b>';$("crumb-t").textContent="Parâmetros de custo"}
  else if(pc){$("crumb").innerHTML='Administrativo › Vendas › <b>Proposta comercial</b> › '+SUB[tab];$("crumb-t").textContent=SUB[tab]}
  else{var TT={cap:"CÉREBRO MISTA",ini:"Dashboard"};$("crumb").innerHTML='Administrativo › <b>Vendas</b> › '+TT[tab];$("crumb-t").textContent=TT[tab]}
  pcBadges();
  if(tab==="ini")renderDash();
  if(tab==="prop")renderProposal();
  if(tab==="par")renderParams();
  if(tab==="sv")pRender();
}
$("pc-tabs").addEventListener("click",function(e){var b=e.target.closest("[data-pcs]");if(b)showTab(b.dataset.pcs)});
var _st0=showTab;showTab=function(t){if(t!=="itens")closeEd(true);var r=_st0.apply(this,arguments);var hb=document.querySelector(".mod[data-cap]");if(hb){if(S.tab==="cap")hb.setAttribute("aria-current","page");else hb.removeAttribute("aria-current")}return r};
function refreshAll(){renderSummary();renderList();refreshEditor();if(S.tab==="prop")renderProposal();renderClose();save()}
function normT(x){return String(x||"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase().replace(/[^a-z0-9]+/g," ").trim()}
function condFor(cli){
  var c=normT(cli);if(!c)return"";
  var rules=(S.P.condcli||[]),best="",bl=0;
  rules.forEach(function(r){var i=r.indexOf("=");if(i<1)return;var k=normT(r.slice(0,i)),v=r.slice(i+1).trim();if(k&&v&&c.indexOf(k)>-1&&k.length>bl){best=v;bl=k.length}});
  return best;
}
function autoCond(){var v=condFor(S.cli);if(v&&S.cond!==v){S.cond=v;if($("cond"))renderCond()}}
function renderCond(){var e=$("cond"),l=(S.P.conds||[]).slice();if(S.cond&&l.indexOf(S.cond)<0)l.push(S.cond);e.innerHTML=l.map(function(c){return'<option>'+esc(c)+'</option>'}).join("");e.value=S.cond||l[0]||""}
function fullRender(){
  $("banner").hidden=!S.sample;$("prop-no").value=S.prop;$("cli").value=S.cli;renderCond();$("sol-in").value=S.sol||"";
  applyEmp();renderStatus();renderSummary();renderList();buildEditor();var t0=S.tab;if(BOOTCAP){BOOTCAP=false;t0="cap";try{localStorage.setItem("mista_ver",APPV)}catch(e){}}showTab(t0);showId();renderClose();save();
}

Array.prototype.forEach.call(document.querySelectorAll(".tabs"),function(n){n.addEventListener("click",function(e){var b=e.target.closest("[data-tab]");if(b)showTab(b.dataset.tab)})});
$("prop-no").addEventListener("input",function(e){S.prop=e.target.value;refreshAll()});
$("cli").addEventListener("focus",function(){fillDL("dl-cli",cliList().map(function(c){return[c,""]}))});
$("cli").addEventListener("input",function(e){S.cli=e.target.value;autoCond();refreshAll()});
$("cond").addEventListener("input",function(e){S.cond=e.target.value;refreshAll()});
$("sol-in").addEventListener("input",function(e){S.sol=e.target.value;save()});

function openEd(i,isNew){
  S.sel=i;S.edSnap=JSON.stringify(S.items);S.edNew=!!isNew;
  document.body.classList.add("ed-open");renderList();buildEditor();
  var m=$("edmask");if(m)m.hidden=false;
  var ed=$("editor");if(ed)ed.scrollTop=0;
}
function closeEd(keep){
  if(!document.body.classList.contains("ed-open"))return;
  document.body.classList.remove("ed-open");var m=$("edmask");if(m)m.hidden=true;
  if(!keep&&S.edSnap){
    try{var sn=JSON.parse(S.edSnap);S.items=sn;if(!S.items.length)S.items=[blankItem()];if(S.sel>=S.items.length)S.sel=Math.max(0,S.items.length-1)}catch(e){}
    fullRender();
  }
  S.edSnap=null;
}
$("list").addEventListener("click",function(e){var dl=e.target.closest("[data-del]");if(dl){
  var k=+dl.dataset.del,itx=S.items[k]||{};
  askDel("Excluir este item?","Item "+(k+1)+(itx.desc?" · "+String(itx.desc).slice(0,70):"")+". Esta ação não pode ser desfeita.",function(){S.items.splice(k,1);if(!S.items.length)S.items=[blankItem()];S.sel=Math.min(S.sel,S.items.length-1);S.sample=false;renderList();refreshAll();toast("Item excluído.")});return}
  var w=e.target.closest("[data-dw]");if(w){openDwg(S.items[+w.dataset.dw]);return}var b=e.target.closest("[data-i]");if(!b)return;openEd(+b.dataset.i,false)});
$("editor").addEventListener("click",function(e){
  var b=e.target.closest("[data-edx]");if(!b)return;
  if(b.dataset.edx==="cancel"){closeEd(false);return}
  closeEd(true);renderList();renderFoot&&renderFoot();save();if(PR.db&&pWorth())pSave();toast("Item salvo.");
});
document.addEventListener("keydown",function(e){if(e.key==="Escape"&&document.body.classList.contains("ed-open"))closeEd(false)});
$("edmask").addEventListener("click",function(){closeEd(false)});
$("add").addEventListener("click",function(){var l0=S.items;if(l0.length===1&&!l0[0].desc&&!l0[0].cod&&!l0[0].dwg)S.items=[];S.items.push(blankItem());S.sample=false;var i=S.items.length-1;var snap=JSON.stringify(S.items.slice(0,i));S.sel=i;openEd(i,true);S.edSnap=snap;var f=$("f-cod");if(f)f.focus()});
$("b-paste").addEventListener("click",function(){$("pastebox").hidden=false;$("paste-ta").focus()});
$("b-imp").addEventListener("click",function(){$("file-in").click()});
$("b-reset").addEventListener("click",function(){pReset("E-mail");S.P=defaultParams();S.items=sampleItems();S.sel=0;S.sample=true;S.prop="0537/26";S.cli="Multi Pack Plas Ind. e Com. de Máquinas Ltda.";S.cond="28 DDL";fullRender();toast("Exemplo restaurado")});
$("b-blank").addEventListener("click",function(){pReset("Outro");S.items=[blankItem()];S.sel=0;S.sample=false;S.prop="";S.cli="";fullRender()});

$("file-in").addEventListener("change",function(e){handleFiles(e.target.files);e.target.value=""});
$("paste-x").addEventListener("click",function(){$("pastebox").hidden=true});
$("paste-go").addEventListener("click",function(){
  var list=parsePaste($("paste-ta").value);
  if(!list.length){toast("Não achei códigos no texto. Use uma linha por item, como: 28.12.23 - 20 peças");return}
  var items=list.map(itemFromPaste);
  if(S.sample){S.prop="";S.cli="";S.cond="28 DDL"}
  if(S.sample||!hasWork()){pStart();S.items=items}else S.items=S.items.filter(function(it){return it.desc||it.cod}).concat(items);
  S.sel=0;S.sample=false;$("pastebox").hidden=true;$("paste-ta").value="";fullRender();
  toast(items.length+" itens criados."+(S.hist?"":" Carregue o histórico para ver os últimos preços."));
});
$("askbox").addEventListener("click",function(e){
  var a=e.target.dataset&&e.target.dataset.ask;if(!a||!pending)return;
  if(a!=="no"){applyPedido(pending,a);if(a==="replace"&&pendingInbox){S.tab="itens";S.inboxId=pendingInbox;var dd=IB.docs.filter(function(x){return x.id===pendingInbox})[0];if(dd)S.sol=ibSol(dd);fullRender()}else if(a==="add"&&pendingInbox&&!S.sol){var d2=IB.docs.filter(function(x){return x.id===pendingInbox})[0];if(d2){S.sol=ibSol(d2);fullRender()}}toast("Pedido carregado: "+pending.items.length+" itens.");if(pendingInbox)ibMark(pendingInbox,"aberto")}
  pending=null;pendingInbox=null;$("askbox").hidden=true;
});
["dragenter","dragover"].forEach(function(ev){document.addEventListener(ev,function(e){
  if(e.dataTransfer&&[].indexOf.call(e.dataTransfer.types||[],"Files")>-1){e.preventDefault();document.body.classList.add("dragging")}})});
["dragleave","drop"].forEach(function(ev){document.addEventListener(ev,function(e){
  if(ev==="dragleave"&&e.relatedTarget)return;
  document.body.classList.remove("dragging");
  if(ev==="drop"){e.preventDefault();if(e.dataTransfer&&e.dataTransfer.files&&e.dataTransfer.files.length)handleFiles(e.dataTransfer.files)}})});


/* ---------- preenchimento inteligente ---------- */
function nomeDe(d){return String(d||"").split(/\s*-?\s*DES\.?\s*:/i)[0].replace(/[\s\-(]+$/,"").trim()}
function dwgDe(d){var m=String(d||"").match(/DES\.?:?\s*:?\s*\.*([A-Za-z]{0,3}[0-9][0-9A-Za-z.\-\/]*[0-9])/i);return m?m[1]:""}
function fillDL(id,rows){var d=$(id);if(d)d.innerHTML=rows.map(function(r){return'<option value="'+esc(r[0])+'" label="'+esc(r[1])+'">'}).join("")}
function cliList(){
  var m={};
  (S.P.condcli||[]).forEach(function(r){var i=r.indexOf("=");if(i>0)m[r.slice(0,i).trim()]=1});
  (PR.list||[]).forEach(function(d){if(d.cliente)m[String(d.cliente).trim()]=1});
  return Object.keys(m).sort();
}
function smartList(kind,q){
  var H=S.hist;if(!H)return;q=String(q||"").trim().toUpperCase();if(q.length<2){fillDL(kind==="cod"?"dl-cod":"dl-desc",[]);return}
  var out=[],k;
  for(k in H.map){
    var e=H.map[k];
    if(kind==="cod"){if(k.indexOf(q)===0||(q.length>=4&&k.indexOf(q)>-1))out.push([k,nomeDe(e.desc),e.lastMs||0])}
    else{var nm=nomeDe(e.desc).toUpperCase();if(nm.indexOf(q)>-1)out.push([nomeDe(e.desc),k,e.lastMs||0])}
  }
  out.sort(function(a,b){return b[2]-a[2]});
  var seen={},rows=[];out.forEach(function(r){var key=r[0]+"|"+r[1];if(!seen[key]&&rows.length<25){seen[key]=1;rows.push(r)}});
  fillDL(kind==="cod"?"dl-cod":"dl-desc",rows);
}
function smartFill(field){
  var it=cur(),H=S.hist;if(!it||!H)return;
  var got=[],e=null,code="";
  function setv(k,id,v){if(v&&!String(it[k]||"").trim()){it[k]=v;var el=$(id);if(el)el.value=v;got.push(k)}}
  if(field==="cod"){code=String(it.cod||"").trim().toUpperCase();e=H.map[code]}
  else if(field==="dwg"&&!String(it.cod||"").trim()){var dk=dwgKey(it.dwg),ix=dwgIndex(H);if(dk&&ix[dk]){code=ix[dk];e=H.map[code]}}
  else if(field==="desc"&&!String(it.cod||"").trim()){
    var q=String(it.desc||"").trim().toUpperCase(),hits=[];
    if(q.length>=4)for(var k in H.map){if(nomeDe(H.map[k].desc).toUpperCase()===q)hits.push(k)}
    if(hits.length){hits.sort(function(a,b){return(H.map[b].lastMs||0)-(H.map[a].lastMs||0)});code=hits[0];e=H.map[code]}
  }
  if(!e)return;
  if(field!=="cod")setv("cod","f-cod",code);
  setv("desc","f-desc",nomeDe(e.desc));
  setv("dwg","f-dwg",dwgDe(e.desc));
  if(got.length){toast("Preenchido pelo histórico: "+got.map(function(g){return{cod:"código",desc:"descrição",dwg:"desenho"}[g]}).join(", ")+". Confira.");refreshAll()}
}
function onEdit(e){
  var t=e.target,it=cur();if(!it)return;
  if(t.dataset.f){var k=t.dataset.f;it[k]=t.dataset.num?+t.value:t.value;
    if(k==="mat"&&!n0(it.cd)){var sf=shapeFromForm((S.P.mat[it.mat]||{}).f);if(sf>=0){it.forma=sf;$("f-forma").value=String(sf)}}}
  else if(t.id==="mar-in"){S.mar=t.value.trim()}
  else if(t.dataset.o!==undefined){ensureTr(it);var ox=it.os[+t.dataset.o];if(!ox)return;ox[t.dataset.ok]=t.value}
  else if(t.dataset.x!==undefined){
    var x=(it.ex||[])[+t.dataset.x];if(!x)return;var xk=t.dataset.xk;x[xk]=t.dataset.num?+t.value:t.value;
    if(xk==="mat"&&!n0(x.cd)){var sf2=shapeFromForm((S.P.mat[x.mat]||{}).f);if(sf2>=0){x.forma=sf2;$("xforma-"+t.dataset.x).value=String(sf2)}}}
  else if(t.dataset.m!==undefined){ensureOps(it);it.t[+t.dataset.m][+t.dataset.k]=t.value}
  else if(t.dataset.flag){it.f[t.dataset.flag]=t.checked}
  else return;
  if(t.id==="f-cod")smartList("cod",t.value);else if(t.id==="f-desc")smartList("desc",t.value);
  var kk=t.dataset.f||t.dataset.xk;
  if(["cd","c2","c3","cl","forma","mat"].indexOf(kk)>-1){
    if(t.dataset.x!==undefined){var xo=(it.ex||[])[+t.dataset.x];if(xo)autoPb(xo,"xpb-"+t.dataset.x)}
    else autoPb(it,"f-pb");
  }
  refreshAll();
}
$("editor").addEventListener("input",onEdit);
$("editor").addEventListener("change",function(e){
  var t=e.target,it=cur();if(!it)return;
  if(t.id==="f-cod")smartFill("cod");else if(t.id==="f-dwg")smartFill("dwg");else if(t.id==="f-desc")smartFill("desc");
  if(t.type==="checkbox"){onEdit(e);return}
  if(t.dataset.trn!==undefined){
    ensureTr(it);var rr=+t.dataset.trn,P2=S.P,q2=t.value.trim().toLowerCase(),ix=-1;
    var cd=P2.terc.map(function(m,i){return i}).filter(function(i){return i>0});
    ix=cd.filter(function(i){return P2.terc[i].n.toLowerCase()===q2})[0];
    if(ix==null){var pt=cd.filter(function(i){return q2&&P2.terc[i].n.toLowerCase().indexOf(q2)>-1});ix=pt.length===1?pt[0]:-1}
    if(ix>0&&it.trs.some(function(o,k){return k!==rr&&o===ix})){toast("Esse tratamento já está na lista.");ix=-1}
    it.trs[rr]=ix>0?ix:-1;syncTerc(it);
    setTimeout(function(){renderTr(it);refreshAll()},0);
    if(ix<0&&q2)toast("Não achei esse tratamento. Escolha um da lista.");
    return;
  }
  if(t.dataset.opn!==undefined){
    var r=+t.dataset.opn,kind=t.list&&t.list.id==="dl-ext"?"ext":"int",P=S.P,q=t.value.trim().toLowerCase(),idx=-1;
    var cand=P.maq.map(function(m,i){return i}).filter(function(i){return!!P.maq[i].ext===(kind==="ext")});
    idx=cand.filter(function(i){return P.maq[i].n.toLowerCase()===q})[0];
    if(idx==null){var part=cand.filter(function(i){return q&&P.maq[i].n.toLowerCase().indexOf(q)>-1});idx=part.length===1?part[0]:-1}
    if(idx>=0&&it.ops.some(function(o,k){return k!==r&&o===idx})){toast("Essa operação já está na lista. Altere os tempos na linha existente.");idx=-1}
    var old=it.ops[r];if(old>=0&&old!==idx)it.t[old]=["",""];
    it.ops[r]=idx>=0?idx:(kind==="ext"?-2:-1);
    if(idx>=0&&P.maq[idx].pp&&!String(it.t[idx][1]||"")){var bt=brutoTot(it);it.t[idx]=["",P.maq[idx].kg?(bt>0?fmtKg(bt):""):"1"]}
    setTimeout(function(){renderOps(it);refreshAll()},0);
    if(idx<0&&q)toast("Não achei essa operação. Escolha uma da lista.");
  }
});
$("editor").addEventListener("click",function(e){
  var it=cur(),id=e.target.id;if(!it)return;
  if(e.target.closest&&e.target.closest("[data-et]")){S.etab=e.target.closest("[data-et]").dataset.et;renderEtabs(it,calc(it));window.scrollTo&&0;return}
  if(e.target.dataset.etgo){var ix=ETABS.map(function(t){return t[0]}).indexOf(S.etab||"dados")+(+e.target.dataset.etgo);if(ix>=0&&ix<ETABS.length){S.etab=ETABS[ix][0];renderEtabs(it,calc(it));var ed=$("editor");if(ed.scrollIntoView)ed.scrollIntoView({block:"start"})}return}
  if(id==="use-bruto"){var kg=rawKg(it).kg;if(kg>0){it.pb=nf(kg,2);$("f-pb").value=it.pb;refreshAll()}}
  else if(id==="op-add-int"||id==="op-add-ext"){ensureOps(it);it.ops.push(id==="op-add-ext"?-2:-1);renderOps(it);var ins=document.querySelectorAll("#ops-"+(id==="op-add-ext"?"ext":"int")+" [data-opn]");if(ins.length)ins[ins.length-1].focus()}
  else if(e.target.dataset.opdel!==undefined){var r=+e.target.dataset.opdel;askDel("Remover esta operação?","Os tempos lançados nela serão apagados.",function(){ensureOps(it);var oi=it.ops[r];if(oi>=0)it.t[oi]=["",""];it.ops.splice(r,1);renderOps(it);refreshAll()})}
  else if(id==="tr-add"){ensureTr(it);it.trs.push(-1);renderTr(it);var ti2=document.querySelectorAll("#trs [data-trn]");if(ti2.length)ti2[ti2.length-1].focus()}
  else if(e.target.dataset.trdel!==undefined){var r2=+e.target.dataset.trdel;askDel("Remover este tratamento?","",function(){ensureTr(it);it.trs.splice(r2,1);syncTerc(it);renderTr(it);refreshAll()})}
  else if(id==="os-add"){ensureTr(it);it.os.push({d:"",v:""});renderTr(it);var oi2=document.querySelectorAll("#oss [data-o]");if(oi2.length)oi2[oi2.length-2].focus()}
  else if(e.target.dataset.osdel!==undefined){var r3=+e.target.dataset.osdel;askDel("Remover este serviço?","",function(){ensureTr(it);it.os.splice(r3,1);renderTr(it);refreshAll()})}
  else if(id==="xadd"){if(!it.ex)it.ex=[];var nx=blankEx(),sf3=shapeFromForm((S.P.mat[0]||{}).f);it.ex.push(nx);renderExtras(it);refreshAll()}
  else if(e.target.dataset.xdel!==undefined){var r4=+e.target.dataset.xdel;askDel("Remover este custo extra?","",function(){it.ex.splice(r4,1);renderExtras(it);refreshAll()})}
  else if(e.target.dataset.xuse!==undefined){var xi=+e.target.dataset.xuse,xx=it.ex[xi],xkg=rawKg(xx).kg;if(xkg>0){xx.pb=nf(xkg,2);var pe=$("xpb-"+xi);if(pe)pe.value=xx.pb;refreshAll()}}
  else if(id==="use-hist"){it.preco="";it.modo="hist";$("f-preco").value="";refreshAll();toast("Usando o último preço")}
  else if(id==="use-calc"){it.preco="";it.modo="calc";$("f-preco").value="";refreshAll();toast("Usando o preço calculado")}
  else if(id==="dup"){var c=JSON.parse(JSON.stringify(it));c.id="i"+Date.now();S.items.splice(S.sel+1,0,c);S.sel++;fullRender();toast("Item duplicado")}
  else if(id==="del"){
    var k0=S.sel;askDel("Excluir este item?","Item "+(k0+1)+". Esta ação não pode ser desfeita.",function(){S.items.splice(k0,1);if(!S.items.length)S.items=[blankItem()];S.sel=Math.max(0,Math.min(k0,S.items.length-1));closeEd(true);fullRender();toast("Item excluído.")})
  }
});
$("params").addEventListener("input",function(e){
  if(e.target.dataset.pe){var kk=e.target.dataset.pe.split(".");S.P.emps=S.P.emps||{};(S.P.emps[kk[0]]=S.P.emps[kk[0]]||{})[kk[1]]=e.target.value;save();return}
});
$("params").addEventListener("change",function(e){
  var k=e.target.dataset.pelogo;if(!k||!e.target.files||!e.target.files[0])return;
  var f=e.target.files[0],rd=new FileReader();
  rd.onload=function(){var im=new Image();im.onload=function(){
    var mw=600,sc=Math.min(1,mw/im.width),w=Math.max(1,Math.round(im.width*sc)),h=Math.max(1,Math.round(im.height*sc));
    var c=document.createElement("canvas");c.width=w;c.height=h;var x=c.getContext("2d");
    x.fillStyle="#fff";x.fillRect(0,0,w,h);x.drawImage(im,0,0,w,h);
    var jp=c.toDataURL("image/jpeg",0.92).split(",")[1];
    S.P.emps=S.P.emps||{};S.P.emps[k]=S.P.emps[k]||{};
    S.P.emps[k].logoPng=c.toDataURL("image/png");S.P.emps[k].logoJpg=jp;S.P.emps[k].jw=w;S.P.emps[k].jh=h;
    applyEmp();renderParams();save();toast("Logo da "+empData(k).nome+" atualizado.");
  };im.onerror=function(){toast("Não consegui ler essa imagem.")};im.src=rd.result};
  rd.readAsDataURL(f);
});
$("params").addEventListener("click",function(e){
  var k=e.target.dataset&&e.target.dataset.peres;if(!k)return;
  if(S.P.emps&&S.P.emps[k]){delete S.P.emps[k].logoPng;delete S.P.emps[k].logoJpg;delete S.P.emps[k].jw;delete S.P.emps[k].jh}
  applyEmp();renderParams();save();toast("Logo original restaurado.");
});
$("params").addEventListener("input",function(e){
  if(e.target.dataset.pcc!==undefined){S.P.condcli=e.target.value.split("\n").map(function(x){return x.trim()}).filter(Boolean);save();return}
  if(e.target.dataset.pc!==undefined){S.P.conds=e.target.value.split("\n").map(function(x){return x.trim()}).filter(Boolean);renderCond();save();return}
});
$("params").addEventListener("input",function(e){
  var p=e.target.dataset.p;if(!p)return;
  var v=parse(e.target.value);if(isNaN(v))v=0;
  var a=p.split(".");
  if(a.length===1)S.P[a[0]]=v;else S.P[a[0]][+a[1]][a[2]]=v;
  renderSummary();renderList();refreshEditor();save();
});
$("params").addEventListener("input",function(e){
  var p=e.target.dataset.pt;if(!p)return;
  var a=p.split(".");S.P[a[0]][+a[1]][a[2]]=e.target.value;
  renderList();save();
});
$("params").addEventListener("change",function(e){if(e.target.dataset.pt){buildEditor();refreshAll()}});
$("params").addEventListener("click",function(e){
  if(e.target.id==="mat-add"){
    S.P.mat.push({n:"Novo material",f:"Barra redonda",r:0,d:7.85});
    fullRender();setTimeout(function(){var ins=document.querySelectorAll('[data-pt$=".n"]');if(ins.length)ins[ins.length-1].select()},0);return;
  }
  var dm=e.target.dataset&&e.target.dataset.delmat;
  if(dm!==undefined&&dm!==""){
    var i=+dm;
    if(S.P.mat.length<=1){toast("Precisa restar ao menos um material.");return}
    askDel("Remover este material?",(S.P.mat[i]&&S.P.mat[i].n||"Material")+". Os itens que usam ele passam para o primeiro material.",function(){
      S.P.mat.splice(i,1);
      S.items.forEach(function(it){if(it.mat===i)it.mat=0;else if(it.mat>i)it.mat--});
      fullRender();toast("Material removido")});return;
  }
  if(e.target.id!=="hist-clear")return;
  askDel("Apagar o histórico de preços?","Remove o histórico carregado neste navegador. Os preços antigos deixam de aparecer nos itens.",function(){S.hist=null;try{localStorage.removeItem(LSH)}catch(x){}renderStatus();renderParams();refreshAll();toast("Histórico apagado")})
});
document.addEventListener("click",function(e){
  if(e.target.id!=="copy")return;
  var ta=$("mail"),txt=ta.value;
  function fallback(){ta.focus();ta.select();toast("Texto selecionado: use Ctrl+C para copiar")}
  try{navigator.clipboard.writeText(txt).then(function(){toast("Texto copiado")},fallback)}catch(err){fallback()}
});

/* ---------- caixa de entrada (pedidos preparados fora da Mesa; banco de dados do artefato) ---------- */
var IB={col:null,docs:[]};
function ibWhen(d){
  var ms=+d.criado;if(!ms||!isFinite(ms))return d.recebido||"";
  var t=new Date(ms),n=new Date(),same=t.toDateString()===n.toDateString();
  return same?"hoje "+t.toLocaleTimeString("pt-BR",{hour:"2-digit",minute:"2-digit"}):t.toLocaleDateString("pt-BR",{day:"2-digit",month:"2-digit"})+" "+t.toLocaleTimeString("pt-BR",{hour:"2-digit",minute:"2-digit"});
}
function ibRender(){
  if(S.tab==="ini")renderDash();
  pcBadges();
  var box=$("inbox");if(!IB.col){box.hidden=true;return}
  var list=IB.docs.filter(function(d){return d.status!=="descartado"});
  if(!list.length){box.hidden=true;return}
  list.sort(function(a,b){return (a.status==="novo"?0:1)-(b.status==="novo"?0:1)||(b.criado||0)-(a.criado||0)});
  var nNovo=list.filter(function(d){return d.status==="novo"}).length;
  box.hidden=false;
  var wasOpen=!!(box.querySelector("details")&&box.querySelector("details").open);
  function row(d){
    var its=d.itens||[],done=d.status!=="novo";
    return'<div class="gm'+(done?' done':' unread')+'"><span class="gm-dot" aria-hidden="true"></span>'+
      '<span class="gm-c">'+esc(d.cliente||"Cliente?")+'</span>'+
      '<span class="gm-s">'+esc(ibPrev(d))+'</span>'+
      '<span class="gm-t">'+esc(ibWhen(d))+'</span>'+
      '<span class="gm-a">'+ibtn("open",done?"Abrir de novo":"Abrir",'data-ib="open" data-id="'+esc(d.id)+'"',done?"":"pri")+ibtn("trash",done?"Remover":"Descartar",'data-ib="del" data-id="'+esc(d.id)+'"',"danger")+'</span></div>';
  }
  var novos=list.filter(function(d){return d.status==="novo"}),feitos=list.filter(function(d){return d.status!=="novo"});
  box.innerHTML='<h3>Caixa de entrada · '+(nNovo?nNovo+(nNovo===1?' pedido pendente':' pedidos pendentes'):'nenhum pedido pendente')+'</h3>'+novos.map(row).join("")+
    (feitos.length?'<details class="ib-done"'+(wasOpen?' open':'')+'><summary>Já tratados ('+feitos.length+')</summary>'+feitos.map(row).join("")+'</details>':'');
}
function ibSol(d){
  var base=d.solicitacao||d.assunto||"",ords=[];
  (d.itens||[]).forEach(function(x){var o=String(x.ordem||"").trim();if(o&&ords.indexOf(o)<0)ords.push(o)});
  var oc=(ords.length&&ords.length<=3&&base.indexOf(ords[0])<0)?"ordem "+ords.join(", "):"";
  return[base,oc,d.recebido?"recebida em "+d.recebido:""].filter(Boolean).join(" · ");
}
function ibMark(id,st){
  if(!IB.col)return;
  IB.col.doc(id).update({status:st,tratado:Date.now()}).catch(function(){toast("Não consegui atualizar a caixa de entrada.")});
}
function ibPedido(d){
  return{cli:d.cliente||"",tabela:true,items:(d.itens||[]).map(function(x){
    return{ordem:x.ordem||"",cod:String(x.cod||"").toUpperCase(),qtd:isFinite(+x.qtd)&&+x.qtd>0?+x.qtd:1,ent:x.entrega?toDay(x.entrega):NaN,name:x.descricao||"",dwg:x.desenho||"",rev:x.revisao||"",desc:""}
  })};
}
$("inbox").addEventListener("click",function(e){
  var b=e.target.closest("[data-ib]");if(!b)return;
  var id=b.dataset.id,d=IB.docs.filter(function(x){return x.id===id})[0];if(!d)return;
  if(b.dataset.ib==="del"){askDel("Descartar este pedido da caixa de entrada?",(d.cliente||"Cliente")+" · "+ibPrev(d)+".",function(){ibMark(id,"descartado");toast("Pedido descartado.")});return}
  if(d.pid&&PR.db&&PR.list.some(function(x){return x.id===d.pid})){ibMark(id,"aberto");pOpen(d.pid);return}
  var p=ibPedido(d);if(!p.items.length){toast("Este pedido não tem itens.");return}
  S.tab="itens";applyPedido(p,"replace");S.inboxId=id;S.origem="E-mail";S.sol=ibSol(d);if(d.proposta&&!S.prop){S.prop=d.proposta}fullRender();ibMark(id,"aberto");toast("Nova proposta aberta com "+p.items.length+(p.items.length===1?" item.":" itens."))
});
if(window.claude&&claude.use){
  claude.use("db").then(function(db){
    if(!db)return;
    PR.db=db;pSub();
    var hAt=0;
    db.collection("historico").onSnapshot(function(snap){
      var m=null,parts={};
      snap.docs.forEach(function(x){if(x.id==="meta")m=x.data();else parts[x.id]=x.data()});
      if(!m||!m.parts||m.at===hAt)return;
      var map={};
      for(var i=0;i<m.parts;i++){var p=parts["p"+i];if(!p||!p.map)return;for(var k in p.map)map[k]=p.map[k]}
      hAt=m.at;
      if(S.hist&&S.hist.meta&&(S.hist.meta.at||0)>m.at)return;
      S.hist={meta:{file:m.file,at:m.at,lines:m.lines,codes:m.codes,first:m.first,last:m.last},map:map};
      renderStatus();renderParamsIfOpen();refreshAll();
    },function(){});
    IB.col=db.collection("inbox");
    IB.col.onSnapshot(function(snap){
      IB.docs=snap.docs.map(function(x){var o=x.data()||{};var c={};for(var k in o)c[k]=o[k];c.id=x.id;return c});
      ibRender();
    },function(){IB.col=null;ibRender()});
  }).catch(function(){});
}

/* ---------- propostas salvas (banco do artefato): ID sequencial, busca e "Novo" ---------- */
var STATUS=["Em elaboração","Fechado"];
var ORIGENS=["E-mail","Manual"];
var PR={db:null,list:[],t:null,dirty:false,cur:null};
function rid(){return Math.random().toString(36).slice(2,8)+Date.now().toString(36)}
function pad(n,k){n=String(n);while(n.length<k)n="0"+n;return n}
if(!S.sid)S.sid=rid();
function fillSel(id,arr,first){var el=$(id);el.innerHTML=(first?'<option value="">'+first+'</option>':'')+arr.map(function(x){return'<option>'+esc(x)+'</option>'}).join("")}
fillSel("pf-st",STATUS,"Todas as situações");
function showId(){
  $("pid-badge").textContent=S.sample?"Exemplo (não é salvo)":(S.num?"Rascunho "+S.num:(PR.db?"Rascunho: gerando número…":"Banco indisponível: rascunho sem número"));
}
function pStart(){if(S.sample||S.pid||S.cli||hasWork())pReset("E-mail")}
function pReset(origem){
  S.tab="itens";
  pFlush();
  S.mar="";S.sol="";S.force=false;S.fechado=0;S.pid="";S.num="";S.sid=rid();S.criado=0;S.status=STATUS[0];S.origem=origem||ORIGENS[0];S.inboxId="";S.inboxLinked=false;
}
function pNext(){
  var ano=new Date().getFullYear(),ref=PR.db.doc("config/seq-"+ano),holder=rid();
  function tryAcq(k){
    return ref.acquire({holder:holder,ttlMs:8000}).then(function(r){
      if(!r.acquired){if(k>8)throw new Error("ocupado");return new Promise(function(ok){setTimeout(ok,500)}).then(function(){return tryAcq(k+1)})}
      return ref.get().then(function(sn){
        var n=((sn.exists&&sn.data().n)||0)+1;
        return ref.set({n:n}).then(function(){return{n:n,ano:ano}});
      });
    });
  }
  return tryAcq(0);
}
function pTotal(){var t=0;S.items.forEach(function(it){var c=calc(it);if(c.ok)t+=c.total});return t}
function pWorth(){return !S.sample&&(S.force||hasWork()||String(S.cli||"").trim())}
function pQueue(){
  if(!PR.db||!pWorth())return;
  PR.dirty=true;clearTimeout(PR.t);PR.t=setTimeout(pSave,2500);
}
function pFlush(){clearTimeout(PR.t);if(PR.dirty&&PR.db&&pWorth())return pSave();PR.dirty=false;return Promise.resolve()}
function codesOf(items,sol){
  var a=[],b=[];items.forEach(function(it){a.push(it.cod||"");b.push([it.dwg,it.desc].join(" "))});
  return (a.join(" ")+" "+(sol||"")+" "+b.join(" ")).replace(/\s+/g," ").slice(0,3500);
}
function pSave(){
  clearTimeout(PR.t);PR.dirty=false;
  var snap={sid:S.sid,pid:S.pid,num:S.num,criado:S.criado,
    items:JSON.parse(JSON.stringify(S.items)),prop:S.prop||"",cli:S.cli||"",cond:S.cond||"",mar:S.mar||"",sol:S.sol||"",
    status:S.status||STATUS[0],origem:S.origem||ORIGENS[0],inboxId:S.inboxId||"",total:pTotal(),v:S.v,emp:empKey(),
    codigos:codesOf(S.items,S.sol),cv:2};
  PR.cur=(PR.cur||Promise.resolve()).then(function(){return pDoSave(snap)});
  return PR.cur;
}
function pDoSave(snap){
  var p=Promise.resolve();
  if(!snap.pid&&S.sid===snap.sid&&S.pid){snap.pid=S.pid;snap.num=S.num;snap.criado=S.criado}
  if(!snap.pid){
    p=pNext().then(function(r){
      snap.pid="mx-"+pad(r.ano%100,2)+"-"+pad(r.n,4);snap.num=empData(snap.emp).prefix+"-"+pad(r.n,4)+"/"+pad(r.ano%100,2);snap.criado=Date.now();
      if(S.sid===snap.sid){S.pid=snap.pid;S.num=snap.num;S.criado=snap.criado;lsSave();showId()}
    });
  }
  return p.then(function(){
    var sum={id:snap.pid,num:snap.num,cliente:snap.cli,proposta:snap.prop,itens:snap.items.length,total:snap.total,status:snap.status,origem:snap.origem,
      criado:snap.criado||Date.now(),atualizado:Date.now(),inboxId:snap.inboxId,codigos:snap.codigos,cv:2,emp:snap.emp};
    return PR.db.doc("propostas/"+snap.pid).set(sum).then(function(){
      return PR.db.doc("propostas_dados/"+snap.pid).set({items:snap.items,prop:snap.prop,cli:snap.cli,cond:snap.cond,mar:snap.mar||"",sol:snap.sol||"",v:snap.v,emp:snap.emp});
    }).then(function(){
      if(snap.inboxId&&S.sid===snap.sid&&!S.inboxLinked){S.inboxLinked=true;return PR.db.doc("inbox/"+snap.inboxId).update({pid:snap.pid,num:snap.num}).catch(function(){})}
    });
  }).catch(function(e){toast("Não consegui salvar o rascunho no banco. Ele continua guardado neste navegador.")});
}
var BF=false;
function pBackfill(){
  if(BF)return;var old=PR.list.filter(function(d){return d.cv!==2});if(!old.length)return;BF=true;
  var i=0;(function nx(){
    if(i>=old.length)return;var d=old[i++];
    PR.db.doc("propostas_dados/"+d.id).get().then(function(sn){
      if(!sn.exists)return;var o=sn.data()||{};
      return PR.db.doc("propostas/"+d.id).update({codigos:codesOf(o.items||[],o.sol),cv:2});
    }).catch(function(){}).then(function(){setTimeout(nx,60)});
  })();
}
function pSub(){
  PR.db.collection("propostas").orderBy("atualizado","desc").limit(300).onSnapshot(function(sn){
    PR.list=sn.docs.map(function(x){var o=x.data()||{},c={};for(var k in o)c[k]=o[k];c.id=x.id;return c});
    pRender();if(S.tab==="ini")renderDash();
    pBackfill();
  },function(){});
  showId();
}

var DASH={emp:""};
function rankHtml(L){
  var m={};L.forEach(function(d){var k=String(d.cliente||"Sem cliente").trim()||"Sem cliente";var o=m[k]||(m[k]={n:0,t:0});o.n++;o.t+=+d.total||0});
  var a=Object.keys(m).map(function(k){return{k:k,n:m[k].n,t:m[k].t}}).sort(function(x,y){return y.n-x.n||y.t-x.t}).slice(0,5);
  if(!a.length)return'<div class="hint">Ainda não há propostas.</div>';
  var mx=a[0].n;
  return a.map(function(x){var ini=x.k.split(/\s+/).slice(0,2).map(function(w){return w[0]||""}).join("").toUpperCase();
    return'<div class="rk"><div class="av">'+esc(ini)+'</div><div class="nm">'+esc(x.k)+'<small>'+(x.t?brl(x.t):"sem valor lançado")+'</small></div><div class="bar2"><i style="width:'+Math.round(x.n/mx*100)+'%"></i></div><div class="r">'+x.n+(x.n===1?' proposta':' propostas')+'</div></div>'}).join("");
}
function funnelHtml(a,b,c){
  var mx=Math.max(a,b,c,1);
  function l(t,n,col){return'<div class="l"><span>'+t+'</span><div class="bar2"><i style="width:'+Math.round(n/mx*100)+'%'+(col?';background:'+col:'')+'"></i></div><b>'+n+'</b></div>'}
  return'<div class="fn">'+l("Solicitações novas",a)+l("Em elaboração",b)+l("Em análise",c,"var(--good)")+'</div>';
}
function monthChart(L){
  var now=new Date(),ms=[],i;
  for(i=5;i>=0;i--){var d=new Date(now.getFullYear(),now.getMonth()-i,1);ms.push({y:d.getFullYear(),m:d.getMonth(),n:0,t:0})}
  L.forEach(function(x){var t=new Date(x.criado||x.atualizado||0);ms.forEach(function(b){if(b.y===t.getFullYear()&&b.m===t.getMonth()){b.n++;b.t+=+x.total||0}})});
  var mx=Math.max.apply(null,ms.map(function(b){return b.n}).concat([1])),W=360,H=96,bw=38,gap=(W-6*bw)/7,out='<svg viewBox="0 0 '+W+' '+(H+34)+'" width="100%" role="img" aria-label="Propostas por mês">';
  [0,.5,1].forEach(function(f){var y=H-f*(H-24);out+='<line x1="0" x2="'+W+'" y1="'+y+'" y2="'+y+'" stroke="var(--line)"/>'});
  ms.forEach(function(b,k){var h=Math.round(b.n/mx*(H-30)),x=gap+k*(bw+gap),y=H-h;
    out+='<rect x="'+x+'" y="'+y+'" width="'+bw+'" height="'+Math.max(h,2)+'" rx="8" fill="var(--accent)"><title>'+b.n+' propostas · '+brl(b.t)+'</title></rect>'+
      '<text x="'+(x+bw/2)+'" y="'+(y-6)+'" text-anchor="middle" font-size="13" font-weight="700" fill="var(--ink)">'+b.n+'</text>'+
      '<text x="'+(x+bw/2)+'" y="'+(H+20)+'" text-anchor="middle" font-size="12" fill="var(--muted)">'+["jan","fev","mar","abr","mai","jun","jul","ago","set","out","nov","dez"][b.m]+'</text>'});
  return out+'</svg>';
}
function donutHtml(L){
  var m={};L.forEach(function(d){var k=String(d.cliente||"Sem cliente").trim()||"Sem cliente";m[k]=(m[k]||0)+(+d.total||0)});
  var a=Object.keys(m).map(function(k){return{k:k,v:m[k]}}).filter(function(x){return x.v>0}).sort(function(x,y){return y.v-x.v});
  if(!a.length)return'<div class="hint">Ainda não há valores lançados nas propostas.</div>';
  var top=a.slice(0,5),rest=a.slice(5).reduce(function(t,x){return t+x.v},0);if(rest>0)top.push({k:"Outros",v:rest});
  var tot=top.reduce(function(t,x){return t+x.v},0),cols=["var(--accent)","var(--red)","#3DA9FC","#2EC4B6","#F4B942","#9AA3D1"],R=62,C=2*Math.PI*R,off=0,svg='<svg viewBox="0 0 160 160" width="150" height="150" role="img" aria-label="Valor por cliente"><g transform="rotate(-90 80 80)">';
  top.forEach(function(x,k){var len=x.v/tot*C;svg+='<circle cx="80" cy="80" r="'+R+'" fill="none" stroke="'+cols[k%cols.length]+'" stroke-width="26" stroke-dasharray="'+len+' '+(C-len)+'" stroke-dashoffset="'+(-off)+'"><title>'+esc(x.k)+': '+brl(x.v)+'</title></circle>';off+=len});
  svg+='</g></svg>';
  return'<div class="dn">'+svg+'<div class="dn-l">'+top.map(function(x,k){return'<div><i style="background:'+cols[k%cols.length]+'"></i><span>'+esc(x.k)+'</span><b>'+Math.round(x.v/tot*100)+'%</b></div>'}).join("")+'</div></div>';
}
function renderDash(){
  var box=$("dash");if(!box)return;
  var L=PR.list.filter(function(d){return !DASH.emp||(d.emp==="STAR"?"STAR":"MIX")===DASH.emp});
  var pend=IB.docs.filter(function(d){return d.status==="novo"});
  var ela=L.filter(function(d){return d.status!=="Fechado"}),fec=L.filter(function(d){return d.status==="Fechado"});
  var mes=new Date();mes=new Date(mes.getFullYear(),mes.getMonth(),1).getTime();
  var fecMes=fec.filter(function(d){return (d.fechado||d.atualizado||0)>=mes});
  var soma=function(a){return a.reduce(function(t,d){return t+(+d.total||0)},0)};
  function dt(ms){return ms?new Date(ms).toLocaleDateString("pt-BR",{day:"2-digit",month:"2-digit"}):""}
  function prow(d){return'<div class="ib-row"><div class="ib-t"><b>'+esc(d.num||d.id)+' · '+esc(d.cliente||"Sem cliente")+'</b><span class="emp-tag" data-e="'+(d.emp==="STAR"?"STAR":"MIX")+'">'+(d.emp==="STAR"?"STAR":"MIX")+'</span><span class="hint"> '+d.itens+(d.itens===1?' item':' itens')+' · '+brl(d.total||0)+' · '+dt(d.atualizado)+'</span></div><button class="btn sm" data-dp="'+esc(d.id)+'" type="button">Abrir</button></div>'}
  function grow(d){return'<div class="gm"><span class="gm-dot"></span><span class="gm-c">'+esc(d.num||d.id)+' · '+esc(d.cliente||"Sem cliente")+'</span><span class="gm-s">'+d.itens+(d.itens===1?' item':' itens')+(d.total?' · '+brl(d.total):'')+'</span><span class="gm-t">'+dt(d.atualizado)+'</span><span class="gm-a">'+ibtn("open","Abrir",'data-dp="'+esc(d.id)+'"',"pri")+'</span></div>'}
  var pendH=pend.length?pend.sort(function(a,b){return (b.criado||0)-(a.criado||0)}).map(function(d){var n=(d.itens||[]).length;return'<div class="gm unread"><span class="gm-dot"></span><span class="gm-c">'+esc(d.cliente||"Cliente?")+'</span><span class="gm-s">'+esc(ibPrev(d))+'</span><span class="gm-t">'+esc(ibWhen(d))+'</span><span class="gm-a">'+ibtn("open","Abrir",'data-di="'+esc(d.id)+'"',"pri")+ibtn("trash","Descartar",'data-dx="'+esc(d.id)+'"',"danger")+'</span></div>'}).join(""):'';
  var h='<div class="dh"><h2>Início</h2><div class="dflt" role="group" aria-label="Empresa">'+
    ["","MIX","STAR"].map(function(e){return'<button class="btn sm" data-de="'+e+'" aria-pressed="'+(DASH.emp===e)+'" type="button">'+(e||"Todas")+'</button>'}).join("")+
    '</div><div class="dflt"><button class="btn sm" id="d-filter" type="button">Filtrar propostas</button><button class="btn sm pri" id="d-new" type="button">+ Nova proposta</button></div></div>'+
    '<div class="kpis">'+
    '<div class="kpi'+(pend.length?' alert':'')+'"><div class="n">'+pend.length+'</div><div class="l">Pedidos novos na caixa de entrada</div></div>'+
    '<div class="kpi"><div class="n">'+ela.length+'</div><div class="l">Rascunhos em elaboração</div></div>'+
    '<div class="kpi"><div class="n">'+fecMes.length+'</div><div class="l">Em análise neste mês · '+brl(soma(fecMes))+'</div></div>'+
    '<div class="kpi"><div class="n">'+brl(soma(ela))+'</div><div class="l">Valor em elaboração</div></div></div>'+
    '<div class="dcols dc3"><div class="panel dbox"><h3>Propostas por mês</h3>'+monthChart(L)+'</div>'+
    '<div class="panel dbox"><h3>Funil</h3>'+funnelHtml(pend.length,ela.length,fec.length)+'</div>'+
    '<div class="panel dbox"><h3>Valor por cliente</h3>'+donutHtml(L)+'</div></div>'+
    '<div class="dcols"><div class="panel dbox"><h3>Pedidos novos (e-mail)</h3>'+(pendH||'<div class="hint">Nenhum pedido novo.</div>')+'</div>'+
    '<div class="panel dbox"><h3>Em elaboração'+(ela.length>5?' <small>5 de '+ela.length+' · use “Filtrar propostas”</small>':'')+'</h3>'+(ela.length?ela.slice(0,5).map(grow).join(""):'<div class="hint">Nenhum rascunho em aberto.</div>')+'</div></div>';
  box.innerHTML=h;
}
$("dash").addEventListener("click",function(e){
  var b=e.target.closest("button");if(!b)return;
  if(b.dataset.de!=null){DASH.emp=b.dataset.de;renderDash();return}
  if(b.dataset.dp){pOpen(b.dataset.dp);showTab("itens");return}
  if(b.dataset.dx){var y=document.querySelector('#inbox [data-ib="del"][data-id="'+b.dataset.dx+'"]');if(y){y.click();setTimeout(renderDash,300)}return}
  if(b.dataset.di){var x=document.querySelector('#inbox [data-ib="open"][data-id="'+b.dataset.di+'"]');if(x){x.click();showTab("itens")}return}
  if(b.id==="d-new"){showTab("itens");$("b-new").click();return}
  if(b.id==="d-filter"){showTab("sv");$("pf-q").focus();return}
  if(b.id==="d-cont"){showTab("itens");return}
});
var IC={
 open:'<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>',
 pdf:'<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 14h6M9 17h4"/></svg>',
 mail:'<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>',
 edit:'<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4zM13.5 6.5l4 4"/></svg>',
 trash:'<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg>'
};
function ibtn(ic,title,attrs,cls){return'<button type="button" class="btn sm ibn'+(cls?' '+cls:'')+'" title="'+esc(title)+'" aria-label="'+esc(title)+'" '+attrs+'>'+IC[ic]+'</button>'}
function stLabel(x){return x==="Fechado"?"Em análise":x}
function ibPrev(d){
  var n=(d.itens||[]).length,t=(n<10?"0"+n:String(n))+(n===1?" item":" itens");
  var base=String(d.solicitacao||d.assunto||d.proposta||""),m=base.match(/\d{4,}/);
  return t+(m?" · solicitação "+m[0]:(base?" · "+base.slice(0,34):""));
}
function pDelete(id){
  if(!PR.db)return;
  var cur=S.pid===id;
  if(cur){clearTimeout(PR.t);PR.dirty=false}
  var pr;try{pr=Promise.all([PR.db.doc("propostas/"+id).delete(),PR.db.doc("propostas_dados/"+id).delete()])}catch(e){pr=Promise.reject(e)}
  pr.then(function(){
    PR.list=PR.list.filter(function(x){return x.id!==id});
    if(cur){pReset("Manual");S.items=[blankItem()];S.sel=0;S.sample=false;S.prop="";S.cli="";S.cond="28 DDL";S.tab="sv";fullRender()}
    pRender();toast("Proposta excluída.");
  }).catch(function(e){toast("Não consegui excluir a proposta"+(e&&e.message?": "+e.message:"."))});
}
function pRender(){
  var box=$("pf-list");if(!box)return;
  pcBadges();
  var q=normTxt($("pf-q").value),em=$("pf-emp").value;
  var rows=PR.list.filter(function(d){
    if(em&&(d.emp==="STAR"?"STAR":"MIX")!==em)return false;
    if(!q)return true;
    return normTxt([d.num,d.cliente,d.proposta,d.codigos,d.status,d.origem].join(" ")).indexOf(q)>-1;
  }).sort(function(a,b){var x=String(a.id||""),y=String(b.id||"");return x<y?1:x>y?-1:0});
  if(!rows.length){box.innerHTML='<div class="hint" style="padding:14px">'+(PR.list.length?"Nenhuma proposta com esse filtro.":"Ainda não há propostas. Elas aparecem aqui assim que você começa a preencher.")+'</div>';return}
  box.innerHTML=rows.slice(0,150).map(function(d){
    var dt=d.atualizado?new Date(d.atualizado).toLocaleString("pt-BR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}):"";
    var e=d.emp==="STAR"?"STAR":"MIX",sx=d.status||"";
    return'<div class="pl-row'+(d.id===S.pid?' cur':'')+'" data-rid="'+esc(d.id)+'" title="Clique para abrir"><span class="pl-n"><b>'+esc(d.num||d.id)+'</b> <span class="emp-tag" data-e="'+e+'">'+e+'</span></span>'+
      '<span class="pl-c">'+esc(d.cliente||"Sem cliente")+'<small>'+(d.proposta?'Caprind '+esc(d.proposta):'sem nº Caprind')+'</small></span>'+
      '<span>'+d.itens+'</span><span class="pl-v">'+brl(d.total||0)+'</span>'+
      '<span><span class="st-pill" data-s="'+esc(sx)+'">'+esc(stLabel(sx))+'</span></span><span class="pl-t">'+esc(dt)+'</span>'+
      '<span class="pl-a">'+ibtn("pdf","Gerar PDF",'data-pa="pdf" data-pid="'+esc(d.id)+'"')+ibtn("mail","Enviar por e-mail",'data-pa="mail" data-pid="'+esc(d.id)+'"')+ibtn("trash","Excluir",'data-pa="del" data-pid="'+esc(d.id)+'"',"danger")+'</span></div>';
  }).join("")+(rows.length>150?'<div class="hint" style="padding:10px">Mostrando as 150 últimas. Use o filtro para achar as outras.</div>':'');
}
function pOpen(id,cb,stay){
  if(!PR.db)return;
  pFlush().then(function(){return PR.db.doc("propostas_dados/"+id).get()}).then(function(sn){
    if(!sn.exists){toast("Não achei os dados desse rascunho.");return}
    var d=sn.data(),sm=PR.list.filter(function(x){return x.id===id})[0]||{};
    S.sid=rid();S.items=JSON.parse(JSON.stringify(d.items||[]));if(!S.items.length)S.items=[blankItem()];S.items.forEach(fillRev);
    S.prop=d.prop||"";S.cli=d.cli||"";S.cond=d.cond||"28 DDL";S.mar=d.mar||"";S.sol=d.sol||"";S.sel=0;S.sample=false;S.emp=(d.emp||sm.emp)==="STAR"?"STAR":"MIX";
    S.pid=id;S.num=sm.num||"";S.criado=sm.criado||0;S.status=sm.status||STATUS[0];S.origem=sm.origem||ORIGENS[0];S.inboxId=sm.inboxId||"";S.inboxLinked=true;
    if(!stay)S.tab="itens";S.stdN=0;fullRender();clearTimeout(PR.t);PR.dirty=false;if(S.stdN){S.stdN=0;pQueue()}toast("Proposta "+(S.num||id)+" aberta.");if(cb)cb();
  }).catch(function(){toast("Não consegui abrir o rascunho.")});
}
["pf-q","pf-st","pf-emp"].forEach(function(id){$(id).addEventListener("input",function(){if(S.tab!=="sv")showTab("sv");else pRender()});$(id).addEventListener("change",pRender)});
$("pf-list").addEventListener("click",function(e){
  var b=e.target.closest("[data-pa]");
  if(!b){var r=e.target.closest("[data-rid]");if(r)pOpen(r.dataset.rid);return}
  var id=b.dataset.pid,a=b.dataset.pa,sm=PR.list.filter(function(x){return x.id===id})[0]||{};
  if(a==="pdf"){
    if(sm.status!=="Fechado"){toast("Conclua a proposta (Fechar rascunho) antes de gerar o PDF.");return}
    pOpen(id,function(){makePDF()},true)}
  else if(a==="mail")toast("Enviar por e-mail: em desenvolvimento");
  else if(a==="del"){
    askDel("Excluir a proposta "+(sm.num||"")+"?",(sm.cliente||"Sem cliente")+" · "+(sm.itens||0)+(sm.itens===1?" item":" itens")+". Esta ação não pode ser desfeita.",function(){pDelete(id)});
  }
});
$("b-save").addEventListener("click",function(){
  if(!PR.db){toast("Banco indisponível: a proposta está guardada só neste navegador.");return}
  if(!hasWork()){toast("Nada para salvar ainda.");return}
  S.force=true;pSave().then(function(){toast("Proposta "+(S.num||"")+" salva.");showTab("sv")});
});
function nbRender(){
  $("newbox").innerHTML='<div class="nb"><span>Novo rascunho: começar com</span><button class="btn sm" data-nstart="blank" type="button">Em branco</button><button class="btn sm" data-nstart="paste" type="button">Colar lista de códigos</button><button class="btn sm" data-nstart="file" type="button">Carregar arquivo do cliente</button><button class="btn sm" data-nstart="" type="button">Cancelar</button></div>';
}
$("b-new").addEventListener("click",function(){
  closeEd(true);
  pReset("Manual");S.force=true;
  S.items=[blankItem()];S.sel=0;S.sample=false;S.prop="";S.cli="";S.sol="";S.cond="28 DDL";
  fullRender();
  if(PR.db)pSave();
  var c=$("cli");if(c)c.focus();
});
$("newbox").addEventListener("click",function(e){
  var b=e.target.closest("[data-nstart]");if(!b)return;
  $("newbox").hidden=true;
  var k=b.dataset.nstart;if(!k)return;
  pReset("Manual");S.force=true;
  S.items=[blankItem()];S.sel=0;S.sample=false;S.prop="";S.cli="";S.cond="28 DDL";
  fullRender();
  if(PR.db)pSave();
  if(k==="paste"){$("pastebox").hidden=false;$("paste-ta").focus()}
  else if(k==="file"){$("file-in").click()}
  else $("cli").focus();
});

/* ---------- fechar rascunho e PDF ---------- */
function renderClose(){
  var closed=S.status==="Fechado";
  var n=S.items.filter(function(i){return i.desc||i.cod}).length;
  var sem=S.items.filter(function(i){return(i.desc||i.cod)&&!calc(i).ok}).length;
  $("cb-sum").innerHTML=n+(n===1?" item":" itens")+" · total "+brl(pTotal())+" · pagamento "+esc(S.cond||"")+(sem?' · <b style="color:var(--bad,#b3261e)">'+sem+(sem===1?" item sem preço":" itens sem preço")+'</b>':"");
  $("b-close").hidden=closed;$("b-pdf").hidden=!closed;$("b-reopen").hidden=!closed;
  $("cb-hint").textContent=closed?"Rascunho fechado"+(S.fechado?" em "+new Date(S.fechado).toLocaleString("pt-BR",{dateStyle:"short",timeStyle:"short"}):"")+". O PDF não traz custos nem margem. Se mudar algo, gere o PDF de novo.":"Depois de fechar, o botão Gerar PDF fica disponível.";
  var pn=$("prop-no");if(pn&&document.activeElement!==pn&&pn.value!==(S.prop||""))pn.value=S.prop||"";
}
$("prop-no").addEventListener("input",function(e){S.prop=e.target.value;save()});
$("b-close").addEventListener("click",function(){
  var ok=S.items.some(function(i){return(i.desc||i.cod)&&calc(i).ok});
  if(!ok){toast("Nenhum item com preço. Preencha ao menos um item antes de fechar.");return}
  S.status="Fechado";S.fechado=Date.now();S.force=true;renderClose();save();if(PR.db)pSave();
  toast("Rascunho fechado. Já pode gerar o PDF.");
});
$("b-reopen").addEventListener("click",function(){S.status=STATUS[0];S.fechado=0;renderClose();save();if(PR.db)pSave();toast("Rascunho reaberto.")});
function pdfClean(t){return String(t==null?"":t).replace(/[^\x20-\x7E -ÿ]/g," ").replace(/\s+/g," ").trim()}
var DLC=null;
if(window.claude&&claude.use){try{claude.use("downloads").then(function(d){DLC=d}).catch(function(){})}catch(e){}}
/* gerador de PDF mínimo (Helvetica, linhas, retângulos e uma imagem JPEG) */
var HW={r:[278, 278, 355, 556, 556, 889, 667, 191, 333, 333, 389, 584, 278, 333, 278, 278, 556, 556, 556, 556, 556, 556, 556, 556, 556, 556, 278, 278, 584, 584, 584, 556, 1015, 667, 667, 722, 722, 667, 611, 778, 722, 278, 500, 667, 556, 833, 722, 778, 667, 778, 722, 667, 611, 722, 667, 944, 667, 667, 611, 278, 278, 278, 469, 556, 333, 556, 556, 500, 556, 556, 278, 556, 556, 222, 222, 500, 222, 833, 556, 556, 556, 556, 333, 500, 278, 556, 500, 722, 500, 500, 500, 334, 260, 334, 584, 761, 556, 761, 222, 556, 333, 1000, 556, 556, 333, 1000, 667, 333, 1000, 761, 611, 761, 761, 222, 222, 333, 333, 350, 556, 1000, 333, 1000, 500, 333, 944, 761, 500, 667, 278, 333, 556, 556, 556, 556, 260, 556, 333, 737, 370, 556, 584, 333, 737, 333, 400, 584, 333, 333, 333, 556, 537, 278, 333, 333, 365, 556, 834, 834, 834, 611, 667, 667, 667, 667, 667, 667, 1000, 722, 667, 667, 667, 667, 278, 278, 278, 278, 722, 722, 778, 778, 778, 778, 778, 584, 778, 722, 722, 722, 722, 667, 667, 611, 556, 556, 556, 556, 556, 556, 889, 500, 556, 556, 556, 556, 278, 278, 278, 278, 556, 556, 556, 556, 556, 556, 556, 584, 611, 556, 556, 556, 556, 500, 556, 500],b:[278, 333, 474, 556, 556, 889, 722, 238, 333, 333, 389, 584, 278, 333, 278, 278, 556, 556, 556, 556, 556, 556, 556, 556, 556, 556, 333, 333, 584, 584, 584, 611, 975, 722, 722, 722, 722, 667, 611, 778, 722, 278, 556, 722, 611, 833, 722, 778, 667, 778, 722, 667, 611, 722, 667, 944, 667, 667, 611, 333, 278, 333, 584, 556, 333, 556, 611, 556, 611, 556, 333, 611, 611, 278, 278, 556, 278, 889, 611, 611, 611, 611, 389, 556, 333, 611, 556, 778, 556, 556, 500, 389, 280, 389, 584, 761, 556, 761, 278, 556, 500, 1000, 556, 556, 333, 1000, 667, 333, 1000, 761, 611, 761, 761, 278, 278, 500, 500, 350, 556, 1000, 333, 1000, 556, 333, 944, 761, 500, 667, 278, 333, 556, 556, 556, 556, 280, 556, 333, 737, 370, 556, 584, 333, 737, 333, 400, 584, 333, 333, 333, 611, 556, 278, 333, 333, 365, 556, 834, 834, 834, 611, 722, 722, 722, 722, 722, 722, 1000, 722, 667, 667, 667, 667, 278, 278, 278, 278, 722, 722, 778, 778, 778, 778, 778, 584, 778, 722, 722, 722, 722, 667, 667, 611, 556, 556, 556, 556, 556, 556, 889, 556, 556, 556, 556, 556, 278, 278, 278, 278, 611, 611, 611, 611, 611, 611, 611, 584, 611, 611, 611, 611, 611, 556, 611, 556]};
var LOGO_JPG="",LOGO_W=400,LOGO_H=182;
var MIX_JPG=LOGO_JPG,MIX_PNG=document.getElementById("logo").getAttribute("src");
var STAR_PNG="DATA",STAR_JPG="";
var EMP_DEF={
 MIX:{nome:"MIX Usinagem",prefix:"MX",razao:"J.P DA SILVA USINAGEM E FERRAMENTARIA ME",cnpj:"30.905.289/0001-59",ie:"353.440.035.113",end:"Rua Esmeralda Martini Paula, 309 - Comercial Vitória Martini - Indaiatuba/SP - CEP 13347-636",tel:"(19) 3801-0707",email:"contato.mixusinagem@gmail.com"},
 STAR:{nome:"STAR Tornearia",prefix:"ST",razao:"STAR TORNEARIA E USINAGEM LTDA",cnpj:"57.446.223/0001-02",ie:"353.644.670.118",end:"Alameda Mercúrio, 298 - Distrito Industrial American Park - Indaiatuba/SP - CEP 13347-662",tel:"(19) 3801-0707 / (19) 99928-2820",email:"contato@mixusinagem.com.br",jw:600,jh:218}
};
function empKey(){return S.emp==="STAR"?"STAR":"MIX"}
function empData(k){
  k=k||empKey();var d=EMP_DEF[k],o=(S.P&&S.P.emps&&S.P.emps[k])||{},r={};
  for(var a in d)r[a]=d[a];
  for(var b in o)if(o[b]!==""&&o[b]!=null)r[b]=o[b];
  r.k=k;r.logoPng=r.logoPng||(k==="STAR"?STAR_PNG:MIX_PNG);r.logoJpg=r.logoJpg||(k==="STAR"?STAR_JPG:MIX_JPG);r.jw=+r.jw||400;r.jh=+r.jh||182;
  return r;
}
function applyEmp(){
  var k=empKey(),e=empData(k);
  document.documentElement.setAttribute("data-emp",k);
  var lg=$("logo");if(lg.getAttribute("src")!==e.logoPng)lg.setAttribute("src",e.logoPng);lg.alt=e.nome;
  $("brand-eb").textContent=e.nome;$("cap-emp").textContent=e.nome;
  ["MIX","STAR"].forEach(function(x){var b=$("emp-"+x);if(b)b.setAttribute("aria-pressed",String(x===k))});
}
$("emp-MIX").parentNode.addEventListener("click",function(e){
  var b=e.target.closest("[data-emp]");if(!b||b.dataset.emp===empKey())return;
  S.emp=b.dataset.emp;applyEmp();
  if(S.num){var px=empData().prefix;S.num=S.num.replace(/^[A-Z]{2}-/,px+"-")}
  showId();renderProposal();renderParamsIfOpen();save();pQueue();toast("Empresa: "+empData().nome);
});

function PDFW(){this.pages=[[]];this.PT=72/25.4;this.H=210}
PDFW.prototype.tw=function(s,size,bold){var w=HW[bold?"b":"r"],t=0;for(var i=0;i<s.length;i++){var c=s.charCodeAt(i)-32;t+=(c>=0&&c<w.length?w[c]:556)}return t*size/1000/this.PT};
PDFW.prototype.wrap=function(s,maxw,size,bold){
  var words=String(s).split(" "),lines=[],cur="",me=this;
  words.forEach(function(w){
    while(me.tw(w,size,bold)>maxw&&w.length>1){var k=w.length-1;while(k>1&&me.tw(w.slice(0,k),size,bold)>maxw)k--;if(cur){lines.push(cur);cur=""}lines.push(w.slice(0,k));w=w.slice(k)}
    var t=cur?cur+" "+w:w;
    if(me.tw(t,size,bold)<=maxw||!cur)cur=t;else{lines.push(cur);cur=w}
  });
  if(cur||!lines.length)lines.push(cur);return lines;
};
PDFW.prototype.f=function(n){return(Math.round(n*100)/100).toString()};
PDFW.prototype.esc=function(s){var o="";for(var i=0;i<s.length;i++){var c=s.charCodeAt(i);if(c===40||c===41||c===92)o+="\\"+s[i];else if(c<32)o+=" ";else if(c>126){o+="\\"+("00"+c.toString(8)).slice(-3)}else o+=s[i]}return o};
PDFW.prototype.cur=function(){return this.pages[this.pages.length-1]};
PDFW.prototype.add=function(){this.pages.push([])};
PDFW.prototype.text=function(s,x,y,o){
  o=o||{};var size=o.size||9,bold=!!o.bold,g=o.gray==null?0:o.gray;s=String(s);
  if(o.align==="right")x-=this.tw(s,size,bold);else if(o.align==="center")x-=this.tw(s,size,bold)/2;
  this.cur().push(this.f(g)+" g BT /"+(bold?"F2":"F1")+" "+size+" Tf "+this.f(x*this.PT)+" "+this.f((this.H-y)*this.PT)+" Td ("+this.esc(s)+") Tj ET");
};
PDFW.prototype.line=function(x1,y1,x2,y2,g){this.cur().push(this.f(g==null?0.7:g)+" G 0.4 w "+this.f(x1*this.PT)+" "+this.f((this.H-y1)*this.PT)+" m "+this.f(x2*this.PT)+" "+this.f((this.H-y2)*this.PT)+" l S")};
PDFW.prototype.rect=function(x,y,w,h,g){this.cur().push(this.f(g)+" g "+this.f(x*this.PT)+" "+this.f((this.H-y-h)*this.PT)+" "+this.f(w*this.PT)+" "+this.f(h*this.PT)+" re f")};
PDFW.prototype.logo=function(x,y,w){var h=w*LOGO_H/LOGO_W;this.useLogo=true;this.cur().push("q "+this.f(w*this.PT)+" 0 0 "+this.f(h*this.PT)+" "+this.f(x*this.PT)+" "+this.f((this.H-y-h)*this.PT)+" cm /Im1 Do Q")};
PDFW.prototype.build=function(){
  var objs=[],np=this.pages.length;
  var img=this.useLogo?atob(LOGO_JPG):null;
  var firstPage=6+(img?1:0);
  var kids=[];for(var i=0;i<np;i++)kids.push((firstPage+i*2)+" 0 R");
  objs[1]="<< /Type /Catalog /Pages 2 0 R >>";
  objs[2]="<< /Type /Pages /Kids ["+kids.join(" ")+"] /Count "+np+" >>";
  objs[3]="<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>";
  objs[4]="<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>";
  objs[5]="<< /Producer (Orcamento MIX) >>";
  var res="<< /Font << /F1 3 0 R /F2 4 0 R >>"+(img?" /XObject << /Im1 6 0 R >>":"")+" >>";
  var raw={};
  if(img){raw[6]=img;objs[6]="<< /Type /XObject /Subtype /Image /Width "+LOGO_W+" /Height "+LOGO_H+" /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length "+img.length+" >>"}
  for(var p=0;p<np;p++){
    var pid=firstPage+p*2,cid=pid+1,st=this.pages[p].join("\n");
    objs[pid]="<< /Type /Page /Parent 2 0 R /MediaBox [0 0 841.89 595.28] /Resources "+res+" /Contents "+cid+" 0 R >>";
    objs[cid]="<< /Length "+st.length+" >>\nstream\n"+st+"\nendstream";
  }
  var out="%PDF-1.4\n%\xE2\xE3\xCF\xD3\n",offs=[];
  for(var n=1;n<objs.length;n++){
    offs[n]=out.length;
    if(raw[n])out+=n+" 0 obj\n"+objs[n]+"\nstream\n"+raw[n]+"\nendstream\nendobj\n";
    else out+=n+" 0 obj\n"+objs[n]+"\nendobj\n";
  }
  var xr=out.length;
  out+="xref\n0 "+objs.length+"\n0000000000 65535 f \n";
  for(var m=1;m<objs.length;m++)out+=("0000000000"+offs[m]).slice(-10)+" 00000 n \n";
  out+="trailer\n<< /Size "+objs.length+" /Root 1 0 R /Info 5 0 R >>\nstartxref\n"+xr+"\n%%EOF";
  var u=new Uint8Array(out.length);for(var k=0;k<out.length;k++)u[k]=out.charCodeAt(k)&255;
  return u;
};
function makePDF(){
  var P=new PDFW(),W=297,H=210,M=14,y=12,pg=1,E=empData();
  LOGO_JPG=E.logoJpg;LOGO_W=E.jw;LOGO_H=E.jh;
  P.logo(M,y,34);
  P.text(pdfClean(E.razao),M+39,y+5,{size:11,bold:true});
  var l2=[E.cnpj?"CNPJ "+E.cnpj:"",E.ie?"I.E. "+E.ie:""].filter(Boolean).join("   ");if(l2)P.text(pdfClean(l2),M+39,y+10,{size:8,gray:0.3});
  if(E.end)P.text(pdfClean(E.end),M+39,y+14,{size:8,gray:0.3});
  var l4=[E.tel,E.email].filter(Boolean).join("   ");if(l4)P.text(pdfClean(l4),M+39,y+18,{size:8,gray:0.3});
  P.text("RASCUNHO DE PROPOSTA",W-M,y+5,{size:14,bold:true,align:"right"});
  P.text(pdfClean(S.num||"sem número"),W-M,y+11,{size:12,bold:true,align:"right"});
  P.text("Emitido em "+new Date().toLocaleString("pt-BR",{dateStyle:"short",timeStyle:"short"}),W-M,y+16,{size:9,align:"right"});
  y=36;P.line(M,y,W-M,y);y+=7;
  P.text("Cliente:",M,y,{size:10,bold:true});P.text(pdfClean(S.cli)||"-",M+17,y,{size:10});
  P.text("Pagamento:",M+160,y,{size:10,bold:true});P.text(pdfClean(S.cond)||"-",M+160+23,y,{size:10});y+=6;
  if(S.sol){var sl=P.wrap(pdfClean(S.sol),W-2*M-46,10,false);P.text("Solicitação do cliente:",M,y,{size:10,bold:true});sl.forEach(function(l,i){P.text(l,M+46,y+i*4.5,{size:10})});y+=sl.length*4.5+1.5}
  P.text("Nº no Caprind:",M,y,{size:10,bold:true});P.text(S.prop?pdfClean(S.prop):"______________________",M+29,y,{size:10});y+=9;
  var cols=[{t:"#",w:7,a:"l"},{t:"Solicitação",w:36,a:"l"},{t:"Código",w:40,a:"l"},{t:"Descrição / desenho",w:70,a:"l"},{t:"Tipo",w:28,a:"l"},{t:"Prazo",w:22,a:"l"},{t:"Qtd",w:14,a:"r"},{t:"Unitário",w:26,a:"r"},{t:"Total",w:26,a:"r"}];
  function head(){
    P.rect(M,y-4.5,W-2*M,7,0.91);var x=M;
    cols.forEach(function(c){P.text(c.t,c.a==="r"?x+c.w-1.5:x+1.5,y,{size:8.5,bold:true,align:c.a==="r"?"right":"left"});x+=c.w});
    y+=6.5;
  }
  function footer(){P.text("Orçamento · "+E.nome+" · uso interno · página "+pg,W/2,H-7,{size:7.5,gray:0.45,align:"center"})}
  head();var tot=0,nn=0,dw=cols[3].w-3;
  S.items.forEach(function(it){
    if(!(it.desc||it.cod))return;
    var c=calc(it),ok=c.ok;if(ok)tot+=c.total;nn++;
    var dl=P.wrap(pdfClean(pdfDesc(it)||"Item sem descrição"),dw,9,false);
    var extra=[];
    var cl=P.wrap(pdfClean(it.cod)||"-",cols[2].w-3,9,false),ol=P.wrap(pdfClean(it.ordem)||"-",cols[1].w-3,9,false);
    var h=Math.max(dl.length*4+extra.length*3.4,cl.length*4,ol.length*4,P.wrap((/^\d+$/.test(String(it.prazo||"").trim())?String(it.prazo).trim()+" dias úteis":String(it.prazo||"-")),cols[5].w-3,9,false).length*4,4)+3;
    if(y+h>H-17){footer();P.add();pg++;y=18;head()}
    var x=M;
    P.text(String(nn),x+1.5,y,{size:9});x+=cols[0].w;
    ol.forEach(function(l,i){P.text(l,x+1.5,y+i*4,{size:9})});x+=cols[1].w;
    cl.forEach(function(l,i){P.text(l,x+1.5,y+i*4,{size:9})});x+=cols[2].w;
    dl.forEach(function(l,i){P.text(l,x+1.5,y+i*4,{size:9})});
    extra.forEach(function(l,i){P.text(l,x+1.5,y+dl.length*4+i*3.4,{size:7.5,gray:0.35})});
    x+=cols[3].w;
    var tp=it.tipo||"Venda",pz=String(it.prazo||"").trim();if(/^\d+$/.test(pz))pz+=" dias úteis";
    P.text(tp,x+1.5,y,{size:9});x+=cols[4].w;
    P.wrap(pz||"-",cols[5].w-3,9,false).forEach(function(l,i){P.text(l,x+1.5,y+i*4,{size:9})});x+=cols[5].w;
    P.text(String(c.q),x+cols[6].w-1.5,y,{size:9,align:"right"});x+=cols[6].w;
    P.text(ok?brl(c.preco):"sem preço",x+cols[7].w-1.5,y,{size:9,align:"right"});x+=cols[7].w;
    P.text(ok?brl(c.total):"-",x+cols[8].w-1.5,y,{size:9,align:"right"});
    y+=h-1;P.line(M,y-3,W-M,y-3,0.85);
  });
  if(y>H-40){footer();P.add();pg++;y=20}
  y+=3;P.text("Total: "+brl(tot),W-M,y,{size:11,bold:true,align:"right"});y+=10;
  P.text("Condições",M,y,{size:9,bold:true});y+=5;
  P.wrap("Pagamento "+pdfClean(S.cond||"28 DDL")+"; validade da proposta 5 dias; prazo de entrega conforme indicado em cada item (dias úteis); frete por nossa conta; certificado de material fornecido junto com a peça.",W-2*M,9,false).forEach(function(l){P.text(l,M,y,{size:9});y+=4.5});
  footer();
  var name="Rascunho_"+pdfClean(S.num||"sem-numero").replace(/[\/ ]/g,"-")+"_"+pdfClean(S.cli||"cliente").replace(/[^A-Za-z0-9]+/g,"_").slice(0,30)+".pdf";
  var blob=new Blob([P.build()],{type:"application/pdf"});
  if(window.__pdfHook){window.__pdfHook(blob,name);return}
  if(DLC&&DLC.save){DLC.save({filename:name,data:blob}).then(function(){toast("PDF salvo.")}).catch(function(){toast("Download cancelado.")})}
  else{var a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(function(){a.remove()},500)}
}
$("b-pdf").addEventListener("click",makePDF);
$("cfm-n").addEventListener("click",cfmClose);
$("cfm-y").addEventListener("click",function(){var f=CFM_YES;cfmClose();if(f)f()});
$("cfm").addEventListener("click",function(e){if(e.target.id==="cfm")cfmClose()});
document.addEventListener("keydown",function(e){if(!$("cfm").hidden){if(e.key==="Escape")cfmClose()}},true);
window.__makePDF=makePDF;window.__pdfDesc=pdfDesc;
fullRender();
})();
</script>

</body></html>